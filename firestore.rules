        && before.items.size() == after.items.size()
        && logisticsItemProtected(before.items, after.items, 0)
        && logisticsItemProtected(before.items, after.items, 1)
        && logisticsItemProtected(before.items, after.items, 2)
        && logisticsItemProtected(before.items, after.items, 3)
        && logisticsItemProtected(before.items, after.items, 4)
        && logisticsItemProtected(before.items, after.items, 5)
        && logisticsItemProtected(before.items, after.items, 6)
        && logisticsItemProtected(before.items, after.items, 7)
        && logisticsItemProtected(before.items, after.items, 8)
        && logisticsItemProtected(before.items, after.items, 9)
        && logisticsItemProtected(before.items, after.items, 10)
        && logisticsItemProtected(before.items, after.items, 11)
