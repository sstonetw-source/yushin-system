rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return signedIn() ? userDoc().data.role : null; }
    function admin() { return role() == 'admin'; }
    function purchaser() { return role() == 'purchaser'; }
    function warehouse() { return role() == 'warehouse'; }
    function sales() { return role() == 'sales'; }
    function engineer() { return role() == 'engineer'; }
    function currentSalesCode() { return signedIn() ? userDoc().data.code : null; }
    function ownBySalesCode(resourceData) {
      return signedIn()
        && currentSalesCode() != null
        && currentSalesCode() != ''
        && resourceData.salesCode != null
        && resourceData.salesCode == currentSalesCode();
    }
    // salesCode 是正式資料歸屬；ownerUid 僅保留給尚未補 salesCode 的舊資料相容。
    function own(resourceData) {
      return signedIn() && (ownBySalesCode(resourceData) || resourceData.ownerUid == request.auth.uid);
    }
    function salesInventoryOperationalUpdate() {
      return sales()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['onHand', 'reserved', 'lots', 'updatedAt'])
        && request.resource.data.onHand >= 0
        && request.resource.data.reserved >= 0;
    }
    function purchaserOrderOperationalUpdate() {
      return purchaser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'purchaseOrderNo', 'linkedDocuments', 'isOrdered', 'orderedBy', 'statusHistory',
          'inventoryReservedQty', 'inventoryShortageQty', 'inventoryProductKey',
          'warehouseId', 'updatedAt'
        ]);
    }
    function salesInventoryMovementCreate() {
      return sales()
        && request.resource.data.sourceType == 'order'
        && request.resource.data.type in [
          'reserve', 'release', 'ship', 'ship_reversal', 'return_in', 'return_reversal'
        ];
    }

    match /users/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /settings/{id} { allow read: if signedIn(); allow write: if admin(); }

    // 全系統共用主檔：先建立安全邊界，後續模組逐步改為引用 stable ID。
    match /brands/{id} {
      allow read: if signedIn();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /salesCodes/{id} {
      allow read: if signedIn();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /customers/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || sales();
      allow delete: if false;
    }

    match /suppliers/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || purchaser();
      allow delete: if false;
    }

    match /brandSupplierMappings/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || purchaser();
      allow delete: if false;
    }

    match /warehouses/{id} {
      allow read: if signedIn();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /products/{id} {
      allow read: if signedIn();
      // 業務只可快速建立 TEMPORARY 產品，不能直接修改正式 Product Master。
      allow create: if admin() || purchaser() || warehouse()
        || (sales()
          && request.resource.data.status == 'TEMPORARY'
          && request.resource.data.productId == id
          && request.resource.data.brandName is string
          && request.resource.data.manufacturerPartNo is string
          && request.resource.data.normalizedPartNo is string
          && request.resource.data.productName is string
          && (request.resource.data.authorizationType == 'AUTHORIZED'
            || request.resource.data.authorizationType == 'NON_AUTHORIZED'));
      allow update: if admin() || purchaser() || warehouse();
      allow delete: if false;
    }

    // 成本與產品主檔分離。代理產品成本不放在 products 文件內，
    // sales 只有在該成本文件明確 salesVisible=true 時才能讀取。
    match /productCosts/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (sales() && resource.data.salesVisible == true);
      // 採購/管理員可維護正式成本；業務只可在快速建立「非代理 TEMPORARY 產品」時
      // 新增一筆 salesVisible=true 的成本，不得更新既有成本。
      allow create: if admin() || purchaser()
        || (sales()
          && request.resource.data.productId == id
          && request.resource.data.salesVisible == true
          && get(/databases/$(database)/documents/products/$(id)).data.status == 'TEMPORARY'
          && get(/databases/$(database)/documents/products/$(id)).data.authorizationType == 'NON_AUTHORIZED');
      allow update: if admin() || purchaser();
      allow delete: if false;
    }

    match /quotes/{id} {
      allow read: if admin() || purchaser() || own(resource.data);
      allow create: if admin() || sales();
      allow update: if admin() || own(resource.data);
      allow delete: if false;
    }

    match /forecasts/{id} {
      allow read: if admin() || own(resource.data);
      allow create: if admin() || sales();
      allow update: if admin() || own(resource.data);
      allow delete: if false;
    }

    // Forecast 進度為 append-only 歷史，權限跟隨父 Forecast。
    match /forecasts/{forecastId}/progress/{progressId} {
      allow read: if admin() || own(get(/databases/$(database)/documents/forecasts/$(forecastId)).data);
      allow create: if admin()
        || (sales() && own(getAfter(/databases/$(database)/documents/forecasts/$(forecastId)).data));
      allow update, delete: if false;
    }

    match /orders/{id} {
      allow read: if admin() || purchaser() || warehouse() || own(resource.data);
      allow create: if admin() || sales();
      allow update: if admin() || own(resource.data) || purchaserOrderOperationalUpdate();
      allow delete: if false;
    }

    match /purchaseOrders/{id} {
      allow read: if admin() || purchaser() || warehouse();
      allow create, update: if admin() || purchaser();
      allow delete: if false;
    }

    match /inventory/{id} {
      allow read: if admin() || purchaser() || warehouse() || sales();
      // 正式庫存建檔／採購入庫由採購、倉管、管理員負責。
      allow create: if admin() || warehouse() || purchaser();
      // 業務在訂單成立／送貨流程只能改動實體數量、占用數量、批號與更新時間，
      // 不能自行改產品身份、在途量或其他主檔欄位。
      allow update: if admin() || warehouse() || purchaser() || salesInventoryOperationalUpdate();
      allow delete: if false;
    }

    // 分倉庫存：業務只能在訂單占用/送貨/退貨流程調整現有量與占用量。
    match /warehouseStocks/{id} {
      allow read: if admin() || purchaser() || warehouse() || sales();
      allow create: if admin() || warehouse() || purchaser();
      allow update: if admin() || warehouse() || purchaser()
        || (sales()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['onHand', 'reserved', 'updatedAt'])
          && request.resource.data.onHand >= 0
          && request.resource.data.reserved >= 0);
      allow delete: if false;
    }

    // 訂單成立後的庫存占用明細；以狀態更新取代刪除，保留可追溯性。
    match /inventoryReservations/{id} {
      allow read: if admin() || purchaser() || warehouse() || (sales() && ownBySalesCode(resource.data));
      allow create: if admin() || purchaser() || warehouse() || (sales() && ownBySalesCode(request.resource.data));
      allow update: if admin() || purchaser() || warehouse()
        || (sales() && ownBySalesCode(resource.data) && ownBySalesCode(request.resource.data));
      allow delete: if false;
    }

    // PO 已送出但尚未成為正式庫存主檔的新品項。
    match /pendingInventoryItems/{id} {
      allow read: if admin() || purchaser() || warehouse();
      allow create, update: if admin() || purchaser() || warehouse();
      allow delete: if false;
    }

    match /inventoryMovements/{id} {
      allow read: if admin() || warehouse() || purchaser() || sales();
      allow create: if admin() || warehouse() || purchaser() || salesInventoryMovementCreate();
      allow update, delete: if false;
    }

    match /equipment/{id} {
      allow read: if admin() || engineer() || (sales() && own(resource.data));
      allow create: if admin() || engineer() || (sales() && own(request.resource.data));
      allow update: if admin() || engineer()
        || (sales() && own(resource.data) && own(request.resource.data));
      allow delete: if false;
    }

    // 未明確列出的集合一律拒絕，避免 catch-all 讓前面的角色/歸屬規則失效。
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
