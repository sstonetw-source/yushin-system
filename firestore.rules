    // Commercial metadata also locks on per-line shipment/delivery history.
    function movementFreeGroup(a, b, c, d, e) {
      // Keep quantity and event types separate while avoiding a repeated zero tuple.
      return [a.get('receivedQty', 0), a.get('warehouseShippedQty', 0), a.get('deliveredQty', 0), b.get('receivedQty', 0), b.get('warehouseShippedQty', 0), b.get('deliveredQty', 0), c.get('receivedQty', 0), c.get('warehouseShippedQty', 0), c.get('deliveredQty', 0), d.get('receivedQty', 0), d.get('warehouseShippedQty', 0), d.get('deliveredQty', 0), e.get('receivedQty', 0), e.get('warehouseShippedQty', 0), e.get('deliveredQty', 0)].hasOnly([0])
        && [a.get('receiptEvents', []), b.get('receiptEvents', []), c.get('receiptEvents', []), d.get('receiptEvents', []), e.get('receiptEvents', [])].hasOnly([[]]);
