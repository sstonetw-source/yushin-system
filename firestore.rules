rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUser() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function active() {
      return hasUser()
        && (!('active' in userDoc().data) || userDoc().data.active == true);
    }

    function role() {
      return active() ? userDoc().data.role : null;
    }

    function admin() { return role() == 'admin'; }
    function sales() { return role() == 'sales'; }
    function engineer() { return role() == 'engineer'; }
    function purchaser() { return role() == 'purchaser'; }
    function warehouse() { return role() == 'warehouse'; }

    // Sales and engineers own their own commercial and fulfillment records.
    function businessOwner() {
      return sales() || engineer();
    }

    function commercialDocumentOwner() {
      return sales() || engineer();
    }

    function businessAssistant() {
      return purchaser();
    }

    function canCreateCommercialDoc() {
      return admin() || commercialDocumentOwner() || businessAssistant();
    }

    function canPurchase() {
      return admin() || purchaser();
    }

    function canReceiveInventory() {
      return admin() || purchaser() || warehouse();
    }

    function warehousePurchaseReceiptUpdate() {
      return warehouse()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receiptRecords', 'receiptStatus', 'status', 'updatedAt'
        ]);
    }

    function canManageEquipment() {
      return admin() || engineer();
    }

    function salesCode() {
      return active() && userDoc().data.salesCode != null
        ? userDoc().data.salesCode
        : (active() && userDoc().data.code != null ? userDoc().data.code : null);
    }

    function owns(data) {
      return active() && (
        (data.ownerUid != null && data.ownerUid == request.auth.uid) ||
        (salesCode() != null && data.salesCode != null && data.salesCode == salesCode())
      );
    }

    function validSalesOwner(data) {
      return data.ownerUid != null
        && data.salesCode != null
        && exists(/databases/$(database)/documents/users/$(data.ownerUid))
        && get(/databases/$(database)/documents/users/$(data.ownerUid)).data.role == 'sales'
        && get(/databases/$(database)/documents/users/$(data.ownerUid)).data.get(
          'salesCode',
          get(/databases/$(database)/documents/users/$(data.ownerUid)).data.get('code', null)
        ) == data.salesCode;
    }

    function validOwnedCommercialCreate(data) {
      return admin() ||
        (commercialDocumentOwner() &&
          data.ownerUid == request.auth.uid &&
          data.salesCode != null &&
          data.salesCode == salesCode()) ||
        (businessAssistant() &&
          validSalesOwner(data) &&
          data.ownerUid != request.auth.uid);
    }

    function sameCommercialOwner() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.salesCode == resource.data.salesCode;
    }

    // Creator identity is an audit field. Legacy documents without creator metadata
    // remain editable; once present, normal workflow edits cannot rewrite it.
    function preservesCreator() {
      return resource.data.get('createdByUid', '') == ''
        ? (
          request.resource.data.get('createdByUid', '') == ''
          && request.resource.data.get('createdByName', '') == ''
          && request.resource.data.get('createdByRole', '') == ''
        )
        : (
          request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
          && request.resource.data.get('createdByName', '') == resource.data.get('createdByName', '')
          && request.resource.data.get('createdByRole', '') == resource.data.get('createdByRole', '')
        );
    }

    function purchaserOrderWorkflowUpdate() {
      return purchaser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'itemCount', 'orderSchemaVersion',
          'purchaseOrderNo', 'purchaseOrderNos', 'purchaseOrderedQty', 'purchaseStatus',
          'linkedDocuments', 'updatedAt'
        ])
        && sameCommercialOwner();
    }

    function warehouseOrderWorkflowUpdate() {
      return warehouse()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'itemCount', 'orderSchemaVersion',
          'inventoryReservedQty', 'inventoryShortageQty',
          'receivedQty', 'updatedAt'
        ])
        && sameCommercialOwner();
    }

    function productLineKey(data) {
      return data.get('productLineId', data.get('productLine', ''));
    }

    function assignedProductLine(data) {
      return admin() ||
        (sales()
          && userDoc().data.productLineIds is list
          && productLineKey(data) != ''
          && userDoc().data.productLineIds.hasAny([productLineKey(data)]));
    }

    function nonNegativeInventory(data) {
      return data.onHand >= 0 && data.reserved >= 0;
    }

    // Client-side delivery/reservation transactions need narrowly-scoped stock writes.
    // Business owners cannot alter product identity, cost, incoming quantities or master data.
    function businessInventoryOperationalUpdate() {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'onHand', 'reserved', 'lots', 'safetyStock', 'updatedAt'
        ])
        && nonNegativeInventory(request.resource.data);
    }

    function businessInventoryLotOperationalUpdate() {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'remainingQty', 'updatedAt'
        ])
        && request.resource.data.remainingQty >= 0;
    }

    function businessWarehouseStockOperationalUpdate() {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'onHand', 'reserved', 'updatedAt'
        ])
        && nonNegativeInventory(request.resource.data);
    }

    match /users/{id} {
      allow read: if signedIn() && (id == request.auth.uid || active());
      allow create, update: if admin();
      allow delete: if false;
    }

    match /settings/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /brands/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /productLines/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /salesCodes/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /customers/{id} {
      allow read: if active();
      allow create, update: if admin() || businessOwner() || businessAssistant();
      allow delete: if false;
    }

    match /suppliers/{id} {
      allow read: if active();
      allow create, update: if canPurchase();
      allow delete: if false;
    }

    match /brandSupplierMappings/{id} {
      allow read: if active();
      allow create, update: if canPurchase();
      allow delete: if false;
    }

    match /warehouses/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    // Searchable product master. Cost is intentionally stored separately.
    match /products/{id} {
      allow read: if active();
      allow create, update: if admin() || purchaser() || assignedProductLine(request.resource.data);
      allow delete: if false;
    }

    // Protected cost data. Assigned business owners can maintain only their product lines.
    match /productCosts/{id} {
      allow read: if admin() || purchaser() || assignedProductLine(resource.data);
      allow create: if admin() || purchaser() || assignedProductLine(request.resource.data);
      allow update: if admin() || purchaser()
        || (assignedProductLine(resource.data)
          && assignedProductLine(request.resource.data)
          && request.resource.data.productId == resource.data.productId
          && productLineKey(request.resource.data) == productLineKey(resource.data));
      allow delete: if false;
    }

    match /priceHistory/{id} {
      allow read: if admin() || purchaser() || assignedProductLine(resource.data);
      allow create: if admin() || purchaser() || assignedProductLine(request.resource.data);
      allow update, delete: if false;
    }

    match /quotes/{id} {
      allow read: if admin() || purchaser() || owns(resource.data);
      allow create: if canCreateCommercialDoc() && validOwnedCommercialCreate(request.resource.data);
      allow update: if admin()
        || (commercialDocumentOwner() && owns(resource.data) && owns(request.resource.data) && sameCommercialOwner() && preservesCreator())
        || (purchaser() && sameCommercialOwner() && preservesCreator());
      allow delete: if false;
    }

    match /forecasts/{id} {
      allow read: if admin() || owns(resource.data);
      allow create: if (admin() || commercialDocumentOwner()) && validOwnedCommercialCreate(request.resource.data);
      allow update: if admin()
        || (commercialDocumentOwner() && owns(resource.data) && owns(request.resource.data) && sameCommercialOwner() && preservesCreator());
      allow delete: if false;
    }

    match /forecasts/{forecastId}/progress/{progressId} {
      function parentForecast() {
        return get(/databases/$(database)/documents/forecasts/$(forecastId));
      }
      allow read: if admin() || owns(parentForecast().data);
      allow create: if admin() || (commercialDocumentOwner() && owns(parentForecast().data));
      allow update, delete: if false;
    }

    match /orders/{id} {
      allow read: if admin() || purchaser() || warehouse() || owns(resource.data);
      allow create: if canCreateCommercialDoc() && validOwnedCommercialCreate(request.resource.data);
      // Commercial owner edits commercial data; purchaser/warehouse must use scoped
      // workflow collections below instead of broad order mutation.
      allow update: if admin()
        || (commercialDocumentOwner() && owns(resource.data) && owns(request.resource.data) && sameCommercialOwner() && preservesCreator())
        || purchaserOrderWorkflowUpdate()
        || warehouseOrderWorkflowUpdate();
      allow delete: if false;
    }

    // Formal supplier PO. Sales/engineer self-order does NOT grant purchase-order privilege.
    match /purchaseOrders/{id} {
      allow read: if admin() || purchaser() || warehouse();
      allow create: if canPurchase();
      allow update: if canPurchase() || warehousePurchaseReceiptUpdate();
      allow delete: if false;
    }

    // Unified source/order evidence: PURCHASING_PO, SALES_SELF_ORDER, STOCK_REPLENISHMENT.
    match /supplyOrders/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner()
          && resource.data.type == 'SALES_SELF_ORDER'
          && resource.data.ownerUid == request.auth.uid);
      allow create: if admin() || purchaser()
        || (sales()
          && request.resource.data.type == 'SALES_SELF_ORDER'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.salesCode == salesCode());
      allow update: if admin() || purchaser()
        || (warehouse()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'receivedQty', 'status', 'updatedAt'
          ]))
        || (sales()
          && resource.data.type == 'SALES_SELF_ORDER'
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.type == resource.data.type);
      allow delete: if false;
    }

    match /inventory/{id} {
      // Aggregate operational stock is shared, but cost fields must never be embedded here.
      allow read: if admin() || (active() && !('unitCost' in resource.data) && !('cost' in resource.data));
      allow create: if canReceiveInventory() && nonNegativeInventory(request.resource.data)
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow update: if ((canReceiveInventory() && nonNegativeInventory(request.resource.data))
          || businessInventoryOperationalUpdate())
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow delete: if false;
    }

    match /warehouseStocks/{id} {
      allow read: if admin() || (active() && !('unitCost' in resource.data) && !('cost' in resource.data));
      allow create: if canReceiveInventory() && nonNegativeInventory(request.resource.data)
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow update: if ((canReceiveInventory() && nonNegativeInventory(request.resource.data))
          || businessWarehouseStockOperationalUpdate())
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow delete: if false;
    }

    match /inventoryReservations/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create, update: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(request.resource.data));
      allow delete: if false;
    }

    match /inventoryLots/{id} {
      // Operational lot data is readable for fulfillment, but cost must never live here.
      allow read: if admin() || (active() && !('unitCost' in resource.data));
      allow create: if canReceiveInventory() && !('unitCost' in request.resource.data);
      allow update: if (canReceiveInventory() || businessInventoryLotOperationalUpdate())
        && !('unitCost' in request.resource.data);
      allow delete: if false;
    }

    // Actual receipt/lot cost is physically separated from operational lot data.
    // Client-side fulfillment never requires this collection.
    match /inventoryLotCosts/{id} {
      allow read: if admin() || purchaser();
      allow create: if canReceiveInventory();
      allow update: if admin() || purchaser();
      allow delete: if false;
    }

    match /receipts/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if canReceiveInventory()
        && !('unitCost' in request.resource.data)
        && !('purchaseNetAmount' in request.resource.data);
      allow update, delete: if false;
    }

    // Purchaser records completion of the company's existing shipping paperwork.
    match /dispatchRecords/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if admin() || purchaser();
      allow update, delete: if false;
    }

    // Physical delivery is recorded by the responsible business owner.
    match /deliveries/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if admin()
        || (businessOwner() && owns(request.resource.data));
      allow update, delete: if false;
    }

    match /pendingInventoryItems/{id} {
      allow read: if admin() || purchaser() || warehouse();
      allow create, update: if admin() || purchaser() || warehouse();
      allow delete: if false;
    }

    // Immutable stock ledger.
    match /inventoryMovements/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if (admin() || purchaser() || warehouse()
        || (businessOwner() && owns(request.resource.data)))
        && !('unitCost' in request.resource.data)
        && !('purchaseNetAmount' in request.resource.data)
        && !('cogs' in request.resource.data);
      allow update, delete: if false;
    }

    // Immutable operational audit trail.
    match /auditLogs/{id} {
      allow read: if admin() || (active() && resource.data.actorUid == request.auth.uid);
      allow create: if active() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /equipment/{id} {
      allow read: if admin() || engineer() || (businessOwner() && owns(resource.data));
      allow create: if admin() || engineer()
        || (sales() && owns(request.resource.data));
      allow update: if admin() || engineer()
        || (sales() && owns(resource.data) && owns(request.resource.data));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
