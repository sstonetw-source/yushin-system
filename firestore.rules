        && (!changed.hasAny(['sourceDocumentSyncStatus','sourceDocumentSyncError','sourceDocumentSyncUpdatedAt']) || validOrderSourceSyncTransition(id, userRole))
        && (userRole == 'admin' ? (changed.hasAny(['items','productId','productType','serviceKind']) ? validClientServiceBillingBinding() : true)
        : userRole in ['sales','engineer'] && changed.hasAny(['isBilled','billingDate'])
