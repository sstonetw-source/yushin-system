    function validInventoryShipmentItem(before, after, record) {
      let index = record.get('itemIndex', -1);
      let oldItem = before.items[index];
      let newItem = after.items[index];
      let reservationPath = /databases/$(database)/documents/inventoryReservations/$(record.orderId + '__' + record.itemId);
      let oldReservation = get(reservationPath).data;
      let newReservation = getAfter(reservationPath).data;
      return index is int && index >= 0 && index < before.items.size()
        && before.items.size() == after.items.size()
        && before.items.removeAll([oldItem]) == after.items.removeAll([newItem])
        && newItem.diff(oldItem).affectedKeys().hasOnly(['reservedQty', 'warehouseShippedQty'])
        && oldItem.get('itemId', '') == record.itemId
        && oldItem.get('fulfillmentType', 'WAREHOUSE') != 'DIRECT_SHIP'
        && oldItem.get('warehouseId', before.get('warehouseId', '')) == record.warehouseId
        && oldReservation.get('orderId', '') == record.orderId
        && oldReservation.get('itemId', '') == record.itemId
        && oldReservation.get('productKey', '') == record.productKey
        && newReservation.get('productKey', '') == record.productKey
        && newReservation.get('warehouseId', '') == record.warehouseId
        && oldReservation.get('warehouseId', '') == record.warehouseId
        && oldReservation.get('quantity', 0) >= record.qty
        && newReservation.get('quantity', -1) == oldReservation.quantity - record.qty
        && newItem.get('reservedQty', -1) == newReservation.quantity
        && newItem.get('warehouseShippedQty', 0) >= oldItem.get('warehouseShippedQty', 0) + record.qty
        && newItem.warehouseShippedQty <= oldItem.get('dispatchPreparedQty', 0);
