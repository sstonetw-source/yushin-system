      let newItem = after.items[index];
      return canReceiveInventory() && sameCommercialOwner() && preservesCreator()
        && transfer.orderId == orderId && transfer.itemId == oldItem.itemId
        && index is int && index >= 0 && index < before.items.size()
        && before.items.size() == after.items.size()
        && before.items.removeAll([oldItem]) == after.items.removeAll([newItem])
        && newItem.diff(oldItem).affectedKeys().hasOnly(['warehouseId','custodyTransferId','transferPendingId'])
        && !orderIsCancelled(before)
        && after.get('deliveryRecords', []) == before.get('deliveryRecords', [])
        && after.get('returnRecords', []) == before.get('returnRecords', [])
        && after.diff(before).affectedKeys().hasOnly(['items','warehouseLogisticsId','warehouseLogisticsEventId','logisticsTransfersPending',
