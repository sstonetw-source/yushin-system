    function orderWithoutGlobalReceipt(order) {
      return !order.get('isArrived', false) && !order.get('isDelivered', false) && !order.get('isBilled', false)
        && order.get('receivedQty', 0) == 0 && order.get('deliveredQty', 0) == 0
        && order.get('receiptEvents', []) == [] && order.get('deliveryRecords', []) == [];
