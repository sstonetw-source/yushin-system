              && (deliveryLedgerOnly || resource.data.get('warehouseLogisticsId', '') == '' || commercialKeepsPendingTransfer())))))));
    }

    function businessDeliveryRecordChange(before, after, index) {
      return index is int && index >= 0
        && ((after.size() == before.size() + 1 && index < after.size()
            && after[index].qty is number && after[index].qty > 0
            && after.removeAll([after[index]]) == before
            && request.resource.data.deliveredQty == resource.data.get('deliveredQty', 0) + after[index].qty)
          || (after.size() == before.size() && index < after.size()
            && after[index].id == before[index].id && after[index].itemId == before[index].itemId
            && after[index].qty is number && after[index].qty > 0
            && after.removeAll([after[index]]) == before.removeAll([before[index]])
            && request.resource.data.deliveredQty == resource.data.get('deliveredQty', 0) + after[index].qty - before[index].qty)
          || (after.size() + 1 == before.size() && index < before.size()
            && after == before.removeAll([before[index]])
            && request.resource.data.deliveredQty == resource.data.get('deliveredQty', 0) - before[index].qty));
    }
    function businessPhysicalDelivery(id, e) {
      let path = /databases/$(database)/documents/stockOperations/$(e.get('operationId', 'unused'));
      let op = getAfter(path).data;
      let invPath = /databases/$(database)/documents/inventory/$(e.get('inventoryId', 'unused'));
      return e.get('operationId', '') != '' && !exists(path)
        && op.actorUid == request.auth.uid && op.orderId == id
        && op.targetPath == 'inventory/' + e.inventoryId
        && getAfter(invPath).data.stockOperationId == e.operationId
        && getAfter(invPath).data.onHand - get(invPath).data.onHand == op.qtyDelta
        && op.qtyDelta == resource.data.get('deliveredQty', 0) - request.resource.data.get('deliveredQty', 0);
    }
    function businessOrderFactsProtected(id, changed) {
      let before = resource.data;
      let after = request.resource.data;
      let prior = before.get('deliveryRecords', []);
      let next = after.get('deliveryRecords', []);
      let e = after.get('businessDeliveryEvidence', {});
      return !changed.hasAny(['qty','isOrdered','isArrived','receivedQty','deliveryRecords','deliveredQty','isDelivered'])
        || before.get('qty', 0) == after.get('qty', 0)
        && before.get('isOrdered', false) == after.get('isOrdered', false)
        && before.get('isArrived', false) == after.get('isArrived', false)
        && before.get('receivedQty', 0) == after.get('receivedQty', 0)
        && ((prior == next && before.get('deliveredQty', 0) == after.get('deliveredQty', 0)
            && before.get('isDelivered', false) == after.get('isDelivered', false))
          || (next is list && after.get('deliveredQty', 0) is number && after.deliveredQty >= 0
            && (!after.get('isDelivered', false) || next.size() > 0)
            && (businessDeliveryRecordChange(prior, next, e.get('recordIndex', -1))
              || (before.get('items', []).size() == 1 && next.size() == 0 && after.deliveredQty == 0))
            && (before.get('deliveredQty', 0) == after.deliveredQty
              ? before.get('isDelivered', false) == after.get('isDelivered', false)
              : businessPhysicalDelivery(id, e))));
    }

    function validOrderInventorySyncTransition(userRole) {
      let before = resource.data;
      let after = request.resource.data;
      let attempt = after.get('inventoryReservationAttemptId', '');
      let error = after.get('inventoryReservationError', '');
      let updatedAt = after.get('inventoryReservationUpdatedAt', '');
      return (userRole in ['admin','purchaser','sales','engineer']
          && !orderIsCancelled(before) && !orderIsCancelled(after)
          && before.get('inventoryReservationStatus', '') != 'completed'
          && attempt is string && attempt.size() > 0 && attempt.size() <= 128
          && error is string && error.size() <= 1000
          && updatedAt is string && updatedAt.size() <= 64
          && (after.get('inventoryReservationStatus', '') == 'pending'
            ? after.inventoryReservationAttemptId != before.get('inventoryReservationAttemptId', '') && after.inventoryReservationError == ''
            : before.get('inventoryReservationStatus', '') == 'pending'
              && after.inventoryReservationAttemptId == before.get('inventoryReservationAttemptId', '')
              && after.get('inventoryReservationStatus', '') == 'failed'));
    }

    function validOrderSourceSyncTransition(id, userRole) {
      let before = resource.data;
      let after = request.resource.data;
      return (userRole in ['admin','purchaser','sales','engineer']
          && (userRole in ['admin','purchaser'] || before.get('ownerUid', '') == request.auth.uid)
          && !orderIsCancelled(before) && !orderIsCancelled(after)
          && before.get('inventoryReservationStatus', '') == 'completed'
          && before.get('sourceDocumentSyncStatus', '') != 'completed'
          && after.get('sourceType', '') == before.get('sourceType', '') && after.get('sourceId', '') == before.get('sourceId', '')
          && after.get('sourceType', '') in ['quote','forecast'] && after.get('sourceId', '') != ''
          && after.diff(before).affectedKeys().hasOnly(['sourceDocumentSyncStatus','sourceDocumentSyncError','sourceDocumentSyncUpdatedAt','updatedAt'])
          && after.get('sourceDocumentSyncError', '') is string && after.get('sourceDocumentSyncError', '').size() <= 1000
          && after.get('sourceDocumentSyncUpdatedAt', '') is string && after.get('sourceDocumentSyncUpdatedAt', '').size() <= 64
          && (after.get('sourceDocumentSyncStatus', '') == 'failed'
            || (after.get('sourceDocumentSyncStatus', '') == 'completed' && after.get('sourceDocumentSyncError', '') == '' && sourceSyncEvidence(id))));
    }
    function sourceSyncEvidence(id) {
      return sourceSyncEvidenceForData(id, resource.data);
    }
    function sourceSyncEvidenceForData(id, order) {
      let collection = order.sourceType == 'quote' ? 'quotes' : 'forecasts';
      let source = getAfter(/databases/$(database)/documents/$(collection)/$(order.sourceId)).data;
      return !orderIsCancelled(source)
        && source.get('linkedDocuments', []).hasAny([{'type':'order','id':id,'relation':'created'}])
        && (order.sourceType != 'quote' || source.get('dealClosed', false) == true && source.get('status', '') == 'completed');
    }
    function validNewOrderSourceSync(id) {
      let data = request.resource.data;
      return !('sourceDocumentSyncStatus' in data)
        || (data.get('sourceType', '') in ['quote','forecast'] && data.get('sourceId', '') != ''
          && data.get('sourceDocumentSyncError', '') == ''
          && data.get('sourceDocumentSyncUpdatedAt', '') is string && data.get('sourceDocumentSyncUpdatedAt', '').size() <= 64
          && (data.sourceDocumentSyncStatus == 'pending'
            || data.sourceDocumentSyncStatus == 'completed' && sourceSyncEvidenceForData(id, data)));
    }

    // Service snapshot identity cannot be stripped to bypass server-only billing.
    // orders: isBilled bool (optional legacy false), billingDate YYYY-MM-DD/empty;
    // items <=30 maps, productType string; bound Service identity stays immutable.
    function isServiceBillingItem(item) {
      return item.get('productType', '').matches('(?i)\\s*service\\s*');
    }
    function clientGoodsBillingData(data) {
      let items = data.get('items', []);
      return !isServiceBillingItem(data) && items is list && items.size() <= 15
        && (items.size() <= 0 || !items[0].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 1 || !items[1].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 2 || !items[2].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 3 || !items[3].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 4 || !items[4].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 5 || !items[5].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 6 || !items[6].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 7 || !items[7].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 8 || !items[8].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 9 || !items[9].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 10 || !items[10].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 11 || !items[11].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 12 || !items[12].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 13 || !items[13].get('productType', '').matches('(?i)\\s*service\\s*'))
        && (items.size() <= 14 || !items[14].get('productType', '').matches('(?i)\\s*service\\s*'));
    }
    function validClientBillingCreate(data) {
      return data.get('isBilled', false) == false && data.get('billingDate', '') == '';
    }
    function validClientBillingUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return clientGoodsBillingData(before)
        && (before.get('items', []) == after.get('items', [])
          ? !isServiceBillingItem(after) : clientGoodsBillingData(after));
    }
    function serviceBillingBindingAt(before, after, index) {
      let old = index < before.size() ? before[index] : {};
      let next = index < after.size() ? after[index] : {};
      return !next.diff(old).affectedKeys().hasAny(['itemId','productId','productType','serviceKind'])
        || !(isServiceBillingItem(old) || isServiceBillingItem(next));
    }
    function validClientServiceBillingBinding() {
      let before = resource.data.get('items', []);
      let after = request.resource.data.get('items', []);
      return (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['productId','productType','serviceKind'])
          || !isServiceBillingItem(resource.data) && !isServiceBillingItem(request.resource.data))
        && (before == after || (before is list && after is list && before.size() <= 15 && after.size() <= 15
          && (before.size() <= 0 && after.size() <= 0 || serviceBillingBindingAt(before, after, 0))
          && (before.size() <= 1 && after.size() <= 1 || serviceBillingBindingAt(before, after, 1))
          && (before.size() <= 2 && after.size() <= 2 || serviceBillingBindingAt(before, after, 2))
          && (before.size() <= 3 && after.size() <= 3 || serviceBillingBindingAt(before, after, 3))
          && (before.size() <= 4 && after.size() <= 4 || serviceBillingBindingAt(before, after, 4))
          && (before.size() <= 5 && after.size() <= 5 || serviceBillingBindingAt(before, after, 5))
          && (before.size() <= 6 && after.size() <= 6 || serviceBillingBindingAt(before, after, 6))
          && (before.size() <= 7 && after.size() <= 7 || serviceBillingBindingAt(before, after, 7))
          && (before.size() <= 8 && after.size() <= 8 || serviceBillingBindingAt(before, after, 8))
          && (before.size() <= 9 && after.size() <= 9 || serviceBillingBindingAt(before, after, 9))
          && (before.size() <= 10 && after.size() <= 10 || serviceBillingBindingAt(before, after, 10))
          && (before.size() <= 11 && after.size() <= 11 || serviceBillingBindingAt(before, after, 11))
          && (before.size() <= 12 && after.size() <= 12 || serviceBillingBindingAt(before, after, 12))
          && (before.size() <= 13 && after.size() <= 13 || serviceBillingBindingAt(before, after, 13))
          && (before.size() <= 14 && after.size() <= 14 || serviceBillingBindingAt(before, after, 14))));
    }

    // New orders require an explicit commercial transaction choice. Legacy
    // orders may retain an absent/blank choice until edited, never clear a valid one.
    function validOrderTransactionType(data) {
      return data.get('transactionType', '') in ['直', '借', '扣'];
    }
    match /orders/{id} {
      allow get: if (resource == null ? role() in ['admin','purchaser','warehouse','sales','engineer'] : operationalOrOwnedReader(resource.data));
      allow list: if operationalOrOwnedReader(resource.data);
      allow create: if canCreateCommercialDoc()
        // Client SDK must not forge the terminal server-only checkpoint.
        && request.resource.data.get('inventoryReservationStatus', '') != 'completed'
        && request.resource.data.get('items', []).size() <= 15
        && validOrderTransactionType(request.resource.data)
        && validClientBillingCreate(request.resource.data)
        && validNewOrderSourceSync(id)
        && validOwnedCommercialCreate(request.resource.data)
        && validNewOrderProductMaster(request.resource.data)
        && validOrderEmbeddedCost(request.resource.data);
      // Commercial owner edits commercial data; purchaser/warehouse must use scoped
      // workflow collections below instead of broad order mutation.
      // Transaction type validation is inside the scoped update paths, evaluated once.
      allow update: if (!(resource.data.get('inventoryReservationStatus', '') in ['pending','failed'])
          || request.resource.data.get('items', []) == resource.data.get('items', []))
        && (resource.data.get('inventoryReservationStatus', '') == 'completed'
          || request.resource.data.get('inventoryReservationStatus', '') != 'completed')
        && orderUpdateAllowed(id);
      allow delete: if admin();
    }

    // Formal supplier PO. Sales/engineer self-order does NOT grant purchase-order privilege.
    match /purchaseOrders/{id} {
      allow read: if admin() || purchaser();
      allow create: if canPurchase();
      // The PO is an immutable document snapshot for warehouse users. Receiving
      // progress belongs to supplyOrders and receipts, never back on the PO.
      allow update: if canPurchase();
      allow delete: if admin();
    }

    // ERP-style communication timeline. Browser share/mailto can prove only that
    // the handoff was prepared, not that an email was actually delivered.
    match /purchaseOrderCommunications/{id} {
      allow read: if admin() || purchaser();
      allow write: if false;
    }

    // ERP Material Request-like purchasing demand. Demand identity is stable and
    // supplier orders / receipts link back through demandId.
    match /procurementDemands/{id} {
      // Transactions read the deterministic ID before creating a demand. Missing data carries no customer information.
      allow get: if (resource == null ? role() in ['admin','purchaser','warehouse','sales','engineer'] : operationalOrOwnedReader(resource.data));
      allow list: if operationalOrOwnedReader(resource.data);
      allow create: if validProcurementDemand(request.resource.data)
        && clientDemandSourceReady(request.resource.data) && (canReceiveInventory()
        || businessProcurementDemandCreate(request.resource.data));
      allow update: if validProcurementDemand(request.resource.data) && demandIdentityUnchanged()
        && (((resource.data.get('fulfillmentType', '') == 'DIRECT_SHIP'
            && request.resource.data.get('receivedQty', 0) > resource.data.get('receivedQty', 0))
            ? (admin() || businessDirectDemandReceiptUpdate())
            : (canReceiveInventory() || businessProcurementDemandOperationalUpdate()))
          || (request.resource.data.get('status', '') == 'CANCELLED' && businessLifecycleDemandCancelUpdate())
          || (resource.data.get('status', '') == 'CANCELLED' && businessLifecycleDemandRestoreUpdate()));
      allow delete: if admin();
    }

    // New self-orders must carry their supplier and actual unit cost.
    // This is independent of the quick-purchase rules and does not rewrite old documents.
    function validSelfOrderSupplyCreate() {
      let data = request.resource.data;
      return data.get('type', '') != 'SALES_SELF_ORDER'
        || (data.get('supplier', '') is string
          && data.get('supplier', '').matches('.*\\S.*')
          && data.get('unitCost', null) is number
          && data.get('unitCost', null) >= 0);
    }

    function validQuickPurchaseCost() {
      let data = request.resource.data;
      return data.get('type', '') != 'PURCHASING_MANUAL'
        || (data.get('supplier', '') is string && data.get('supplier', '').size() > 0
          && data.get('unitCost', null) is number && data.get('unitCost', null) >= 0);
    }

    function validQuickPurchaseUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return after.get('type', '') != 'PURCHASING_MANUAL'
        || (after.get('qty', 0) <= before.get('qty', 0)
          && !after.diff(before).affectedKeys().hasAny(['supplier', 'unitCost']))
        || (validQuickPurchaseCost()
          && (after.get('qty', 0) <= before.get('qty', 0)
            || (after.get('supplier', '') == before.get('supplier', '')
              && after.get('unitCost', 0) == before.get('unitCost', 0))));
    }

    function purchaserSupplySourceReady() {
      let data = request.resource.data;
      let orderId = data.get('orderId', '');
      return !(data.get('type', '') in ['PURCHASING_PO','PURCHASING_MANUAL']) || orderId == ''
        || (exists(/databases/$(database)/documents/orders/$(orderId))
          && !orderIsCancelled(get(/databases/$(database)/documents/orders/$(orderId)).data)
          && !(get(/databases/$(database)/documents/orders/$(orderId)).data.get('inventoryReservationStatus', '') in ['pending','failed']));
    }

    // Resolve the trusted, enabled profile once. Dispatch before evaluating
    // unrelated receipt/cancellation branches in the incoming stock transaction.
    // Every branch retains its existing identity, quantity and evidence checks.
    function supplyOperationalUpdateAllowed(id) {
      let userRole = role();
      return (userRole == 'admin'
        || (userRole == 'purchaser' && (purchaserSupplyOperationalUpdate(userRole)
          || supplierCancellationResolution(userRole)))
        || (userRole == 'warehouse' && warehouseSupplyOperationalUpdate(userRole))
        || (userRole in ['sales','engineer'] && directShipSupplyReceiptUpdate(id, userRole)))
        && supplierReceiptDispositionAllowed() && validQuickPurchaseUpdate();
    }

    // Unified source/order evidence: PURCHASING_PO, PURCHASING_MANUAL, SALES_SELF_ORDER, STOCK_REPLENISHMENT.
    match /supplyOrders/{id} {
      allow read: if admin() || purchaser()
        || (businessOwner()
          && resource.data.type == 'SALES_SELF_ORDER'
          && resource.data.ownerUid == request.auth.uid);
      allow create: if purchaserSupplySourceReady() && (((admin() || purchaser()) && validQuickPurchaseCost())
        && validSelfOrderSupplyCreate()
        || (businessOwner()
          && request.resource.data.type == 'SALES_SELF_ORDER'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.salesCode == salesCode()
          && validSelfOrderSupplyCreate()));
      // Sales owns the commercial intent and may create/read its own self-order,
      // but supply execution becomes operational evidence after creation. Only purchasing
      // or receiving roles may mutate quantities/status; this prevents direct API edits
      // from bypassing procurement and receipt workflows.
      allow update: if supplyOperationalUpdateAllowed(id);
      allow delete: if admin();
    }

    // The authoritative supply record retains cost. This derived receiving view
    // must exactly match it, except that financial fields are absent.
    function businessReceivingView(data) {
      return businessOwner() && data.get('ownerUid', '') == request.auth.uid
        && (data.get('fulfillmentType', '') == 'DIRECT_SHIP' || data.get('type', '') == 'SALES_SELF_ORDER');
    }
    function receivingViewWriter(data) {
      let userRole = role();
      return userRole in ['admin', 'purchaser', 'warehouse']
        || (userRole in ['sales', 'engineer'] && data.get('ownerUid', '') == request.auth.uid
          && (data.get('fulfillmentType', '') == 'DIRECT_SHIP' || data.get('type', '') == 'SALES_SELF_ORDER'));
    }
    match /receivingSupplyOrders/{id} {
      allow get: if admin() || purchaser() || warehouse()
        || (businessOwner() && (resource == null || businessReceivingView(resource.data)));
      allow list: if admin() || purchaser() || warehouse() || businessReceivingView(resource.data);
      allow create, update: if receivingViewWriter(request.resource.data)
        && !request.resource.data.keys().hasAny(['unitCost', 'cost', 'costPrice'])
        && request.resource.data.diff(getAfter(/databases/$(database)/documents/supplyOrders/$(id)).data)
          .affectedKeys().hasOnly(['unitCost', 'cost', 'costPrice']);
      allow delete: if admin();
    }


    // Main replenishment request: immutable source/quantity; reserve first, ship later.
    // stockTransferRequests contains only operational item identity and actor UID, never costs.
    function validMainTransferRequest(d) {
      return d.keys().hasOnly(['id','inventoryId','productKey','productId','itemCode','itemName','brand',
          'fromWarehouseId','toWarehouseId','fromStockId','qty','status','createdByUid','createdAt',
          'transferId','shippedAt','shippedByUid','cancelledAt','cancelledByUid'])
        && d.keys().hasAll(['id','inventoryId','productKey','productId','itemCode','itemName','brand',
          'fromWarehouseId','toWarehouseId','fromStockId','qty','status','createdByUid','createdAt'])
        && d.id is string && d.id.size() > 0 && d.id.size() <= 128
        && d.inventoryId is string && d.inventoryId.size() > 0 && d.inventoryId.size() <= 1500
        && d.productKey is string && d.productKey.size() > 0 && d.productKey.size() <= 1500
        && d.productId is string && d.productId.size() <= 1500
        && d.itemCode is string && d.itemCode.size() <= 1000
        && d.itemName is string && d.itemName.size() <= 1000
        && d.brand is string && d.brand.size() <= 1000
        && d.fromWarehouseId is string && d.fromWarehouseId.size() > 0 && d.fromWarehouseId.size() <= 1500
        && d.toWarehouseId is string && d.toWarehouseId.size() > 0 && d.toWarehouseId.size() <= 1500
        && d.fromStockId is string && d.fromStockId.size() > 0 && d.fromStockId.size() <= 1500
        && d.createdByUid is string && d.createdByUid.size() > 0 && d.createdByUid.size() <= 128
        && d.createdAt is string && d.createdAt.size() <= 40
        && d.qty is number && d.qty > 0 && d.qty <= 1000000
        && d.status in ['PENDING','SHIPPED','CANCELLED']
        && d.fromWarehouseId != d.toWarehouseId;
    }
    function mainTransferHold(d, direction) {
      let invPath = /databases/$(database)/documents/inventory/$(d.inventoryId);
      let stockPath = /databases/$(database)/documents/warehouseStocks/$(d.fromStockId);
      let inv = get(invPath).data;
      let nextInv = getAfter(invPath).data;
      let stock = get(stockPath).data;
      let nextStock = getAfter(stockPath).data;
      return stock.productKey == d.productKey && stock.warehouseId == d.fromWarehouseId
        && inv.get('productKey', inv.get('productId', '')) == d.productKey
        && nextStock.onHand == stock.onHand && nextInv.onHand == inv.onHand
        && nextStock.reserved == stock.reserved + direction * d.qty
        && nextStock.get('transferReserved', 0) == stock.get('transferReserved', 0) + direction * d.qty
        && nextInv.reserved == inv.reserved + direction * d.qty
        && nextInv.get('transferReserved', 0) == inv.get('transferReserved', 0) + direction * d.qty
        && nextStock.reserved >= 0 && nextStock.reserved <= nextStock.onHand
        && nextStock.get('transferReserved', 0) >= 0 && nextInv.get('transferReserved', 0) >= 0
        && nextInv.diff(inv).affectedKeys().hasOnly(['reserved','transferReserved','updatedAt'])
        && nextStock.diff(stock).affectedKeys().hasOnly(['reserved','transferReserved','updatedAt']);
    }
    function mainTransferDispatch(d) {
      let path = /databases/$(database)/documents/stockTransfers/$(d.get('transferId', 'unused'));
      let transfer = getAfter(path).data;
      return !exists(path) && transfer.requestId == d.id && transfer.inventoryId == d.inventoryId
        && transfer.fromWarehouseId == d.fromWarehouseId && transfer.toWarehouseId == d.toWarehouseId
        && transfer.qty == d.qty && transfer.reservedQty == 0 && transfer.kind == 'TRANSFER'
        && transfer.status == 'IN_TRANSIT' && transfer.createdByUid == request.auth.uid;
    }
    match /stockTransferRequests/{id} {
      allow read: if canReceiveInventory();
      allow create: if (admin() || purchaser()) && validMainTransferRequest(request.resource.data)
        && request.resource.data.id == id && request.resource.data.status == 'PENDING'
        && request.resource.data.createdByUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['transferId','shippedAt','shippedByUid','cancelledAt','cancelledByUid'])
        && get(/databases/$(database)/documents/warehouses/$(request.resource.data.toWarehouseId)).data.get('isDefault', false)
        && get(/databases/$(database)/documents/warehouses/$(request.resource.data.toWarehouseId)).data.get('active', true)
        && !get(/databases/$(database)/documents/warehouses/$(request.resource.data.toWarehouseId)).data.get('systemCustody', false)
        && get(/databases/$(database)/documents/warehouses/$(request.resource.data.fromWarehouseId)).data.get('active', true)
        && !get(/databases/$(database)/documents/warehouses/$(request.resource.data.fromWarehouseId)).data.get('systemCustody', false)
        && mainTransferHold(request.resource.data, 1);
      allow update: if validMainTransferRequest(request.resource.data) && resource.data.status == 'PENDING'
        && ((canReceiveInventory() && request.resource.data.status == 'SHIPPED'
          && request.resource.data.shippedByUid == request.auth.uid
          && request.resource.data.shippedAt is string && request.resource.data.shippedAt.size() <= 40
          && request.resource.data.transferId is string && request.resource.data.transferId.size() <= 128
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','transferId','shippedAt','shippedByUid'])
          && mainTransferDispatch(request.resource.data))
        || ((admin() || purchaser()) && request.resource.data.status == 'CANCELLED'
          && request.resource.data.cancelledByUid == request.auth.uid
          && request.resource.data.cancelledAt is string && request.resource.data.cancelledAt.size() <= 40
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','cancelledByUid'])
          && mainTransferHold(request.resource.data, -1)));
      allow delete: if false;
    }
    function transferRequestHold(d) {
      let path = /databases/$(database)/documents/stockTransferRequests/$(d.get('requestId', 'unused'));
      let before = get(path).data;
      let after = getAfter(path).data;
      return before.status == 'PENDING' && after.status == 'SHIPPED'
        && after.transferId == d.id && after.shippedByUid == request.auth.uid
        && before.inventoryId == d.inventoryId && before.productKey == d.productKey
        && before.fromWarehouseId == d.fromWarehouseId && before.toWarehouseId == d.toWarehouseId
        && before.fromStockId == d.fromStockId && before.qty == d.qty
        && d.orderId == '' && d.kind == 'TRANSFER' && d.reservedQty == 0;
    }
    function transferSourceStock(d) {
      let path = /databases/$(database)/documents/warehouseStocks/$(d.fromStockId);
      let before = get(path).data;
      let after = getAfter(path).data;
      let held = d.get('requestId', '') != '' ? d.qty : 0;
      return (held == 0 || transferRequestHold(d))
        && before.productKey == d.productKey && before.warehouseId == d.fromWarehouseId
        && after.onHand == before.onHand - d.qty
        && after.reserved == before.reserved - d.reservedQty - held
        && (held == 0 || after.get('transferReserved', 0) == before.get('transferReserved', 0) - held)
        && after.get('incoming', 0) == before.get('incoming', 0)
        && after.onHand >= after.reserved && after.reserved >= 0;
    }
    function transferTargetStock(d) {
      let path = /databases/$(database)/documents/warehouseStocks/$(d.toStockId);
      let before = exists(path) ? get(path).data : {};
      let after = getAfter(path).data;
      return after.productKey == d.productKey && after.warehouseId == d.toWarehouseId
        && after.onHand == before.get('onHand', 0) + d.qty
        && after.reserved == before.get('reserved', 0) + d.reservedQty
        && after.get('incoming', 0) == before.get('incoming', 0);
    }
    function transferAggregate(d, receive) {
      let path = /databases/$(database)/documents/inventory/$(d.inventoryId);
      let before = get(path).data;
      let after = getAfter(path).data;
      let direction = receive ? -1 : 1;
      let held = !receive && d.get('requestId', '') != '' ? d.qty : 0;
      return before.get('productKey', before.get('productId', '')) == d.productKey
        && after.onHand == before.onHand && after.reserved == before.reserved - held
        && (held == 0 || after.get('transferReserved', 0) == before.get('transferReserved', 0) - held)
        && after.get('incoming', 0) == before.get('incoming', 0)
        && (d.kind == 'HANDOFF'
          ? after == before
          : after.get('transferInTransit', 0) == before.get('transferInTransit', 0) + direction * d.qty
            && after.get('transferFreeInTransit', 0) == before.get('transferFreeInTransit', 0) + direction * (d.qty - d.reservedQty)
            && after.get('transferInTransit', 0) >= 0 && after.get('transferFreeInTransit', 0) >= 0);
    }
    function transferOrderEvidence(d) {
      let path = /databases/$(database)/documents/orders/$(d.get('orderId', 'unused'));
      return d.get('orderId', '') == '' ? d.reservedQty == 0 && d.kind == 'TRANSFER'
        : getAfter(path).data.get('warehouseLogisticsId', '') == d.id
          && getAfter(path).data.items[d.itemIndex].itemId == d.itemId
          && d.reservedQty == d.qty;
    }
    match /stockTransfers/{id} {
      allow get, list: if canReceiveInventory();
      allow create: if canReceiveInventory() && request.resource.data.id == id
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.qty is number && request.resource.data.qty > 0
        && request.resource.data.reservedQty is number && request.resource.data.reservedQty >= 0
        && request.resource.data.reservedQty <= request.resource.data.qty
        && request.resource.data.allocations is list && request.resource.data.allocations.size() > 0 && request.resource.data.allocations.size() <= 200
        && request.resource.data.fromWarehouseId != request.resource.data.toWarehouseId
        && request.resource.data.kind in ['TRANSFER','HANDOFF']
        && request.resource.data.status == (request.resource.data.kind == 'HANDOFF' ? 'RECEIVED' : 'IN_TRANSIT')
        && transferOrderEvidence(request.resource.data) && transferSourceStock(request.resource.data)
        && transferAggregate(request.resource.data, false)
        && (request.resource.data.kind != 'HANDOFF' || transferTargetStock(request.resource.data));
      allow update: if canReceiveInventory() && ((resource.data.status == 'IN_TRANSIT'
        && request.resource.data.status == 'RECEIVED' && request.resource.data.receivedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','receivedAt','receivedByUid','autoAllocationQty','autoAllocatedQty','allocationCompleted'])
        && request.resource.data.get('autoAllocationQty', resource.data.qty - resource.data.reservedQty) == (resource.data.get('orderId', '') == '' ? resource.data.qty - resource.data.reservedQty : 0)
        && request.resource.data.get('autoAllocatedQty', 0) == 0
        && transferTargetStock(request.resource.data) && transferAggregate(request.resource.data, true)
        && transferOrderEvidence(request.resource.data))
        || (resource.data.status == 'RECEIVED' && resource.data.get('orderId', '') == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['autoAllocatedQty','allocationCompleted','allocationUpdatedAt'])
          && request.resource.data.get('autoAllocatedQty', 0) is number
          && request.resource.data.get('autoAllocatedQty', 0) >= resource.data.get('autoAllocatedQty', 0)
          && request.resource.data.get('autoAllocatedQty', 0) <= resource.data.get('autoAllocationQty', 0)
          && request.resource.data.get('allocationCompleted', false) is bool));
      allow delete: if false;
    }

    match /inventory/{id} {
      // Aggregate operational stock is shared, but cost fields must never be embedded here.
      // stockPolicy/safetyStock are planning master data: admin/purchaser manage them;
      // warehouse keeps those fields unchanged while performing physical stock work.
      allow get: if safeStockReader(resource == null ? {} : resource.data);
      allow list: if active() && !('unitCost' in resource.data) && !('cost' in resource.data);
      allow create: if (
          ((admin() || purchaser()) && validInventoryStockPolicy(request.resource.data))
          || (warehouse() && warehouseInventoryPlanningDefaults(request.resource.data))
        )
        && nonNegativeInventory(request.resource.data)
        // Administrators can restore archived records from an existing backup.
        && (!request.resource.data.keys().hasAny(inventoryArchiveKeys())
          || (admin() && request.resource.data.get('listArchived', false) is bool))
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow update: if inventoryUpdateWriter(id)
        && validInventoryArchiveChange(id)
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow delete: if false;
    }

    match /warehouseStocks/{id} {
      allow get: if safeStockReader(resource == null ? {} : resource.data);
      allow list: if safeStockReader(resource.data);
      allow create: if canReceiveInventory() && validWarehouseStock(request.resource.data)
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      // Receiver validation already includes recovery metadata; business updates
      // validate it in their own branch, so neither path evaluates it twice.
      allow update: if ((canReceiveInventory() && validWarehouseStock(request.resource.data))
          || (businessWarehouseStockOperationalUpdate(id) && validStockRecoveryMetadata(request.resource.data)))
        && warehouseStockIdentityUnchanged()
        && validStockRecoveryUpdate()
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow delete: if false;
    }

    match /inventoryReservations/{id} {
      // Reservation transactions first read their deterministic ID so retries remain idempotent.
      // A missing document contains no business data; existing documents stay owner-scoped.
      allow get: if (resource == null ? role() in ['admin','purchaser','warehouse','sales','engineer'] : operationalOrOwnedReader(resource.data));
      allow list: if operationalOrOwnedReader(resource.data);
      allow create: if reservationCreateAllowed(id);
      allow update: if reservationUpdateAllowed(id);
      allow delete: if admin();
    }

    match /inventoryLots/{id} {
      // Operational lot data is readable for fulfillment, but cost must never live here.
      allow read: if admin() || purchaser() || warehouse() || (businessOwner() && !('unitCost' in resource.data));
      allow create: if canReceiveInventory() && validInventoryLot(request.resource.data);
      allow update: if (canReceiveInventory() || businessInventoryLotOperationalUpdate(id))
        && validInventoryLot(request.resource.data) && inventoryLotIdentityUnchanged();
      allow delete: if admin();
    }

    // Actual receipt/lot cost is physically separated from operational lot data.
    // Client-side fulfillment never requires this collection.
    match /inventoryLotCosts/{id} {
      allow read: if admin() || purchaser();
      allow create: if admin() || purchaser() || (warehouse() && (
        (request.resource.data.get('sourceType', '') == 'SUPPLY_ORDER'
          && !request.resource.data.keys().hasAny(['unitCost', 'cost', 'costPrice'])
          && request.resource.data.get('costSourceSupplyId', '') == request.resource.data.get('sourceId', '')
          && request.resource.data.get('sourceId', '') != ''
          && getAfter(/databases/$(database)/documents/inventoryLots/$(id)).data.get('sourceId', '') == request.resource.data.sourceId)
        || (request.resource.data.get('sourceType', '') == 'WAREHOUSE_TRANSFER'
          && !request.resource.data.keys().hasAny(['unitCost','cost','costPrice'])
          && request.resource.data.costSourceLotId == getAfter(/databases/$(database)/documents/inventoryLots/$(id)).data.costLotId
          && request.resource.data.sourceId == getAfter(/databases/$(database)/documents/inventoryLots/$(id)).data.sourceId
          && getAfter(/databases/$(database)/documents/stockTransfers/$(request.resource.data.sourceId)).data.status == 'RECEIVED')
        || (request.resource.data.get('sourceType', '') == 'INITIAL_STOCK'
          && !request.resource.data.keys().hasAny(['unitCost', 'cost', 'costPrice'])
          && request.resource.data.lotId == id
          && getAfter(/databases/$(database)/documents/inventoryLots/$(id)).data.get('sourceType', '') == 'INITIAL_STOCK')
      ));
      allow update: if admin() || purchaser();
      allow delete: if admin();
    }

    function validActiveReturnWarehouse(warehouseId) {
      return warehouseId is string && warehouseId.size() > 0 && warehouseId.size() <= 128
        && !warehouseId.matches('custody-.*')
        && exists(/databases/$(database)/documents/warehouses/$(warehouseId))
        && get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.get('active', true) == true
        && get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.get('systemCustody', false) != true
        && get(/databases/$(database)/documents/warehouses/$(warehouseId)).data.get('warehouseType', '') != 'CUSTODY';
    }

    match /customerReturnReceipts/{id} {
      allow read: if canReceiveInventory() || (businessOwner() && owns(resource.data));
      allow create: if canReceiveInventory()
        && validActiveReturnWarehouse(request.resource.data.warehouseId)
        && request.resource.data.receivedBy == request.auth.uid
        && request.resource.data.qty is number && request.resource.data.qty > 0
        && request.resource.data.quality in ['SALEABLE', 'INSPECTION', 'DAMAGED']
        && request.resource.data.disposition == (request.resource.data.quality == 'SALEABLE' ? 'STOCK' : 'HOLD')
        && request.resource.data.record.id == id
        && request.resource.data.record.qty == request.resource.data.qty
        && request.resource.data.record.requestId == request.resource.data.requestId
        && request.resource.data.record.itemId == request.resource.data.itemId
        && request.resource.data.record.settlement == 'CLOSE'
        && request.resource.data.record.quality == request.resource.data.quality
        && request.resource.data.record.warehouseId == request.resource.data.warehouseId
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.returnReceiptId == id;
      allow update: if canReceiveInventory() && resource.data.disposition == 'HOLD'
        && validActiveReturnWarehouse(resource.data.warehouseId)
        && request.resource.data.disposition == 'STOCK'
        && request.resource.data.releasedBy == request.auth.uid
        && request.resource.data.releasedAt != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disposition', 'releasedAt', 'releasedBy']);
      allow delete: if admin();
    }

    match /receipts/{id} {
      allow get: if admin() || purchaser() || warehouse()
        || (businessOwner() && (resource == null || owns(resource.data)));
      allow list: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if (request.resource.data.get('fulfillmentType', '') == 'DIRECT_SHIP'
        ? validDirectShipReceipt(id, request.resource.data) : canReceiveInventory())
        && !('unitCost' in request.resource.data)
        && !('purchaseNetAmount' in request.resource.data);
      // Receipt facts remain immutable. Receiving roles may only advance the
      // post-receipt shortage-allocation checkpoint used for resumable/idempotent retries.
      allow update: if canReceiveInventory()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'autoAllocatedQty', 'allocationCompleted', 'allocationUpdatedAt'
        ])
        && request.resource.data.get('autoAllocatedQty', 0) >= resource.data.get('autoAllocatedQty', 0)
        && request.resource.data.get('autoAllocatedQty', 0) <= resource.data.get('autoAllocationQty', 0);
      allow delete: if admin();
    }


    // 外倉出貨通知：資料與訂單分離；下載 PDF 不寫入狀態。
    // 只有實際確認通知時建立 NOTIFIED；SHIPPED 需與訂單/庫存交易同時提交。
    match /externalDispatchNotices/{id} {
      allow get: if admin() || purchaser() || warehouse()
        || (businessOwner() && (resource == null || owns(resource.data)));
      allow list: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Purchaser records completion of the company's existing shipping paperwork.
    match /dispatchRecords/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if admin() || purchaser();
      allow update: if false;
      allow delete: if admin();
    }

    // Physical delivery is recorded by the responsible business owner.
    match /deliveries/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if admin()
        || (businessOwner() && owns(request.resource.data));
      allow update: if false;
      allow delete: if admin();
    }

    match /pendingInventoryItems/{id} {
      allow read: if admin() || purchaser() || warehouse();
      allow create, update: if admin() || purchaser() || warehouse();
      allow delete: if admin();
    }

    // Immutable stock ledger.
    match /inventoryMovements/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if inventoryMovementWriter(id)
        && !('unitCost' in request.resource.data)
        && !('purchaseNetAmount' in request.resource.data)
        && !('cogs' in request.resource.data);
      allow update: if false;
      allow delete: if admin();
    }

    // Immutable operational audit trail.
    match /stockOperations/{id} {
      allow get: if active() && (resource == null || admin() || purchaser() || warehouse() || resource.data.actorUid == request.auth.uid);
      allow list: if admin() || purchaser() || warehouse() || (active() && resource.data.actorUid == request.auth.uid);
      allow create: if admin() || validStockOperation(request.resource.data);
      allow update, delete: if false;
    }

    // Inventory planning receipt: prototype schema scoped to this new action.
    // Settings and receipt must describe the same atomic operation; no stock change.
    function validInventoryPlanningAudit(data) {
      let before = get(/databases/$(database)/documents/inventory/$(data.inventoryId)).data;
      let after = getAfter(/databases/$(database)/documents/inventory/$(data.inventoryId)).data;
      return role() in ['admin','purchaser']
        && data.keys().hasAll(['action','inventoryId','actorUid','actorRole','stockPolicy','safetyStock','previousStockPolicy','previousSafetyStock','changed','createdAt'])
        && data.keys().hasOnly(['action','inventoryId','actorUid','actorRole','stockPolicy','safetyStock','previousStockPolicy','previousSafetyStock','changed','createdAt'])
        && data.inventoryId is string && data.inventoryId.size() > 0 && data.inventoryId.size() <= 128
        && data.inventoryId.matches('^[^/]+$')
        && data.actorUid == request.auth.uid
        && data.actorRole in ['admin','purchaser'] && (admin() || data.actorRole == 'purchaser')
        && data.stockPolicy in ['NO_STOCK','SAFETY_STOCK','ORDER_ONLY']
        && data.safetyStock is number && data.safetyStock >= 0 && data.safetyStock <= 9007199254740991
        && (data.stockPolicy == 'SAFETY_STOCK' ? data.safetyStock > 0 : data.safetyStock == 0)
        && data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 32
        && data.previousStockPolicy == before.get('stockPolicy', null)
        && data.previousSafetyStock == before.get('safetyStock', null)
        && (data.previousStockPolicy == null || (data.previousStockPolicy is string && data.previousStockPolicy.size() <= 32))
        && (data.previousSafetyStock == null || data.previousSafetyStock is number)
        && data.changed is bool && data.changed == (before.get('stockPolicy', null) != data.stockPolicy || before.get('safetyStock', null) != data.safetyStock)
        && after.stockPolicy == data.stockPolicy && after.safetyStock == data.safetyStock
        && after.diff(before).affectedKeys().hasOnly(['stockPolicy','safetyStock','updatedAt'])
        && (!data.changed || after.updatedAt == data.createdAt);
    }
    match /auditLogs/{id} {
      // A transaction may test a new operation ID before creating its receipt.
      // Missing documents carry no audit data; existing records remain owner-scoped.
      allow get: if active() && (resource == null
        ? role() in ['admin','purchaser']
        : admin() || resource.data.actorUid == request.auth.uid);
      allow list: if admin() || (active() && resource.data.actorUid == request.auth.uid);
      allow create: if active() && request.resource.data.actorUid == request.auth.uid
        && (request.resource.data.get('action', '') != 'inventory_policy_set' || validInventoryPlanningAudit(request.resource.data));
      allow update: if false;
      allow delete: if admin();
    }

    match /equipment/{id} {
      allow read: if canManageEquipment() || (businessOwner() && owns(resource.data));
      allow create: if canManageEquipment()
        || (sales() && owns(request.resource.data));
      allow update: if canManageEquipment()
        || (sales() && owns(resource.data) && owns(request.resource.data));
      allow delete: if false;
    }

    // Callable-only idempotency receipt; client SDK cannot create or delete
    // the server's transaction checkpoint even if it is signed in.
    match /reservationOperationReceipts/{id} {
      allow read, write: if false;
    }

    // Service work events are written only by the gated Admin SDK Service.
    // No client access until per-role reads and Service UI are accepted.
    match /serviceCases/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

