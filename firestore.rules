    function validInventoryShipmentStock(record) {
      let movementPath = /databases/$(database)/documents/inventoryMovements/$(record.movementId);
      let movement = getAfter(movementPath).data;
      let stockPath = /databases/$(database)/documents/warehouseStocks/$(movement.warehouseStockId);
      let inventoryPath = /databases/$(database)/documents/inventory/$(movement.inventoryDocId);
      return !exists(movementPath)
        && movement.get('type', '') == 'ship'
        && movement.get('sourceId', '') == record.orderId
        && movement.get('itemId', '') == record.itemId
        && movement.get('productKey', '') == record.productKey
        && movement.get('warehouseId', '') == record.warehouseId
        && movement.get('actorUid', '') == request.auth.uid
        && movement.get('qty', 0) == -record.qty
        && get(stockPath).data.get('warehouseId', '') == record.warehouseId
        && get(stockPath).data.get('productKey', '') == movement.get('productKey', '')
        && get(inventoryPath).data.get('productKey', '') == movement.get('productKey', '')
        && getAfter(stockPath).data.get('onHand', -1) == get(stockPath).data.onHand - record.qty
        && getAfter(stockPath).data.get('reserved', -1) == get(stockPath).data.reserved - record.qty
        && getAfter(inventoryPath).data.get('onHand', -1) == get(inventoryPath).data.onHand - record.qty
        && getAfter(inventoryPath).data.get('reserved', -1) == get(inventoryPath).data.reserved - record.qty;
    }

    function inventoryShipmentOrderUpdate(orderId) {
      let before = resource.data;
      let after = request.resource.data;
      let beforeRecords = before.get('deliveryRecords', []);
      let afterRecords = after.get('deliveryRecords', []);
      let record = afterRecords[beforeRecords.size()];
      return canReceiveInventory()
        && !orderIsCancelled(before)
        && before.get('inventoryReservationStatus', '') != 'pending'
        && beforeRecords.size() + 1 == afterRecords.size()
        && afterRecords.removeAll([record]) == beforeRecords
        && record.get('id', '') == after.get('inventoryShipmentRecordId', '')
        && record.get('sourceType', '') == 'INVENTORY_SHIPMENT'
        && record.get('orderId', '') == orderId
        && record.get('createdByUid', '') == request.auth.uid
        && record.get('qty', 0) is number && record.qty > 0
        && after.get('deliveredQty', 0) == before.get('deliveredQty', 0) + record.qty
        && sameCommercialOwner() && preservesCreator()
        && after.diff(before).affectedKeys().hasOnly([
          'inventoryShipmentRecordId', 'items', 'deliveryRecords', 'deliveredQty', 'isDelivered',
          'deliveryHistory', 'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ])
        && validInventoryShipmentItem(before, after, record)
        && validInventoryShipmentStock(record);
    }


    function appendsLogisticsHistory(before, after) {
      let prior = before.get('logisticsHistory', []);
      let next = after.get('logisticsHistory', []);
      let entry = next[prior.size()];
      return next.size() == prior.size() + 1 && next.removeAll([entry]) == prior;
    }
    // Warehouse instructions only change one item's recipient plan. Commercial fields stay intact.
    function warehouseDeliveryPlanUpdate() {
      let before = resource.data;
      let userRole = role();
      let after = request.resource.data;
      let index = after.get('logisticsPlanItemIndex', -1);
      let oldItem = before.items[index];
      let newItem = after.items[index];
      // The final changed-key whitelist preserves owner and creator fields.
      return (userRole in ['admin','purchaser','warehouse'] || (userRole in ['sales','engineer']
          && (before.get('ownerUid', '') == request.auth.uid || owns(before))
          && oldItem.get('warehouseShippedQty', 0) == 0
          && oldItem.get('deliveredQty', 0) == 0 && orderBeforeFirstReceipt(before)))
        && oldItem.get('transferPendingId', '') == ''
        && (userRole in ['sales','engineer'] ? oldItem.get('qty', oldItem.get('orderedQty', 0)) > 0
          : oldItem.get('warehouseShippedQty', oldItem.get('deliveredQty', 0)) - oldItem.get('returnedQty', 0) < oldItem.get('qty', oldItem.get('orderedQty', 0)))
        && (!(oldItem.get('warehouseId', '').matches('custody-.*')) || (canReceiveInventory() && newItem.deliveryPlan.mode == 'TRANSFER'))
        && !orderIsCancelled(before)
        && index is int && index >= 0 && index < before.items.size()
        && before.items.size() == after.items.size()
        && before.items.removeAll([oldItem]) == after.items.removeAll([newItem])
        && newItem.diff(oldItem).affectedKeys().hasOnly(['deliveryPlan'])
        && (oldItem.get('fulfillmentType', 'WAREHOUSE') != 'DIRECT_SHIP' || newItem.deliveryPlan.mode == 'CUSTOMER_SHIP')
        && validDeliveryPlan(newItem.deliveryPlan)
        && after.get('logisticsPlanActorUid', '') == request.auth.uid
        && appendsLogisticsHistory(before, after)
        && after.diff(before).affectedKeys().hasOnly(['items', 'logisticsPlanItemIndex',
          'logisticsPlanActorUid', 'logisticsPlanEventId', 'logisticsHistory', 'updatedAt']);
    }
    function validDeliveryPlan(p) {
      return p.keys().hasOnly(['mode','warehouseId','contact','phone','address','packages','condition','tracking','notes'])
        && p.mode in ['PICKUP','SALES_SHIP','CUSTOMER_SHIP','TRANSFER']
        && p.packages is int && p.packages >= 1 && p.packages <= 99
        && p.contact is string && p.contact.size() <= 1000
        && p.phone is string && p.phone.size() <= 1000
        && p.address is string && p.address.size() <= 1000
        && p.notes is string && p.notes.size() <= 1000;
    }
    function warehouseLogisticsOrderUpdate(orderId) {
      let before = resource.data;
      let after = request.resource.data;
