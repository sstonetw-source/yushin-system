      let wasCancelled = orderIsCancelled(before);
      let isCancelled = orderIsCancelled(after);
      return !isCancelled || wasCancelled
        || (noCustodyForCancellation() && before.get('logisticsTransfersPending', 0) == 0 && after.get('logisticsTransfersPending', 0) == 0
          && before.get('isDelivered', false) != true && after.get('isDelivered', false) != true
          && after.get('deliveryRecords', []) == before.get('deliveryRecords', [])
          && after.get('returnRecords', []) == before.get('returnRecords', [])
          && after.get('deliveredQty', 0) == before.get('deliveredQty', 0));
