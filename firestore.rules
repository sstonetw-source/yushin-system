rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userPath());
    }

    function profileEnabled(data) {
      return data.get('active', true) == true && data.get('disabled', false) != true;
    }
    function active() {
      return signedIn() && profileEnabled(userDoc().data);
    }
    function role() {
      return signedIn() ? enabledRole(userDoc().data) : null;
    }
    function enabledRole(data) {
      return profileEnabled(data) ? data.get('role', null) : null;
    }

    function admin() { return role() == 'admin'; }
    function sales() { return role() == 'sales'; }
    function engineer() { return role() == 'engineer'; }
    function purchaser() { return role() == 'purchaser'; }
    function warehouse() { return role() == 'warehouse'; }
    // Customer arrival is a commercial fact, not a warehouse receipt.
    function directShipReceiver() {
      let userRole = role();
      return userRole == 'admin' || (userRole in ['sales', 'engineer'] && resource.data.get('ownerUid', '') == request.auth.uid);
    }

    // Sales and engineers own their own commercial and fulfillment records.
    function businessOwner() {
      return role() in ['sales', 'engineer'];
    }

    function commercialDocumentOwner() {
      return businessOwner();
    }

    function businessAssistant() {
      return purchaser();
    }

    function canCreateCommercialDoc() {
      return admin() || commercialDocumentOwner() || businessAssistant();
    }

    function canPurchase() {
      return admin() || purchaser();
    }

    function canReceiveInventory() {
      return role() in ['admin', 'purchaser', 'warehouse'];
    }

    function canManageEquipment() {
      return admin() || engineer();
    }

    function salesCode() {
      let data = userDoc().data;
      return profileEnabled(data) ? data.get('salesCode', data.get('code', null)) : null;
    }

    function owns(data) {
      let ownerUid = data.get('ownerUid', '');
      let ownerSalesCode = data.get('salesCode', '');
      return active() && (
        (ownerUid != '' && ownerUid == request.auth.uid) ||
        (salesCode() != null && ownerSalesCode != '' && ownerSalesCode == salesCode())
      );
    }

    function validSalesOwner(data) {
      return validQuoteOwner(data)
        && get(/databases/$(database)/documents/users/$(data.ownerUid)).data.role == 'sales';
    }

    // Both quotes and customer orders may belong to an active salesperson or engineer.
    // Purchaser assistance preserves the owner; creator fields retain the actual operator.
    function validQuoteOwner(data) {
      return data.get('ownerUid', '') is string && data.get('ownerUid', '').size() > 0
        && data.get('salesCode', '') is string && data.get('salesCode', '').size() > 0
        && exists(/databases/$(database)/documents/users/$(data.ownerUid))
        && profileEnabled(get(/databases/$(database)/documents/users/$(data.ownerUid)).data)
        && get(/databases/$(database)/documents/users/$(data.ownerUid)).data.role in ['sales', 'engineer']
        && get(/databases/$(database)/documents/users/$(data.ownerUid)).data.get(
          'salesCode',
          get(/databases/$(database)/documents/users/$(data.ownerUid)).data.get('code', null)
        ) == data.salesCode;
    }

    // Engineer may assist a salesperson with a quote, but only quotes the engineer created.
    // Ownership remains with the salesperson; orders are intentionally not covered here.
    function engineerAssistedSalesQuote(data) {
      return engineer()
        && data.get('createdByUid', '') == request.auth.uid
        && data.get('createdByRole', '') == 'engineer';
    }

    function validOwnedCommercialCreate(data) {
      return admin() ||
        (commercialDocumentOwner() &&
          data.ownerUid == request.auth.uid &&
          data.salesCode != null &&
          data.salesCode == salesCode()) ||
        (businessAssistant() &&
          validQuoteOwner(data) &&
          data.ownerUid != request.auth.uid);
    }

    function sameCommercialOwner() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.salesCode == resource.data.salesCode;
    }

    function sameSupplyIdentity() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'type', 'method', 'sourceType', 'sourceId', 'sourceItemId',
        'internalNo', 'purchaseDocumentId', 'purchaseDocumentNo',
        'orderId', 'itemId', 'orderItemIndex',
        'ownerUid', 'salesCode', 'salesName', 'customerName', 'company',
        'productId', 'productKey', 'itemCode', 'itemName', 'brand', 'productLine',
        'fulfillmentType', 'warehouseId', 'orderDate',
        'createdAt', 'createdByUid', 'createdBy', 'createdByRole'
      ]);
    }

    function validSupplyOperationalState() {
      let previousStatus = resource.data.get('status', 'ORDERED');
      let nextStatus = request.resource.data.get('status', 'ORDERED');
      let qty = request.resource.data.get('qty', 0);
      let receivedQty = request.resource.data.get('receivedQty', 0);
      let cancelledQty = request.resource.data.get('cancelledQty', 0);
      let closedQty = request.resource.data.get('closedQty', 0);
      let incomingQty = request.resource.data.get('incomingRegisteredQty', 0);
      return previousStatus != 'CANCELLED'
        && previousStatus != 'CLOSED'
        && qty is number
        && receivedQty is number
        && incomingQty is number
        && cancelledQty is number
        && closedQty is number
        && qty >= resource.data.get('qty', 0)
        && receivedQty >= resource.data.get('receivedQty', 0)
        && receivedQty <= qty
        && incomingQty >= 0
        && incomingQty <= (qty - receivedQty)
        && (
          request.resource.data.get('fulfillmentType', 'WAREHOUSE') != 'DIRECT_SHIP'
          || incomingQty == 0
        )
        && cancelledQty >= 0
        && cancelledQty <= (qty - receivedQty)
        && closedQty >= 0
        && closedQty <= (qty - receivedQty)
        && (
          (
            nextStatus == 'ORDERED'
            && receivedQty == 0
            && cancelledQty == 0
            && closedQty == 0
          )
          || (
            nextStatus == 'PARTIAL_RECEIPT'
            && receivedQty > 0
            && receivedQty < qty
            && cancelledQty == 0
            && closedQty == 0
          )
          || (
            nextStatus == 'RECEIVED'
            && qty > 0
            && receivedQty == qty
            && cancelledQty == 0
            && closedQty == 0
          )
          || (
            nextStatus == 'CANCELLED'
            && qty > receivedQty
            && qty == resource.data.get('qty', 0)
            && receivedQty == resource.data.get('receivedQty', 0)
            && cancelledQty == qty - receivedQty
            && closedQty == 0
            && incomingQty == 0
            && request.resource.data.get('cancelReason', '') != ''
            && request.resource.data.get('cancelledAt', '') != ''
            && request.resource.data.get('cancelledByUid', '') == request.auth.uid
          )
          || (
            nextStatus == 'CLOSED'
            && receivedQty > 0
            && receivedQty < qty
            && qty == resource.data.get('qty', 0)
            && receivedQty == resource.data.get('receivedQty', 0)
            && closedQty == qty - receivedQty
            && cancelledQty == 0
            && incomingQty == 0
            && request.resource.data.get('closeReason', '') != ''
            && request.resource.data.get('closedAt', '') != ''
            && request.resource.data.get('closedByUid', '') == request.auth.uid
          )
        );
    }

    // Direct-ship receiving is a narrow hot path used in the same atomic batch as
    // the order delivery summary. Keep it intentionally small so the combined
    // Firestore Rules evaluation stays below the platform expression limit.
    function directShipSupplyReceiptUpdate(id) {
      let nextReceived = request.resource.data.get('receivedQty', 0);
      let qty = resource.data.get('qty', 0);
      return directShipReceiver()
        && resource.data.get('fulfillmentType', 'WAREHOUSE') == 'DIRECT_SHIP'
        && directShipSupplyReceiptEvidence(id)
        && resource.data.get('status', 'ORDERED') != 'CANCELLED'
        && resource.data.get('status', 'ORDERED') != 'CLOSED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receivedQty', 'status', 'updatedAt'
        ])
        && nextReceived is number
        && nextReceived > resource.data.get('receivedQty', 0)
        && nextReceived <= qty
        && resource.data.get('incomingRegisteredQty', 0) == 0
        && resource.data.get('cancelledQty', 0) == 0
        && resource.data.get('closedQty', 0) == 0
        && (
          (nextReceived < qty && request.resource.data.get('status', '') == 'PARTIAL_RECEIPT')
          || (nextReceived == qty && request.resource.data.get('status', '') == 'RECEIVED')
        );
    }

    function directShipSupplyReceiptEvidence(id) {
      let orderPath = /databases/$(database)/documents/orders/$(resource.data.orderId);
      let before = get(orderPath).data;
      let after = getAfter(orderPath).data;
      let records = after.get('deliveryRecords', []);
      let record = records[before.get('deliveryRecords', []).size()];
      let receiptPath = /databases/$(database)/documents/receipts/$(record.receiptId);
      let receipt = getAfter(receiptPath).data;
      return !orderIsCancelled(before)
        && resource.data.ownerUid == before.ownerUid
        && records.size() == before.get('deliveryRecords', []).size() + 1
        && record.sourceType == 'DIRECT_SHIP_RECEIPT' && record.sourceId == id
        && !exists(receiptPath) && receipt.supplyOrderId == id
        && receipt.qty == request.resource.data.receivedQty - resource.data.get('receivedQty', 0)
        && record.qty == receipt.qty;
    }

    function purchaserSupplyOperationalUpdate() {
      // Supply identity is immutable; purchasing may only change operational progress.
      return purchaser()
        && (resource.data.get('fulfillmentType', 'WAREHOUSE') != 'DIRECT_SHIP'
          || request.resource.data.get('receivedQty', 0) == resource.data.get('receivedQty', 0))
        && sameSupplyIdentity()
        && (resource.data.get('receivedQty', 0) == 0 || request.resource.data.get('unitCost', 0) == resource.data.get('unitCost', 0))
        && validSupplyOperationalState()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'qty', 'receivedQty',
          'incomingRegisteredQty', 'incomingRegisteredAt',
          'status', 'supplier', 'unitCost',
          'lastOrderedAt', 'orderEvents',
          'cancelledQty', 'cancelReason', 'cancelledAt', 'cancelledByUid', 'cancelledBy',
          'closedQty', 'closeReason', 'closedAt', 'closedByUid', 'closedBy',
          'updatedAt'
        ]);
    }

    // Current orders use status=active. Match normalizedOrderStatus: either
    // cancellation field blocks receipt until purchasing explicitly keeps stock.
    function orderIsCancelled(data) {
      return data.get('status', '') in ['cancelled', 'voided']
        || data.get('orderStatus', '') in ['cancelled', 'voided'];
    }

    function supplierReceiptDispositionAllowed() {
      let before = resource.data;
      let after = request.resource.data;
      let orderId = before.get('orderId', '');
      return after.get('receivedQty', 0) <= before.get('receivedQty', 0) || orderId == ''
        || !orderIsCancelled(get(/databases/$(database)/documents/orders/$(orderId)).data)
        || before.get('customerCancellationDisposition', '') == 'KEEP_STOCK';
    }

    function warehouseSupplyOperationalUpdate() {
      return warehouse()
        && resource.data.get('fulfillmentType', 'WAREHOUSE') != 'DIRECT_SHIP'
        && sameSupplyIdentity()
        && validSupplyOperationalState()
        && request.resource.data.get('status', 'ORDERED') != 'CANCELLED'
        && request.resource.data.get('status', 'ORDERED') != 'CLOSED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receivedQty', 'incomingRegisteredQty', 'status', 'updatedAt'
        ]);
    }

    // Creator identity is an audit field. Legacy documents without creator metadata
    // remain editable; once present, normal workflow edits cannot rewrite it.
    function preservesCreator() {
      return resource.data.get('createdByUid', '') == ''
        ? (
          request.resource.data.get('createdByUid', '') == ''
          && request.resource.data.get('createdByName', '') == ''
          && request.resource.data.get('createdByRole', '') == ''
        )
        : (
          request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
          && request.resource.data.get('createdByName', '') == resource.data.get('createdByName', '')
          && request.resource.data.get('createdByRole', '') == resource.data.get('createdByRole', '')
        );
    }

    function directShipReceiptOrderUpdate(orderId) {
      let beforeRecords = resource.data.get('deliveryRecords', []);
      let afterRecords = request.resource.data.get('deliveryRecords', []);
      return directShipReceiver()
        && afterRecords.size() == beforeRecords.size() + 1
        && operationalItemsOnly(['orderedQty', 'reservedQty', 'shortageQty', 'receivedQty', 'deliveredQty', 'directShipDeliveredQty', 'receiptEvents', 'reservationStatus', 'inventoryProductKey'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'itemCount', 'orderSchemaVersion',
          'deliveryRecords', 'deliveredQty', 'isDelivered',
          'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ])
        && directShipReceiptOrderEvidence(orderId);
    }

    function directShipReceiptOrderEvidence(orderId) {
      let beforeRecords = resource.data.get('deliveryRecords', []);
      let afterRecords = request.resource.data.get('deliveryRecords', []);
      let newRecord = afterRecords[beforeRecords.size()];
      let supplyId = newRecord.get('sourceId', '');
      let supplyPath = /databases/$(database)/documents/supplyOrders/$(supplyId);
      let supplyBefore = get(supplyPath).data;
      let supplyAfter = getAfter(supplyPath).data;
      let index = newRecord.get('itemIndex', -1);
      let beforeItem = resource.data.items[index];
      let afterItem = request.resource.data.items[index];
      return afterRecords.hasAll(beforeRecords)
        && !beforeRecords.hasAny([newRecord])
        && newRecord.get('sourceType', '') == 'DIRECT_SHIP_RECEIPT'
        && newRecord.get('qty', 0) is number
        && newRecord.get('qty', 0) > 0
        && supplyBefore.get('orderId', '') == orderId
        && supplyBefore.get('itemId', '') == newRecord.get('itemId', '')
        && supplyBefore.get('fulfillmentType', 'WAREHOUSE') == 'DIRECT_SHIP'
        && supplyBefore.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && index is int && index >= 0 && index < resource.data.items.size()
        && beforeItem.itemId == newRecord.itemId && beforeItem.get('fulfillmentType', '') == 'DIRECT_SHIP'
        && request.resource.data.items.removeAll([afterItem]) == resource.data.items.removeAll([beforeItem])
        && afterItem.get('receivedQty', 0) == beforeItem.get('receivedQty', 0) + newRecord.qty
        && afterItem.get('deliveredQty', 0) == beforeItem.get('deliveredQty', 0) + newRecord.qty
        && request.resource.data.get('deliveredQty', 0) == resource.data.get('deliveredQty', 0) + newRecord.qty
        && supplyAfter.get('receivedQty', 0) == supplyBefore.get('receivedQty', 0) + newRecord.get('qty', 0)
        && supplyAfter.get('receivedQty', 0) <= supplyBefore.get('qty', 0);
    }

    // Rules cannot iterate lists; keep this bounded to stay below the evaluator limit.
    // Larger operational item changes require an administrator.
    function operationalItemsOnly(allowed) {
      let before = resource.data.get('items', []);
      let after = request.resource.data.get('items', []);
      return before == after || (before.size() == after.size() && before.size() <= 30
        && (before.size() <= 0 ? true : after[0].diff(before[0]).affectedKeys().hasOnly(allowed) && (before.size() <= 1 ? true : after[1].diff(before[1]).affectedKeys().hasOnly(allowed) && (before.size() <= 2 ? true : after[2].diff(before[2]).affectedKeys().hasOnly(allowed) && (before.size() <= 3 ? true : after[3].diff(before[3]).affectedKeys().hasOnly(allowed) && (before.size() <= 4 ? true : after[4].diff(before[4]).affectedKeys().hasOnly(allowed) && (before.size() <= 5 ? true : after[5].diff(before[5]).affectedKeys().hasOnly(allowed) && (before.size() <= 6 ? true : after[6].diff(before[6]).affectedKeys().hasOnly(allowed) && (before.size() <= 7 ? true : after[7].diff(before[7]).affectedKeys().hasOnly(allowed) && (before.size() <= 8 ? true : after[8].diff(before[8]).affectedKeys().hasOnly(allowed) && (before.size() <= 9 ? true : after[9].diff(before[9]).affectedKeys().hasOnly(allowed) && (before.size() <= 10 ? true : after[10].diff(before[10]).affectedKeys().hasOnly(allowed) && (before.size() <= 11 ? true : after[11].diff(before[11]).affectedKeys().hasOnly(allowed) && (before.size() <= 12 ? true : after[12].diff(before[12]).affectedKeys().hasOnly(allowed) && (before.size() <= 13 ? true : after[13].diff(before[13]).affectedKeys().hasOnly(allowed) && (before.size() <= 14 ? true : after[14].diff(before[14]).affectedKeys().hasOnly(allowed) && (before.size() <= 15 ? true : after[15].diff(before[15]).affectedKeys().hasOnly(allowed) && (before.size() <= 16 ? true : after[16].diff(before[16]).affectedKeys().hasOnly(allowed) && (before.size() <= 17 ? true : after[17].diff(before[17]).affectedKeys().hasOnly(allowed) && (before.size() <= 18 ? true : after[18].diff(before[18]).affectedKeys().hasOnly(allowed) && (before.size() <= 19 ? true : after[19].diff(before[19]).affectedKeys().hasOnly(allowed) && (before.size() <= 20 ? true : after[20].diff(before[20]).affectedKeys().hasOnly(allowed) && (before.size() <= 21 ? true : after[21].diff(before[21]).affectedKeys().hasOnly(allowed) && (before.size() <= 22 ? true : after[22].diff(before[22]).affectedKeys().hasOnly(allowed) && (before.size() <= 23 ? true : after[23].diff(before[23]).affectedKeys().hasOnly(allowed) && (before.size() <= 24 ? true : after[24].diff(before[24]).affectedKeys().hasOnly(allowed) && (before.size() <= 25 ? true : after[25].diff(before[25]).affectedKeys().hasOnly(allowed) && (before.size() <= 26 ? true : after[26].diff(before[26]).affectedKeys().hasOnly(allowed) && (before.size() <= 27 ? true : after[27].diff(before[27]).affectedKeys().hasOnly(allowed) && (before.size() <= 28 ? true : after[28].diff(before[28]).affectedKeys().hasOnly(allowed) && (before.size() <= 29 ? true : after[29].diff(before[29]).affectedKeys().hasOnly(allowed) && true)))))))))))))))))))))))))))))));
    }
    function purchasingItemFields() {
      return ['orderedQty', 'reservedQty', 'shortageQty', 'dispatchPreparedQty',
        'receivedQty', 'supplyOrderedQty', 'purchaseOrderedQty', 'purchaseOrderNo', 'purchaseOrderNos',
        'purchaseDocumentIds', 'purchaseDocumentNos', 'supplyOrderIds', 'supplyOrders',
        'receiptEvents', 'purchaseEvents', 'reservationStatus', 'reservationError', 'inventoryProductKey',
        'linkedDocuments', 'procurementStatus', 'perOrdered', 'perReceived'];
    }
    function purchaserOrderWorkflowUpdate() {
      return purchaser()
        && operationalItemsOnly(purchasingItemFields())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'itemCount', 'orderSchemaVersion',
          'purchaseOrderNo', 'purchaseOrderNos', 'purchaseOrderedQty', 'purchaseStatus',
          'linkedDocuments',
          'costPrice', 'transactionType', 'invoiceTitle', 'remarks', 'billingDate', 'fieldEditHistory',
          'inventoryReservationStatus', 'inventoryReservationError', 'inventoryReservationUpdatedAt', 'inventoryReservationAttemptId',
          'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ])
        && sameCommercialOwner();
    }

    function warehouseOrderWorkflowUpdate() {
      return warehouse()
        && !(resource.data.get('inventoryReservationStatus', '') in ['pending', 'failed'])
        && operationalItemsOnly(['orderedQty', 'reservedQty', 'shortageQty', 'receivedQty', 'receiptEvents', 'reservationStatus', 'inventoryProductKey'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'itemCount', 'orderSchemaVersion',
          'inventoryReservedQty', 'inventoryShortageQty',
          'receivedQty',
          'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ])
        && sameCommercialOwner();
    }

    function productPath(id) {
      return /databases/$(database)/documents/products/$(id);
    }

    function businessTemporaryProduct(id, data) {
      return businessOwner()
        && data.get('productId', '') == id
        && data.get('status', '') == 'TEMPORARY'
        && data.get('active', false) == true
        && data.get('source', '') == 'QUICK_CREATE'
        && data.get('createdBy', '') == request.auth.uid
        && data.get('updatedBy', '') == request.auth.uid
        && data.get('listPrice', -1) is number
        && data.listPrice >= 0
        && data.keys().hasOnly([
          'productId', 'brandId', 'brandName', 'manufacturerPartNo',
          'normalizedPartNo', 'productName', 'nameEn', 'specification',
          'productLine', 'productLineId', 'category', 'productType', 'supplier',
          'listPrice', 'status', 'active', 'source', 'createdAt',
          'createdBy', 'updatedAt', 'updatedBy'
        ]);
    }



    function nonNegativeInventory(data) {
      return data.onHand is number && data.reserved is number
        && data.onHand >= 0 && data.reserved >= 0 && data.reserved <= data.onHand
        && data.get('incoming', 0) is number && data.get('incoming', 0) >= 0;
    }

    // A warehouse stock row keeps the same physical product/location identity.
    // Moving goods creates/updates another row through the transfer workflow.
    function validWarehouseStock(data) {
      return nonNegativeInventory(data)
        && data.get('productKey', '') is string && data.get('productKey', '').size() > 0
        && data.get('warehouseId', '') is string && data.get('warehouseId', '').size() > 0
        && data.get('productId', '') is string;
    }

    function warehouseStockIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['productKey', 'warehouseId'])
        && (resource.data.get('productId', '') == ''
          || request.resource.data.get('productId', '') == resource.data.get('productId', ''));
    }

    function inventoryArchiveKeys() {
      return ['listArchived', 'listArchiveChangedAt', 'listArchiveChangedByUid', 'listArchiveAuditId'];
    }

    function validInventoryArchiveChange(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(inventoryArchiveKeys()) || validInventoryArchiveOperation(id);
    }

    function validInventoryArchiveOperation(id) {
      let data = request.resource.data;
      let auditId = data.get('listArchiveAuditId', '');
      let auditPath = /databases/$(database)/documents/auditLogs/$(auditId);
      return admin()
        && data.listArchived is bool
        && data.listArchived != resource.data.get('listArchived', false)
        && data.listArchiveChangedByUid == request.auth.uid
        && data.listArchiveChangedAt is string && data.listArchiveChangedAt.size() <= 32
        && auditId is string && auditId.size() > 0 && auditId.size() <= 128
        && data.diff(resource.data).affectedKeys().hasOnly([
          'listArchived', 'listArchiveChangedAt', 'listArchiveChangedByUid', 'listArchiveAuditId', 'updatedAt'
        ])
        && (!data.listArchived || (resource.data.get('onHand', 0) == 0
          && resource.data.get('reserved', 0) == 0 && resource.data.get('incoming', 0) == 0
          && resource.data.get('transferInTransit', 0) == 0))
        && !exists(auditPath)
        && getAfter(auditPath).data.actorUid == request.auth.uid
        && getAfter(auditPath).data.inventoryId == id
        && getAfter(auditPath).data.archived == data.listArchived
        && getAfter(auditPath).data.createdAt == data.listArchiveChangedAt
        && getAfter(auditPath).data.action == (data.listArchived ? 'inventory_list_archive' : 'inventory_list_restore');
    }

    function validInventoryStockPolicy(data) {
      let policy = data.get('stockPolicy', 'ORDER_ONLY');
      let safetyStock = data.get('safetyStock', 0);
      return policy in ['NO_STOCK', 'SAFETY_STOCK', 'ORDER_ONLY']
        && safetyStock is number
        && safetyStock >= 0;
    }

    function warehouseInventoryPlanningDefaults(data) {
      return data.get('stockPolicy', 'ORDER_ONLY') == 'ORDER_ONLY'
        && data.get('safetyStock', 0) == 0;
    }

    function warehouseKeepsInventoryPlanning() {
      return warehouse()
        && request.resource.data.get('stockPolicy', 'ORDER_ONLY')
          == resource.data.get('stockPolicy', 'ORDER_ONLY')
        && request.resource.data.get('safetyStock', 0)
          == resource.data.get('safetyStock', 0);
    }

    // Client-side delivery/reservation transactions need narrowly-scoped stock writes.
    // Business owners cannot alter product identity, cost, incoming quantities or master data.
    // A commercial stock write must carry a fresh witness linked to its own order,
    // the reservation changed in this transaction, and an immutable stock movement.
    function reservationDelta(op, index) {
      return index < op.reservationIds.size() ? reservationDeltaAt(op, op.reservationIds[index]) : 0;
    }
    function reservationDeltaAt(op, id) {
      let path = /databases/$(database)/documents/inventoryReservations/$(id);
      let before = exists(path) ? get(path).data : {};
      let after = getAfter(path).data;
      return after.get('orderId', '') == op.orderId
        && after.get('productKey', '') == op.productKey
        && (op.warehouseId == '' || after.get('warehouseId', '') == op.warehouseId)
        ? after.get('quantity', 0) - before.get('quantity', 0) : 999999999;
    }
    function validStockOperation(op) {
      let orderPath = /databases/$(database)/documents/orders/$(op.orderId);
      let before = get(orderPath).data;
      let after = getAfter(orderPath).data;
      let deliveryDelta = after.get('returnedQty', 0) - before.get('returnedQty', 0)
        - after.get('deliveredQty', 0) + before.get('deliveredQty', 0);
      let movement = getAfter(/databases/$(database)/documents/inventoryMovements/$(op.sourceMovementId)).data;
      let firstDelta = reservationDelta(op, 0);
      return businessOwner() && op.actorUid == request.auth.uid && owns(before)
        && before.get('ownerUid', '') == after.get('ownerUid', '') && before.get('salesCode', '') == after.get('salesCode', '')
        && op.reservationIds is list && op.reservationIds.size() > 0 && op.reservationIds.size() <= 5
        && op.reservationIds.toSet().size() == op.reservationIds.size()
        && firstDelta != 999999999
        && movement.get('sourceId', '') == op.orderId && movement.get('sourceType', '') == 'order'
        && movement.get('productKey', '') == op.productKey
        && !exists(/databases/$(database)/documents/inventoryMovements/$(op.sourceMovementId))
        && op.qtyDelta is number && op.reservedDelta is number
        && (op.targetPath.matches('inventoryLots/.*')
          ? ((op.qtyDelta > 0 && deliveryDelta >= op.qtyDelta)
            || (op.qtyDelta < 0 && deliveryDelta <= op.qtyDelta)) && op.reservedDelta == 0
          : op.qtyDelta == deliveryDelta
            && op.reservedDelta == firstDelta + reservationDelta(op, 1)
              + reservationDelta(op, 2) + reservationDelta(op, 3) + reservationDelta(op, 4));
    }
    function hasStockOperation(targetPath, quantityField, reservedField) {
      let operationId = request.resource.data.get('stockOperationId', '');
      let path = /databases/$(database)/documents/stockOperations/$(operationId);
      let op = getAfter(path).data;
      return operationId != '' && !exists(path)
        && op.actorUid == request.auth.uid && op.targetPath == targetPath
        && op.productKey == resource.data.get('productKey', resource.data.get('productId', ''))
        && op.warehouseId == (targetPath.matches('inventory/.*') ? '' : resource.data.get('warehouseId', ''))
        && op.qtyDelta == request.resource.data.get(quantityField, 0) - resource.data.get(quantityField, 0)
        && (reservedField == '' || op.reservedDelta == request.resource.data.get(reservedField, 0) - resource.data.get(reservedField, 0));
      // The fresh immutable stockOperations document is independently validated on create.
      // Do not repeat its full source/reservation proof for every target in the same transaction.
    }

    function businessInventoryOperationalUpdate(id) {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'onHand', 'reserved', 'updatedAt', 'stockOperationId'
        ])
        && nonNegativeInventory(request.resource.data)
        && hasStockOperation('inventory/' + id, 'onHand', 'reserved');
    }

    function validBusinessReservation(id, data) {
      let order = getAfter(/databases/$(database)/documents/orders/$(data.orderId)).data;
      // Both call sites already require a business role and validReservationSource.
      // That shared source validator proves identity, owner, bounds and cancellation once.
      return owns(order) && businessReservationStockProof(id, data);
    }
    function businessReservationStockProof(id, data) {
      let before = resource == null ? {} : resource.data;
      let operationId = data.get('stockOperationId', 'unused');
      let path = /databases/$(database)/documents/stockOperations/$(operationId);
      let op = getAfter(path).data;
      let stockPath = /databases/$(database)/documents/warehouseStocks/$(data.get('warehouseStockId', 'unused'));
      return (before.get('quantity', 0) == data.get('quantity', 0)
          && before.get('warehouseId', data.get('warehouseId', '')) == data.get('warehouseId', ''))
        || (operationId != '' && operationId != 'unused' && !exists(path) && op.actorUid == request.auth.uid
          && op.orderId == data.orderId && id in op.reservationIds
          && op.productKey == data.productKey && op.warehouseId == data.warehouseId
          && op.targetPath == 'warehouseStocks/' + data.warehouseStockId
          && getAfter(stockPath).data.stockOperationId == operationId
          && getAfter(stockPath).data.reserved - get(stockPath).data.reserved == op.reservedDelta);
    }

    function businessReservationOperationalUpdate() {
      return businessOwner()
        && owns(resource.data)
        && owns(request.resource.data)
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && request.resource.data.get('salesCode', '') == resource.data.get('salesCode', '')
        && request.resource.data.get('orderId', '') == resource.data.get('orderId', '')
        && request.resource.data.get('itemId', '') == resource.data.get('itemId', '')
        && request.resource.data.get('productKey', '') == resource.data.get('productKey', '')
        && request.resource.data.get('warehouseId', '') == resource.data.get('warehouseId', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity', 'shortageQty', 'status', 'updatedAt', 'orderItemIndex', 'stockOperationId', 'warehouseStockId'
        ])
        && request.resource.data.get('quantity', 0) >= 0
        && request.resource.data.get('shortageQty', 0) >= 0;
    }

    function businessInventoryLotOperationalUpdate(id) {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'remainingQty', 'updatedAt', 'stockOperationId'
        ])
        && request.resource.data.remainingQty >= 0
        && hasStockOperation('inventoryLots/' + id, 'remainingQty', '');
    }

    function businessWarehouseStockOperationalUpdate(id) {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'onHand', 'reserved', 'updatedAt', 'stockOperationId'
        ])
        && nonNegativeInventory(request.resource.data)
        && hasStockOperation('warehouseStocks/' + id, 'onHand', 'reserved');
    }

    function businessProcurementDemandCreate(data) {
      return businessOwner()
        && owns(data)
        && data.get('sourceType', '') == 'SALES_ORDER'
        && data.get('sourceId', '') != ''
        && data.get('sourceItemId', '') != ''
        && data.get('demandId', '') != ''
        && data.get('requestedQty', 0) is number
        && data.get('orderedQty', 0) is number
        && data.get('receivedQty', 0) is number
        && data.get('requestedQty', 0) >= 0
        && data.get('orderedQty', 0) >= 0
        && data.get('orderedQty', 0) <= data.get('requestedQty', 0)
        && data.get('receivedQty', 0) == 0;
    }

    function validDemandSource(data) {
      let order = getAfter(/databases/$(database)/documents/orders/$(data.sourceId)).data;
      let index = data.get('sourceItemIndex', -1);
      return index is int && index >= 0 && index < order.items.size()
        && data.sourceItemId == order.items[index].get('itemId', 'item-' + string(index + 1))
        && data.get('ownerUid', '') == order.get('ownerUid', '')
        && data.get('salesCode', '') == order.get('salesCode', '')
        && data.get('productKey', '') == order.items[index].get('productId', order.items[index].get('inventoryProductKey', ''));
    }

    function validProcurementDemand(data) {
      return data.get('sourceId', '') is string && data.get('sourceId', '').size() > 0
        && data.get('requestedQty', null) is number && data.requestedQty >= 0
        && data.get('orderedQty', null) is number && data.orderedQty >= 0 && data.orderedQty <= data.requestedQty
        && data.get('receivedQty', null) is number && data.receivedQty >= 0 && data.receivedQty <= data.orderedQty
        && data.get('remainingToOrderQty', null) is number
        && data.remainingToOrderQty == (data.get('status', '') == 'CANCELLED' ? 0 : data.requestedQty - data.orderedQty)
        && data.get('remainingToReceiveQty', null) is number && data.remainingToReceiveQty == data.orderedQty - data.receivedQty
        && data.get('status', '') == (data.get('status', '') == 'CANCELLED' ? 'CANCELLED'
          : data.requestedQty > 0 && data.receivedQty >= data.requestedQty ? 'RECEIVED'
          : data.receivedQty > 0 ? 'PARTIALLY_RECEIVED'
          : data.requestedQty > 0 && data.orderedQty >= data.requestedQty ? 'ORDERED'
          : data.orderedQty > 0 ? 'PARTIALLY_ORDERED' : 'PENDING')
        && ((data.get('sourceType', '') == 'SALES_ORDER'
          && data.get('sourceItemId', '') is string && data.get('sourceItemId', '').size() > 0
          && data.get('demandId', '') == 'SALES_ORDER:' + data.sourceId + ':' + data.sourceItemId
          && validDemandSource(data))
          || (data.get('sourceType', '') == 'STOCK_REPLENISHMENT'
            && data.get('sourceItemId', '') == '' && data.get('demandId', '') == 'STOCK_REPLENISHMENT:' + data.sourceId));
    }

    function demandIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'demandId','sourceType','sourceId','sourceItemId','productKey','productId','ownerUid','salesCode'
      ]) && (resource.data.get('sourceItemIndex', -1) == -1
        || request.resource.data.get('sourceItemIndex', -1) == resource.data.get('sourceItemIndex', -1));
    }

    function validReservationSource(id, data) {
      let order = getAfter(/databases/$(database)/documents/orders/$(data.orderId)).data;
      let index = data.get('orderItemIndex', -1);
      let item = order.items[index];
      return index is int && index >= 0 && index < order.items.size()
        && (role() != 'warehouse' || !(order.get('inventoryReservationStatus', '') in ['pending', 'failed']))
        && id == data.orderId + '__' + data.itemId
        && data.itemId == item.get('itemId', 'item-' + string(index + 1))
        && data.productKey == item.get('productId', item.get('inventoryProductKey', ''))
        && data.get('ownerUid', '') == order.get('ownerUid', '')
        && data.get('salesCode', '') == order.get('salesCode', '')
        && data.get('quantity', null) is number && data.quantity >= 0 && data.quantity <= item.get('qty', 0)
        && data.get('shortageQty', 0) is number && data.get('shortageQty', 0) >= 0
        && data.get('warehouseId', '') == item.get('warehouseId', order.get('warehouseId', ''))
        && (!orderIsCancelled(order) || data.quantity == 0);
    }

    function reservationIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orderId','itemId','productKey']);
    }

    // Reserved totals include every reservation of this product changed by the
    // operation, including a move between warehouses. Unchanged siblings add zero.
    function operationalReservationDelta(e, index, productKey, warehouseId) {
      return index < e.reservationIds.size()
        ? operationalReservationDeltaAt(e.reservationIds[index], productKey, warehouseId) : 0;
    }
    function operationalReservationDeltaAt(id, productKey, warehouseId) {
      let path = /databases/$(database)/documents/inventoryReservations/$(id);
      let before = exists(path) ? get(path).data : {};
      let after = getAfter(path).data;
      return after.productKey == productKey
        && (before.get('productKey', productKey) == productKey)
        ? (warehouseId == '' || after.get('warehouseId', '') == warehouseId ? after.get('quantity', 0) : 0)
          - (warehouseId == '' || before.get('warehouseId', '') == warehouseId ? before.get('quantity', 0) : 0)
        : 999999999;
    }
    function operationalStockDelta(e, productKey, warehouseId) {
      return operationalReservationDelta(e, 0, productKey, warehouseId)
        + operationalReservationDelta(e, 1, productKey, warehouseId)
        + operationalReservationDelta(e, 2, productKey, warehouseId)
        + operationalReservationDelta(e, 3, productKey, warehouseId)
        + operationalReservationDelta(e, 4, productKey, warehouseId);
    }
    function operationalReservedStockMatches(path, e, productKey, warehouseId) {
      let before = exists(path) ? get(path).data : {};
      let after = getAfter(path).data;
      return after.get('productKey', after.get('productId', '')) == productKey
        && (warehouseId == '' || after.get('warehouseId', '') == warehouseId)
        && after.get('reserved', 0) - before.get('reserved', 0) == operationalStockDelta(e, productKey, warehouseId);
    }
    function sameWarehouseReservationDelta(e, index, productKey, warehouseId) {
      return index < e.reservationIds.size()
        ? sameWarehouseReservationDeltaAt(e.reservationIds[index], productKey, warehouseId) : 0;
    }
    function sameWarehouseReservationDeltaAt(id, productKey, warehouseId) {
      let path = /databases/$(database)/documents/inventoryReservations/$(id);
      let before = exists(path) ? get(path).data : {};
      let after = getAfter(path).data;
      return after.get('quantity', 0) == 0 && before.get('quantity', 0) == 0 ? 0
        : after.productKey == productKey && after.warehouseId == warehouseId
          && (before.get('quantity', 0) == 0 || before.get('warehouseId', warehouseId) == warehouseId)
          ? after.quantity - before.get('quantity', 0) : 999999999;
    }
    function sameWarehouseReservationStocks(e, productKey, warehouseId) {
      let delta = sameWarehouseReservationDelta(e, 0, productKey, warehouseId)
        + sameWarehouseReservationDelta(e, 1, productKey, warehouseId)
        + sameWarehouseReservationDelta(e, 2, productKey, warehouseId)
        + sameWarehouseReservationDelta(e, 3, productKey, warehouseId)
        + sameWarehouseReservationDelta(e, 4, productKey, warehouseId);
      let invPath = /databases/$(database)/documents/inventory/$(e.inventoryId);
      let whPath = /databases/$(database)/documents/warehouseStocks/$(e.warehouseStockId);
      let beforeInv = exists(invPath) ? get(invPath).data : {};
      let beforeWh = exists(whPath) ? get(whPath).data : {};
      let afterInv = getAfter(invPath).data;
      let afterWh = getAfter(whPath).data;
      return afterInv.get('productKey', afterInv.get('productId', '')) == productKey
        && afterWh.productKey == productKey && afterWh.warehouseId == warehouseId
        && afterInv.reserved - beforeInv.get('reserved', 0) == delta
        && afterWh.reserved - beforeWh.get('reserved', 0) == delta;
    }
    function operationalReservationStockEvidence(id) {
      let data = request.resource.data;
      let before = resource == null ? {} : resource.data;
      let e = data.get('stockEvidence', {});
      return (data.get('quantity', 0) == before.get('quantity', 0)
          && data.get('warehouseId', '') == before.get('warehouseId', ''))
        || (data.get('quantity', 0) == 0 && before.get('quantity', 0) == 0)
        || (e.get('movementId', '') != '' && id in e.get('reservationIds', [])
          && e == getAfter(/databases/$(database)/documents/inventoryMovements/$(e.movementId)).data.get('reservationStockEvidence', {})
          && operationalReservationMovement(e.movementId, data, before));
    }
    // Validate the group once on its immutable movement rather than repeating
    // the five-reservation sums on every reservation in the batch.
    function validOperationalMovementEvidence(id) {
      let e = request.resource.data.reservationStockEvidence;
      let path = /databases/$(database)/documents/inventoryReservations/$(e.reservationIds[0]);
      let data = getAfter(path).data;
      let before = exists(path) ? get(path).data : {};
      return e.keys().hasAll(['inventoryId','warehouseStockId','previousWarehouseStockId','reservationIds','movementId'])
        && e.movementId == id && e.inventoryId is string && e.inventoryId.size() > 0
        && e.warehouseStockId is string && e.warehouseStockId.size() > 0
        && e.previousWarehouseStockId is string && e.previousWarehouseStockId.size() > 0
        && e.reservationIds is list && e.reservationIds.size() > 0 && e.reservationIds.size() <= 5
        && e.reservationIds.toSet().size() == e.reservationIds.size()
        && request.resource.data.productKey == data.productKey
        && (before.get('quantity', 0) == 0 || before.get('warehouseId', data.warehouseId) == data.warehouseId
          ? sameWarehouseReservationStocks(e, data.productKey, data.warehouseId)
          : operationalReservedStockMatches(/databases/$(database)/documents/inventory/$(e.inventoryId), e, data.productKey, '')
            && operationalReservedStockMatches(/databases/$(database)/documents/warehouseStocks/$(e.warehouseStockId), e, data.productKey, data.warehouseId)
            && ((request.resource.data.get('sourceType', '') == 'WAREHOUSE_TRANSFER' && operationalTransferReservationArrival(e, data, before))
              || operationalReservedStockMatches(/databases/$(database)/documents/warehouseStocks/$(e.previousWarehouseStockId), e, data.productKey, before.warehouseId)));
    }
    function operationalTransferReservationArrival(e, data, before) {
      let movement = request.resource.data;
      let path = /databases/$(database)/documents/stockTransfers/$(movement.get('sourceId', 'unused'));
      let oldTransfer = get(path).data;
      let transfer = getAfter(path).data;
      let stockPath = /databases/$(database)/documents/warehouseStocks/$(e.previousWarehouseStockId);
      return movement.get('sourceType', '') == 'WAREHOUSE_TRANSFER'
        && e.reservationIds.size() == 1 && exists(path) && oldTransfer.status == 'IN_TRANSIT'
        && transfer.status == 'RECEIVED' && transfer.receivedByUid == request.auth.uid
        && transfer.orderId == data.orderId && transfer.itemId == data.itemId
        && transfer.productKey == data.productKey && transfer.reservedQty == data.quantity
        && before.quantity == data.quantity && transfer.fromWarehouseId == before.warehouseId
        && transfer.toWarehouseId == data.warehouseId && transfer.fromStockId == e.previousWarehouseStockId
        && transfer.toStockId == e.warehouseStockId && transfer.inventoryId == e.inventoryId
        && getAfter(stockPath).data.reserved == get(stockPath).data.reserved;
    }
    function operationalReservationMovement(id, data, before) {
      let path = /databases/$(database)/documents/inventoryMovements/$(id);
      let movement = getAfter(path).data;
      return id is string && id.size() > 0 && !exists(path)
        && movement.productKey == data.productKey
        && movement.get('warehouseId', '') in [data.warehouseId, before.get('warehouseId', data.warehouseId)]
        && (movement.get('sourceId', '') == data.orderId
          || (movement.get('sourceType', '') == 'SUPPLY_ORDER'
            && getAfter(/databases/$(database)/documents/supplyOrders/$(movement.sourceId)).data.get('orderId', '') == data.orderId)
          || (movement.get('sourceType', '') == 'WAREHOUSE_TRANSFER'
            && getAfter(/databases/$(database)/documents/stockTransfers/$(movement.sourceId)).data.get('orderId', '') == data.orderId));
    }

    function validInventoryLot(data) {
      return data.get('productKey', '') is string && data.get('productKey', '').size() > 0
        && data.get('warehouseId', '') is string && data.get('warehouseId', '').size() > 0
        && data.get('remainingQty', null) is number && data.remainingQty >= 0
        && data.get('receivedQty', 0) is number && data.get('receivedQty', 0) >= 0
        && data.get('qty', 0) is number && data.get('qty', 0) >= 0
        && !data.keys().hasAny(['unitCost','cost','costPrice']);
    }
    function inventoryLotIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'productKey','productId','warehouseId','sourceType','sourceId','transferId','costLotId','receivedAt'
      ]);
    }
    function reservationCreateWriter(id) {
      let userRole = role();
      return userRole == 'admin'
        || (userRole in ['purchaser','warehouse'] && operationalReservationStockEvidence(id))
        || (userRole in ['sales','engineer'] && validBusinessReservation(id, request.resource.data));
    }
    function reservationUpdateWriter(id) {
      let userRole = role();
      return userRole == 'admin'
        || (userRole in ['purchaser','warehouse'] && operationalReservationStockEvidence(id))
        || (userRole in ['sales','engineer'] && businessReservationOperationalUpdate()
          && validBusinessReservation(id, request.resource.data));
    }
    function inventoryMovementWriter(id) {
      let userRole = role();
      return userRole in ['admin','purchaser','warehouse','sales','engineer']
        && (userRole in ['admin','purchaser','warehouse'] || owns(request.resource.data))
        && (!('reservationStockEvidence' in request.resource.data)
          || (userRole in ['admin','purchaser','warehouse'] && validOperationalMovementEvidence(id)));
    }

    function businessProcurementDemandOperationalUpdate() {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'orderedQty', 'remainingToOrderQty', 'remainingToReceiveQty',
          'perOrdered', 'perReceived', 'status', 'scheduleDate', 'updatedAt', 'sourceItemIndex'
        ])
        && owns(resource.data)
        && owns(request.resource.data)
        && request.resource.data.get('demandId', '') == resource.data.get('demandId', '')
        && request.resource.data.get('sourceType', '') == resource.data.get('sourceType', '')
        && request.resource.data.get('sourceId', '') == resource.data.get('sourceId', '')
        && request.resource.data.get('sourceItemId', '') == resource.data.get('sourceItemId', '')
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && request.resource.data.get('salesCode', '') == resource.data.get('salesCode', '')
        && request.resource.data.get('receivedQty', 0) == resource.data.get('receivedQty', 0)
        && request.resource.data.get('orderedQty', 0) >= resource.data.get('orderedQty', 0)
        && request.resource.data.get('orderedQty', 0) <= request.resource.data.get('requestedQty', 0);
    }

    function businessReservationDemandUpdate() {
      let d = request.resource.data;
      let orderPath = /databases/$(database)/documents/orders/$(d.sourceId);
      let before = get(orderPath).data;
      let after = getAfter(orderPath).data;
      let index = d.sourceItemIndex;
      let oldItem = before.items[index];
      let item = after.items[index];
      let held = getAfter(/databases/$(database)/documents/inventoryReservations/$(d.sourceId + '__' + d.sourceItemId)).data;
      let delivered = item.get('deliveredQty', 0) - item.get('returnedQty', 0);
      let shortage = item.qty - (delivered > 0 ? delivered : 0) - held.quantity;
      return businessOwner() && before.get('ownerUid', '') == request.auth.uid && after.get('ownerUid', '') == request.auth.uid
        && before.get('inventoryReservationStatus', '') in ['pending', 'failed']
        && after.get('inventoryReservationStatus', '') in ['pending', 'failed'] && !orderIsCancelled(after)
        && d.fulfillmentType == 'WAREHOUSE' && d.orderedQty == resource.data.orderedQty && d.receivedQty == resource.data.receivedQty
        && d.orderedQty == item.get('supplyOrderedQty', 0) && d.receivedQty == item.get('receivedQty', 0)
        && item.get('qty', 0) == oldItem.get('qty', 0) && item.get('deliveredQty', 0) == oldItem.get('deliveredQty', 0)
        && item.get('returnedQty', 0) == oldItem.get('returnedQty', 0)
        && item.get('supplyOrderedQty', 0) == oldItem.get('supplyOrderedQty', 0) && item.get('receivedQty', 0) == oldItem.get('receivedQty', 0)
        && held.orderId == d.sourceId && held.itemId == d.sourceItemId && held.productKey == d.productKey
        && held.warehouseId == item.warehouseId && held.quantity == item.reservedQty
        && item.shortageQty == (shortage > 0 ? shortage : 0)
        && d.requestedQty == (d.orderedQty > d.receivedQty + item.shortageQty ? d.orderedQty : d.receivedQty + item.shortageQty)
        && d.diff(resource.data).affectedKeys().hasOnly(['requestedQty','remainingToOrderQty','remainingToReceiveQty','perOrdered','perReceived','status','updatedAt','sourceItemIndex']);
    }

    function businessDirectDemandReceiptUpdate() {
      let orderPath = /databases/$(database)/documents/orders/$(resource.data.sourceId);
      let before = get(orderPath).data;
      let after = getAfter(orderPath).data;
      let records = after.get('deliveryRecords', []);
      let record = records[before.get('deliveryRecords', []).size()];
      return role() in ['sales', 'engineer'] && resource.data.get('ownerUid', '') == request.auth.uid
        && resource.data.get('sourceType', '') == 'SALES_ORDER'
        && resource.data.get('fulfillmentType', '') == 'DIRECT_SHIP'
        && after.ownerUid == request.auth.uid && !orderIsCancelled(before)
        && records.size() == before.get('deliveryRecords', []).size() + 1
        && record.sourceType == 'DIRECT_SHIP_RECEIPT' && record.itemId == resource.data.sourceItemId
        && request.resource.data.requestedQty == resource.data.requestedQty
        && request.resource.data.orderedQty == resource.data.orderedQty
        && request.resource.data.receivedQty == resource.data.receivedQty + record.qty
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receivedQty', 'remainingToReceiveQty', 'perReceived', 'status', 'updatedAt', 'sourceItemIndex'
        ]);
    }

    function validDirectShipReceipt(id, data) {
      let supplyPath = /databases/$(database)/documents/supplyOrders/$(data.supplyOrderId);
      let before = get(supplyPath).data;
      let after = getAfter(supplyPath).data;
      let orderPath = /databases/$(database)/documents/orders/$(before.orderId);
      let orderBefore = get(orderPath).data;
      let orderAfter = getAfter(orderPath).data;
      let records = orderAfter.get('deliveryRecords', []);
      let record = records[orderBefore.get('deliveryRecords', []).size()];
      let userRole = role();
      return (userRole == 'admin' || (userRole in ['sales', 'engineer'] && before.ownerUid == request.auth.uid && orderBefore.ownerUid == request.auth.uid))
        && data.operationId == id && data.receiptId == id && id.size() <= 128
        && data.fulfillmentType == 'DIRECT_SHIP' && before.fulfillmentType == 'DIRECT_SHIP'
        && data.warehouseId == '' && !orderIsCancelled(orderBefore)
        && data.orderId == before.orderId && data.itemId == before.itemId
        && data.ownerUid == before.ownerUid && data.productId == before.get('productId', '')
        && data.qty is number && data.qty > 0 && data.qty <= before.qty - before.get('receivedQty', 0)
        && after.receivedQty == before.get('receivedQty', 0) + data.qty
        && data.cumulativeReceivedQty == after.receivedQty
        && records.size() == orderBefore.get('deliveryRecords', []).size() + 1
        && record.sourceType == 'DIRECT_SHIP_RECEIPT' && record.sourceId == data.supplyOrderId
        && record.receiptId == id && record.qty == data.qty;
    }

    match /users/{id} {
      allow read: if signedIn() && (id == request.auth.uid || active());
      allow create: if admin();
      // A signed-in member may sync only their own token email, never role,
      // ownership code, activation or delivery preferences.
      allow update: if admin() || (active() && id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
        && request.resource.data.get('email', '') is string
        && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 320
        && request.resource.data.email == request.auth.token.get('email', ''));
      allow delete: if false;
    }

    match /settings/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /brands/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /productLines/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /salesCodes/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /customers/{id} {
      allow read: if active();
      allow create, update: if admin() || businessOwner() || businessAssistant();
      allow delete: if false;
    }

    match /suppliers/{id} {
      allow read: if active();
      allow create, update: if canPurchase();
      allow delete: if false;
    }

    match /brandSupplierMappings/{id} {
      allow read: if active();
      allow create, update: if canPurchase();
      allow delete: if false;
    }

    match /warehouses/{id} {
      allow read: if active();
      allow create: if admin() || (canReceiveInventory() && request.resource.data.get('systemCustody', false) == true
        && id == 'custody-' + request.resource.data.ownerUid && request.resource.data.warehouseType == 'CUSTODY'
        && request.resource.data.isDefault == false && request.resource.data.active == true
        && request.resource.data.keys().hasOnly(['warehouseName','active','isDefault','warehouseType','systemCustody','ownerUid','sourceTransferId'])
        && getAfter(/databases/$(database)/documents/stockTransfers/$(request.resource.data.sourceTransferId)).data.kind == 'HANDOFF'
        && getAfter(/databases/$(database)/documents/stockTransfers/$(request.resource.data.sourceTransferId)).data.toWarehouseId == id);
      allow update: if admin();
      allow delete: if false;
    }

    // Searchable product master. Cost is intentionally stored separately.
    match /products/{id} {
      allow read: if active();
      allow create: if admin() || purchaser() || businessTemporaryProduct(id, request.resource.data);
      allow update: if admin() || purchaser();
      allow delete: if admin();
    }

    // 公司標準產品成本只提供採購／管理員；業務自行調貨成本存在自己的訂單交易中。
    match /productCosts/{id} {
      allow read: if admin() || purchaser();
      allow create, update: if admin() || purchaser();
      allow delete: if admin();
    }

    match /priceHistory/{id} {
      allow read, create: if admin() || purchaser();
      allow update, delete: if false;
    }

    match /quotes/{id} {
      allow get: if admin() || purchaser() || (commercialDocumentOwner() && resource == null) || owns(resource.data)
        || engineerAssistedSalesQuote(resource.data);
      allow list: if admin() || purchaser() || owns(resource.data)
        || engineerAssistedSalesQuote(resource.data);
      allow create: if canCreateCommercialDoc() && (
        validOwnedCommercialCreate(request.resource.data)
        || (engineerAssistedSalesQuote(request.resource.data) && validSalesOwner(request.resource.data))
        || (purchaser() && validQuoteOwner(request.resource.data)
          && request.resource.data.ownerUid != request.auth.uid)
      );
      allow update: if admin()
        || (commercialDocumentOwner() && owns(resource.data) && owns(request.resource.data) && sameCommercialOwner() && preservesCreator())
        || (engineerAssistedSalesQuote(resource.data) && sameCommercialOwner() && preservesCreator())
        || (purchaser() && sameCommercialOwner() && preservesCreator()
          && (resource.data.get('dealClosed', false) != true
            || request.resource.data.get('dealClosed', false) == true));
      allow delete: if admin();
    }

    match /forecasts/{id} {
      allow read: if admin() || (sales() && owns(resource.data));
      allow create: if (admin() || sales()) && validOwnedCommercialCreate(request.resource.data);
      allow update: if admin()
        || (sales() && owns(resource.data) && owns(request.resource.data) && sameCommercialOwner() && preservesCreator());
      allow delete: if admin();
    }

    match /forecasts/{forecastId}/progress/{progressId} {
      function parentForecast() {
        return get(/databases/$(database)/documents/forecasts/$(forecastId));
      }
      allow read: if admin() || (sales() && owns(parentForecast().data));
      allow create: if admin() || (sales() && owns(parentForecast().data));
      allow update: if false;
      allow delete: if admin();
    }

    function validNewOrderProductMaster(data) {
      let productId = data.get('productId', '');
      return data.get('productMasterMatched', false) == true
        && data.get('items', []) is list && data.get('items', []).size() <= 30
        && productId != ''
        && exists(productPath(productId));
    }

    function validNewItemCost(item, method) {
      return !item.keys().hasAny(['unitCost', 'cost'])
        && (!('costPrice' in item) || (item.get('procurementType', method) == 'SALES_SELF_ORDER'
          && item.costPrice is number && item.costPrice >= 0));
    }
    function validOrderEmbeddedCost(data) {
      let items = data.get('items', []);
      return items is list && items.size() <= 30
        && validNewItemCost(data, 'PURCHASING_PO')
        && (items.size() <= 0 || validNewItemCost(items[0], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 1 || validNewItemCost(items[1], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 2 || validNewItemCost(items[2], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 3 || validNewItemCost(items[3], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 4 || validNewItemCost(items[4], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 5 || validNewItemCost(items[5], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 6 || validNewItemCost(items[6], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 7 || validNewItemCost(items[7], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 8 || validNewItemCost(items[8], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 9 || validNewItemCost(items[9], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 10 || validNewItemCost(items[10], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 11 || validNewItemCost(items[11], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 12 || validNewItemCost(items[12], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 13 || validNewItemCost(items[13], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 14 || validNewItemCost(items[14], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 15 || validNewItemCost(items[15], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 16 || validNewItemCost(items[16], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 17 || validNewItemCost(items[17], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 18 || validNewItemCost(items[18], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 19 || validNewItemCost(items[19], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 20 || validNewItemCost(items[20], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 21 || validNewItemCost(items[21], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 22 || validNewItemCost(items[22], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 23 || validNewItemCost(items[23], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 24 || validNewItemCost(items[24], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 25 || validNewItemCost(items[25], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 26 || validNewItemCost(items[26], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 27 || validNewItemCost(items[27], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 28 || validNewItemCost(items[28], data.get('procurementType', 'PURCHASING_PO')))
        && (items.size() <= 29 || validNewItemCost(items[29], data.get('procurementType', 'PURCHASING_PO')));
    }
    function commercialItemCostProtected(before, after, method) {
      return before == after || (before.get('procurementType', method) == after.get('procurementType', method)
        && (!after.diff(before).affectedKeys().hasAny(['costPrice','costSource','unitCost','cost'])
          || (before.get('procurementType', method) == 'SALES_SELF_ORDER'
            && !after.diff(before).affectedKeys().hasAny(['unitCost','cost'])
            && after.get('costPrice', null) is number && after.costPrice >= 0)));
    }
    function validCommercialOrderCostUpdate() {
      let before = resource.data.get('items', []);
      let after = request.resource.data.get('items', []);
      return request.resource.data.get('procurementType', 'PURCHASING_PO') == resource.data.get('procurementType', 'PURCHASING_PO')
        && commercialItemCostProtected(resource.data, request.resource.data, 'PURCHASING_PO')
        && (before == after || (before is list && after is list && before.size() == after.size() && before.size() <= 30
        && (before.size() <= 0 || commercialItemCostProtected(before[0], after[0], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 1 || commercialItemCostProtected(before[1], after[1], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 2 || commercialItemCostProtected(before[2], after[2], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 3 || commercialItemCostProtected(before[3], after[3], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 4 || commercialItemCostProtected(before[4], after[4], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 5 || commercialItemCostProtected(before[5], after[5], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 6 || commercialItemCostProtected(before[6], after[6], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 7 || commercialItemCostProtected(before[7], after[7], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 8 || commercialItemCostProtected(before[8], after[8], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 9 || commercialItemCostProtected(before[9], after[9], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 10 || commercialItemCostProtected(before[10], after[10], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 11 || commercialItemCostProtected(before[11], after[11], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 12 || commercialItemCostProtected(before[12], after[12], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 13 || commercialItemCostProtected(before[13], after[13], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 14 || commercialItemCostProtected(before[14], after[14], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 15 || commercialItemCostProtected(before[15], after[15], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 16 || commercialItemCostProtected(before[16], after[16], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 17 || commercialItemCostProtected(before[17], after[17], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 18 || commercialItemCostProtected(before[18], after[18], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 19 || commercialItemCostProtected(before[19], after[19], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 20 || commercialItemCostProtected(before[20], after[20], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 21 || commercialItemCostProtected(before[21], after[21], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 22 || commercialItemCostProtected(before[22], after[22], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 23 || commercialItemCostProtected(before[23], after[23], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 24 || commercialItemCostProtected(before[24], after[24], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 25 || commercialItemCostProtected(before[25], after[25], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 26 || commercialItemCostProtected(before[26], after[26], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 27 || commercialItemCostProtected(before[27], after[27], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 28 || commercialItemCostProtected(before[28], after[28], resource.data.get('procurementType', 'PURCHASING_PO')))
        && (before.size() <= 29 || commercialItemCostProtected(before[29], after[29], resource.data.get('procurementType', 'PURCHASING_PO')))));
    }

    function supplierCancellationResolution() {
      let before = resource.data;
      let after = request.resource.data;
      let order = get(/databases/$(database)/documents/orders/$(before.orderId)).data;
      let remaining = before.qty - before.get('receivedQty', 0);
      let redirect = before.get('fulfillmentType', 'WAREHOUSE') == 'DIRECT_SHIP';
      let invPath = /databases/$(database)/documents/inventory/$(after.get('redirectInventoryId', 'unused'));
      let whId = after.get('redirectWarehouseStockId', 'unused');
      let whPath = /databases/$(database)/documents/warehouseStocks/$(whId);
      return purchaser() && orderIsCancelled(order)
        && before.get('status', '') in ['ORDERED', 'PARTIAL_RECEIPT'] && remaining > 0
        && before.get('customerCancellationDisposition', '') != 'KEEP_STOCK'
        && after.customerCancellationDisposition == 'KEEP_STOCK'
        && after.customerCancellationResolvedBy == request.auth.uid
        && after.customerCancellationResolvedAt != ''
        && after.diff(before).affectedKeys().hasOnly([
          'customerCancellationDisposition', 'customerCancellationResolvedAt', 'customerCancellationResolvedBy',
          'originalFulfillmentType', 'fulfillmentType', 'warehouseId', 'redirectInventoryId', 'redirectWarehouseStockId', 'incomingRegisteredQty', 'updatedAt'
        ])
        && (redirect ? (
          after.originalFulfillmentType == 'DIRECT_SHIP' && after.fulfillmentType == 'WAREHOUSE'
          && after.warehouseId != '' && exists(/databases/$(database)/documents/warehouses/$(after.warehouseId))
          && after.incomingRegisteredQty == remaining
          && getAfter(invPath).data.productKey == before.productKey
          && getAfter(whPath).data.productKey == before.productKey && getAfter(whPath).data.warehouseId == after.warehouseId
          && getAfter(invPath).data.incoming == (exists(invPath) ? get(invPath).data.get('incoming', 0) : 0) + remaining
          && getAfter(whPath).data.incoming == (exists(whPath) ? get(whPath).data.get('incoming', 0) : 0) + remaining
        ) : after.get('fulfillmentType', 'WAREHOUSE') == before.get('fulfillmentType', 'WAREHOUSE')
          && after.get('warehouseId', '') == before.get('warehouseId', '')
          && after.get('incomingRegisteredQty', 0) == before.get('incomingRegisteredQty', 0));
    }

    function validReturnPendingFlag(requests, flag) {
      return requests.size() <= 30 && flag == !((requests.size() <= 0 || requests[0].status != 'PENDING') && (requests.size() <= 1 || requests[1].status != 'PENDING') && (requests.size() <= 2 || requests[2].status != 'PENDING') && (requests.size() <= 3 || requests[3].status != 'PENDING') && (requests.size() <= 4 || requests[4].status != 'PENDING') && (requests.size() <= 5 || requests[5].status != 'PENDING') && (requests.size() <= 6 || requests[6].status != 'PENDING') && (requests.size() <= 7 || requests[7].status != 'PENDING') && (requests.size() <= 8 || requests[8].status != 'PENDING') && (requests.size() <= 9 || requests[9].status != 'PENDING') && (requests.size() <= 10 || requests[10].status != 'PENDING') && (requests.size() <= 11 || requests[11].status != 'PENDING') && (requests.size() <= 12 || requests[12].status != 'PENDING') && (requests.size() <= 13 || requests[13].status != 'PENDING') && (requests.size() <= 14 || requests[14].status != 'PENDING') && (requests.size() <= 15 || requests[15].status != 'PENDING') && (requests.size() <= 16 || requests[16].status != 'PENDING') && (requests.size() <= 17 || requests[17].status != 'PENDING') && (requests.size() <= 18 || requests[18].status != 'PENDING') && (requests.size() <= 19 || requests[19].status != 'PENDING') && (requests.size() <= 20 || requests[20].status != 'PENDING') && (requests.size() <= 21 || requests[21].status != 'PENDING') && (requests.size() <= 22 || requests[22].status != 'PENDING') && (requests.size() <= 23 || requests[23].status != 'PENDING') && (requests.size() <= 24 || requests[24].status != 'PENDING') && (requests.size() <= 25 || requests[25].status != 'PENDING') && (requests.size() <= 26 || requests[26].status != 'PENDING') && (requests.size() <= 27 || requests[27].status != 'PENDING') && (requests.size() <= 28 || requests[28].status != 'PENDING') && (requests.size() <= 29 || requests[29].status != 'PENDING'));
    }

    function returnReceiptOrderUpdate(id) {
      let before = resource.data;
      let after = request.resource.data;
      let receiptId = after.get('returnReceiptId', '');
      let path = /databases/$(database)/documents/customerReturnReceipts/$(receiptId);
      let receipt = getAfter(path).data;
      let oldRequests = before.get('returnRequests', []);
      let newRequests = after.get('returnRequests', []);
      let index = receipt.requestIndex;
      let previous = oldRequests[index];
      let next = newRequests[index];
      return canReceiveInventory() && receiptId != '' && !exists(path)
        && receipt.orderId == id && receipt.receivedBy == request.auth.uid
        && previous.id == receipt.requestId && previous.status == 'PENDING'
        && next.diff(previous).affectedKeys().hasOnly(['receivedQty', 'status'])
        && next.receivedQty == previous.get('receivedQty', 0) + receipt.qty && next.receivedQty <= previous.qty
        && next.status == (next.receivedQty == next.qty ? 'RECEIVED' : 'PENDING')
        && validReturnPendingFlag(newRequests, after.returnPending)
        && newRequests.size() == oldRequests.size()
        && newRequests.removeAll([next]) == oldRequests.removeAll([previous])
        && after.get('returnRecords', []).size() == before.get('returnRecords', []).size() + 1
        && after.get('returnRecords', [])[after.get('returnRecords', []).size() - 1] == receipt.record
        && after.get('returnRecords', []).removeAll([receipt.record]) == before.get('returnRecords', [])
        && after.returnedQty == before.get('returnedQty', 0) + receipt.qty
        && after.returnedQty <= before.get('deliveredQty', 0)
        && after.diff(before).affectedKeys().hasOnly([
          'returnRequests', 'returnPending', 'returnRecords', 'returnedQty', 'returnReceiptId',
          'items', 'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ]) && operationalItemsOnly(['reservedQty']) && sameCommercialOwner();
    }

    function commercialReturnProtection() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['returnRecords', 'returnedQty', 'returnReceiptId'])
        && (!changed.hasAny(['returnRequests', 'returnPending']) || validCommercialReturnRequestMutation());
    }
    function validCommercialReturnRequestMutation() {
      let before = resource.data.get('returnRequests', []);
      let after = request.resource.data.get('returnRequests', []);
      let index = request.resource.data.returnRequestMutationIndex;
      let next = after[index];
      return after.size() <= 30 && validReturnPendingFlag(after, request.resource.data.returnPending) && (
        (after.size() == before.size() + 1 && index == before.size()
          && after.removeAll([next]) == before && next.status == 'PENDING'
          && next.receivedQty == 0 && next.qty is number && next.qty > 0
          && next.createdByUid == request.auth.uid && next.settlement == 'CLOSE')
        || (after.size() == before.size() && before[index].status == 'PENDING'
          && next.status == 'CANCELLED'
          && next.diff(before[index]).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy'])
          && next.cancelledBy == request.auth.uid
          && after.removeAll([next]) == before.removeAll([before[index]]))
      );
    }


    // 外倉送貨僅能由已通知的外倉通知單觸發，且必須與同一次
    // Firestore transaction 中的 notice SHIPPED 寫入互相對應。
    function externalWarehouseOrderShipmentUpdate(orderId) {
      let beforeRecords = resource.data.get('deliveryRecords', []);
      let afterRecords = request.resource.data.get('deliveryRecords', []);
      let record = afterRecords[beforeRecords.size()];
      let id = record.get('externalNoticeId', '');
      let noticePath = /databases/$(database)/documents/externalDispatchNotices/$(id);
      let notice = get(noticePath).data;
      let nextNotice = getAfter(noticePath).data;
      return (purchaser() || warehouse())
        && id != ''
        && beforeRecords.size() + 1 == afterRecords.size()
        && afterRecords.hasAll(beforeRecords)
        && !orderIsCancelled(resource.data)
        && sameCommercialOwner()
        && preservesCreator()
        && operationalItemsOnly(['dispatchPreparedQty', 'reservedQty'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'deliveryRecords', 'deliveredQty', 'isDelivered',
          'deliveryHistory', 'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ])
        && notice.get('status', '') == 'NOTIFIED'
        && nextNotice.get('status', '') == 'SHIPPED'
        && nextNotice.get('orderId', '') == orderId
        && nextNotice.get('itemId', '') == record.get('itemId', '')
        && nextNotice.get('warehouseId', '') == record.get('warehouseId', '')
        && nextNotice.get('deliveryRecordId', '') == record.get('id', '')
        && nextNotice.get('movementId', '') == record.get('movementId', '')
        && nextNotice.get('shippedByUid', '') == request.auth.uid
        && record.get('sourceType', '') == 'EXTERNAL_WAREHOUSE_SHIP'
        && record.get('createdByUid', '') == request.auth.uid
        && record.get('qty', 0) is number
        && record.get('qty', 0) > 0
        && record.get('qty', 0) == nextNotice.get('qty', 0)
        && request.resource.data.get('deliveredQty', 0) == resource.data.get('deliveredQty', 0) + record.get('qty', 0);
    }

    function validExternalNoticeCreate(id) {
      let data = request.resource.data;
      let orderId = data.get('orderId', '');
      let orderPath = /databases/$(database)/documents/orders/$(orderId);
      let order = get(orderPath).data;
      let index = data.get('itemIndex', -1);
      let warehouseId = data.get('warehouseId', '');
      let whPath = /databases/$(database)/documents/warehouses/$(warehouseId);
      return (admin() || purchaser() || warehouse())
        && orderId != '' && warehouseId != ''
        && data.get('itemId', '') != ''
        && id == orderId + '__' + data.itemId
        && data.keys().hasOnly([
          'orderId', 'itemId', 'itemIndex', 'warehouseId', 'orderNo',
          'ownerUid', 'salesCode', 'customerName', 'itemCode', 'itemName',
          'qty', 'status', 'shippingAddress', 'contactName', 'contactPhone',
          'expectedDate', 'notes', 'notifiedByUid', 'notifiedBy',
          'notifiedAt', 'createdAt', 'updatedAt'
        ])
        && data.get('status', '') == 'NOTIFIED'
        && data.get('notifiedByUid', '') == request.auth.uid
        && data.get('notifiedAt', '') is string
        && data.get('notifiedAt', '') != ''
        && !orderIsCancelled(order)
        && order.get('ownerUid', '') == data.get('ownerUid', '')
        && order.get('salesCode', '') == data.get('salesCode', '')
        && index is int && index >= 0
        && index < order.get('items', []).size()
        && order.items[index].get('itemId', '') == data.itemId
        && order.items[index].get('fulfillmentType', 'WAREHOUSE') != 'DIRECT_SHIP'
        && order.items[index].get('warehouseId', order.get('warehouseId', '')) == warehouseId
        && data.get('qty', 0) is number
        && data.get('qty', 0) > 0
        && data.get('qty', 0) <= order.items[index].get('qty', order.items[index].get('orderedQty', 0))
        && get(whPath).data.get('active', true) == true
        && get(whPath).data.get('warehouseType', 'INTERNAL') == 'EXTERNAL';
    }

    function validExternalNoticeShipment(id) {
      let orderPath = /databases/$(database)/documents/orders/$(resource.data.orderId);
      let records = getAfter(orderPath).data.get('deliveryRecords', []);
      let record = records[records.size() - 1];
      let movementId = request.resource.data.get('movementId', '');
      let movementPath = /databases/$(database)/documents/inventoryMovements/$(movementId);
      let movement = getAfter(movementPath).data;
      let stockPath = /databases/$(database)/documents/warehouseStocks/$(movement.get('warehouseStockId', ''));
      let inventoryPath = /databases/$(database)/documents/inventory/$(movement.get('inventoryDocId', ''));
      return (admin() || purchaser() || warehouse())
        && resource.data.get('status', '') == 'NOTIFIED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'shippedAt', 'shippedBy', 'shippedByUid',
          'deliveryRecordId', 'movementId', 'updatedAt'
        ])
        && request.resource.data.get('status', '') == 'SHIPPED'
        && request.resource.data.get('shippedByUid', '') == request.auth.uid
        && request.resource.data.get('shippedAt', '') is string
        && request.resource.data.get('shippedAt', '') != ''
        && records.size() > 0
        && record.get('externalNoticeId', '') == id
        && record.get('id', '') == request.resource.data.get('deliveryRecordId', '')
        && record.get('itemId', '') == resource.data.itemId
        && record.get('warehouseId', '') == resource.data.warehouseId
        && record.get('qty', 0) == resource.data.qty
        && record.get('sourceType', '') == 'EXTERNAL_WAREHOUSE_SHIP'
        && movementId != ''
        && record.get('movementId', '') == movementId
        && !exists(movementPath)
        && getAfter(movementPath).data.get('type', '') == 'ship'
        && getAfter(movementPath).data.get('sourceId', '') == resource.data.orderId
        && getAfter(movementPath).data.get('warehouseId', '') == resource.data.warehouseId
        && movement.get('qty', 0) == -resource.data.qty
        && movement.get('warehouseStockId', '') != ''
        && movement.get('inventoryDocId', '') != ''
        && getAfter(stockPath).data.get('warehouseId', '') == resource.data.warehouseId
        && getAfter(stockPath).data.get('productKey', '') == movement.get('productKey', '')
        && getAfter(stockPath).data.get('onHand', -1) == get(stockPath).data.get('onHand', -1) - resource.data.qty
        && getAfter(inventoryPath).data.get('productKey', '') == movement.get('productKey', '')
        && getAfter(inventoryPath).data.get('onHand', -1) == get(inventoryPath).data.get('onHand', -1) - resource.data.qty;
    }

    // Completed delivery must be corrected separately or returned, never cancelled.
    // Check both snapshots so a combined flag/status update cannot bypass this guard.
    function validOrderCancellationTransition() {
      let before = resource.data;
      let after = request.resource.data;
      let wasCancelled = orderIsCancelled(before);
      let isCancelled = orderIsCancelled(after);
      return !isCancelled || wasCancelled
        || (noCustodyForCancellation() && before.get('logisticsTransfersPending', 0) == 0 && after.get('logisticsTransfersPending', 0) == 0
          && before.get('isDelivered', false) != true && after.get('isDelivered', false) != true
          && after.get('deliveryRecords', []) == before.get('deliveryRecords', [])
          && after.get('returnRecords', []) == before.get('returnRecords', [])
          && after.get('deliveredQty', 0) == before.get('deliveredQty', 0));
    }

    function validInventoryShipmentItem(before, after, record) {
      let index = record.get('itemIndex', -1);
      let oldItem = before.items[index];
      let newItem = after.items[index];
      let reservationPath = /databases/$(database)/documents/inventoryReservations/$(record.orderId + '__' + record.itemId);
      let oldReservation = get(reservationPath).data;
      let newReservation = getAfter(reservationPath).data;
      return index is int && index >= 0 && index < before.items.size()
        && before.items.size() == after.items.size()
        && before.items.removeAll([oldItem]) == after.items.removeAll([newItem])
        && newItem.diff(oldItem).affectedKeys().hasOnly(['reservedQty', 'warehouseShippedQty'])
        && oldItem.get('itemId', '') == record.itemId
        && oldItem.get('fulfillmentType', 'WAREHOUSE') != 'DIRECT_SHIP'
        && oldItem.get('warehouseId', before.get('warehouseId', '')) == record.warehouseId
        && oldReservation.get('orderId', '') == record.orderId
        && oldReservation.get('itemId', '') == record.itemId
        && oldReservation.get('productKey', '') == record.productKey
        && newReservation.get('productKey', '') == record.productKey
        && newReservation.get('warehouseId', '') == record.warehouseId
        && oldReservation.get('warehouseId', '') == record.warehouseId
        && oldReservation.get('quantity', 0) >= record.qty
        && newReservation.get('quantity', -1) == oldReservation.quantity - record.qty
        && newItem.get('reservedQty', -1) == newReservation.quantity
        && newItem.get('warehouseShippedQty', 0) >= oldItem.get('warehouseShippedQty', 0) + record.qty
        && newItem.warehouseShippedQty <= oldItem.get('dispatchPreparedQty', 0);
    }

    function validInventoryShipmentStock(record) {
      let movementPath = /databases/$(database)/documents/inventoryMovements/$(record.movementId);
      let movement = getAfter(movementPath).data;
      let stockPath = /databases/$(database)/documents/warehouseStocks/$(movement.warehouseStockId);
      let inventoryPath = /databases/$(database)/documents/inventory/$(movement.inventoryDocId);
      return !exists(movementPath)
        && movement.get('type', '') == 'ship'
        && movement.get('sourceId', '') == record.orderId
        && movement.get('itemId', '') == record.itemId
        && movement.get('productKey', '') == record.productKey
        && movement.get('warehouseId', '') == record.warehouseId
        && movement.get('actorUid', '') == request.auth.uid
        && movement.get('qty', 0) == -record.qty
        && get(stockPath).data.get('warehouseId', '') == record.warehouseId
        && get(stockPath).data.get('productKey', '') == movement.get('productKey', '')
        && get(inventoryPath).data.get('productKey', '') == movement.get('productKey', '')
        && getAfter(stockPath).data.get('onHand', -1) == get(stockPath).data.onHand - record.qty
        && getAfter(stockPath).data.get('reserved', -1) == get(stockPath).data.reserved - record.qty
        && getAfter(inventoryPath).data.get('onHand', -1) == get(inventoryPath).data.onHand - record.qty
        && getAfter(inventoryPath).data.get('reserved', -1) == get(inventoryPath).data.reserved - record.qty;
    }

    function inventoryShipmentOrderUpdate(orderId) {
      let before = resource.data;
      let after = request.resource.data;
      let beforeRecords = before.get('deliveryRecords', []);
      let afterRecords = after.get('deliveryRecords', []);
      let record = afterRecords[beforeRecords.size()];
      return canReceiveInventory()
        && !orderIsCancelled(before)
        && before.get('inventoryReservationStatus', '') != 'pending'
        && beforeRecords.size() + 1 == afterRecords.size()
        && afterRecords.removeAll([record]) == beforeRecords
        && record.get('id', '') == after.get('inventoryShipmentRecordId', '')
        && record.get('sourceType', '') == 'INVENTORY_SHIPMENT'
        && record.get('orderId', '') == orderId
        && record.get('createdByUid', '') == request.auth.uid
        && record.get('qty', 0) is number && record.qty > 0
        && after.get('deliveredQty', 0) == before.get('deliveredQty', 0) + record.qty
        && sameCommercialOwner() && preservesCreator()
        && after.diff(before).affectedKeys().hasOnly([
          'inventoryShipmentRecordId', 'items', 'deliveryRecords', 'deliveredQty', 'isDelivered',
          'deliveryHistory', 'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ])
        && validInventoryShipmentItem(before, after, record)
        && validInventoryShipmentStock(record);
    }


    function appendsLogisticsHistory(before, after) {
      let prior = before.get('logisticsHistory', []);
      let next = after.get('logisticsHistory', []);
      let entry = next[prior.size()];
      return next.size() == prior.size() + 1 && next.removeAll([entry]) == prior;
    }
    // Warehouse instructions only change one item's recipient plan. Commercial fields stay intact.
    function warehouseDeliveryPlanUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let index = after.get('logisticsPlanItemIndex', -1);
      let oldItem = before.items[index];
      let newItem = after.items[index];
      return (canReceiveInventory() || (role() in ['sales','engineer'] && owns(before) && owns(after))) && sameCommercialOwner() && preservesCreator()
        && oldItem.get('transferPendingId', '') == ''
        && oldItem.get('warehouseShippedQty', oldItem.get('deliveredQty', 0)) - oldItem.get('returnedQty', 0) < oldItem.get('qty', oldItem.get('orderedQty', 0))
        && (!(oldItem.get('warehouseId', '').matches('custody-.*')) || (canReceiveInventory() && newItem.deliveryPlan.mode == 'TRANSFER'))
        && !orderIsCancelled(before)
        && index is int && index >= 0 && index < before.items.size()
        && before.items.size() == after.items.size()
        && before.items.removeAll([oldItem]) == after.items.removeAll([newItem])
        && newItem.diff(oldItem).affectedKeys().hasOnly(['deliveryPlan'])
        && validDeliveryPlan(newItem.deliveryPlan)
        && after.get('logisticsPlanActorUid', '') == request.auth.uid
        && appendsLogisticsHistory(before, after)
        && after.diff(before).affectedKeys().hasOnly(['items', 'logisticsPlanItemIndex',
          'logisticsPlanActorUid', 'logisticsPlanEventId', 'logisticsHistory', 'updatedAt']);
    }
    function validDeliveryPlan(p) {
      return p.keys().hasOnly(['mode','warehouseId','contact','phone','address','packages','condition','tracking','notes'])
        && p.mode in ['PICKUP','SALES_SHIP','CUSTOMER_SHIP','TRANSFER']
        && p.packages is int && p.packages >= 1 && p.packages <= 99
        && p.contact is string && p.contact.size() <= 1000
        && p.phone is string && p.phone.size() <= 1000
        && p.address is string && p.address.size() <= 1000
        && p.notes is string && p.notes.size() <= 1000;
    }
    function warehouseLogisticsOrderUpdate(orderId) {
      let before = resource.data;
      let after = request.resource.data;
      let path = /databases/$(database)/documents/stockTransfers/$(after.get('warehouseLogisticsId', 'unused'));
      let transfer = getAfter(path).data;
      let index = transfer.itemIndex;
      let oldItem = before.items[index];
      let newItem = after.items[index];
      return canReceiveInventory() && sameCommercialOwner() && preservesCreator()
        && transfer.orderId == orderId && transfer.itemId == oldItem.itemId
        && index is int && index >= 0 && index < before.items.size()
        && before.items.size() == after.items.size()
        && before.items.removeAll([oldItem]) == after.items.removeAll([newItem])
        && newItem.diff(oldItem).affectedKeys().hasOnly(['warehouseId','custodyTransferId','transferPendingId'])
        && !orderIsCancelled(before)
        && after.get('deliveryRecords', []) == before.get('deliveryRecords', [])
        && after.get('returnRecords', []) == before.get('returnRecords', [])
        && after.diff(before).affectedKeys().hasOnly(['items','warehouseLogisticsId','warehouseLogisticsEventId','logisticsTransfersPending',
          'logisticsHistory','workCategories','workCategoryUpdatedAt','updatedAt'])
        && appendsLogisticsHistory(before, after)
        && ((!exists(path) && transfer.createdByUid == request.auth.uid
          && oldItem.get('transferPendingId', '') == ''
        && oldItem.get('warehouseShippedQty', oldItem.get('deliveredQty', 0)) - oldItem.get('returnedQty', 0) < oldItem.get('qty', oldItem.get('orderedQty', 0))
          && transfer.qty == oldItem.get('reservedQty', 0)
          && transfer.fromWarehouseId == oldItem.get('warehouseId', before.get('warehouseId', ''))
          && (transfer.kind == 'HANDOFF'
            ? newItem.warehouseId == transfer.toWarehouseId && newItem.custodyTransferId == transfer.id
              && after.get('logisticsTransfersPending', 0) == before.get('logisticsTransfersPending', 0)
            : newItem.get('warehouseId', '') == oldItem.get('warehouseId', '') && newItem.transferPendingId == transfer.id
              && after.get('logisticsTransfersPending', 0) == before.get('logisticsTransfersPending', 0) + 1))
          || (exists(path) && get(path).data.status == 'IN_TRANSIT' && transfer.status == 'RECEIVED'
            && transfer.receivedByUid == request.auth.uid && oldItem.transferPendingId == transfer.id
            && newItem.get('transferPendingId', '') == '' && newItem.warehouseId == transfer.toWarehouseId
            && after.get('logisticsTransfersPending', 0) == before.get('logisticsTransfersPending', 0) - 1));
    }

    function logisticsItemProtected(oldItems, newItems, index) {
      return index >= oldItems.size() || (index < newItems.size()
        && newItems[index].get('warehouseId', '') == oldItems[index].get('warehouseId', '')
        && newItems[index].get('transferPendingId', '') == oldItems[index].get('transferPendingId', '')
        && newItems[index].get('custodyTransferId', '') == oldItems[index].get('custodyTransferId', '')
        && (!oldItems[index].get('warehouseId', '').matches('custody-.*') || newItems[index].get('deliveryPlan', {}) == oldItems[index].get('deliveryPlan', {})));
    }
    function custodyItemClear(items, index) {
      return index >= items.size() || items[index].get('reservedQty', 0) == 0
        || !items[index].get('warehouseId', '').matches('custody-.*');
    }
    function logisticsLocationProtected() {
      let before = resource.data;
      let after = request.resource.data;
      return before.get('warehouseLogisticsId', '') == '' || before.get('items', []) == after.get('items', []) || (before.items.size() <= 30
        && before.items.size() == after.items.size()
        && logisticsItemProtected(before.items, after.items, 0) && logisticsItemProtected(before.items, after.items, 1) && logisticsItemProtected(before.items, after.items, 2) && logisticsItemProtected(before.items, after.items, 3) && logisticsItemProtected(before.items, after.items, 4) && logisticsItemProtected(before.items, after.items, 5) && logisticsItemProtected(before.items, after.items, 6) && logisticsItemProtected(before.items, after.items, 7) && logisticsItemProtected(before.items, after.items, 8) && logisticsItemProtected(before.items, after.items, 9) && logisticsItemProtected(before.items, after.items, 10) && logisticsItemProtected(before.items, after.items, 11) && logisticsItemProtected(before.items, after.items, 12) && logisticsItemProtected(before.items, after.items, 13) && logisticsItemProtected(before.items, after.items, 14) && logisticsItemProtected(before.items, after.items, 15) && logisticsItemProtected(before.items, after.items, 16) && logisticsItemProtected(before.items, after.items, 17) && logisticsItemProtected(before.items, after.items, 18) && logisticsItemProtected(before.items, after.items, 19) && logisticsItemProtected(before.items, after.items, 20) && logisticsItemProtected(before.items, after.items, 21) && logisticsItemProtected(before.items, after.items, 22) && logisticsItemProtected(before.items, after.items, 23) && logisticsItemProtected(before.items, after.items, 24) && logisticsItemProtected(before.items, after.items, 25) && logisticsItemProtected(before.items, after.items, 26) && logisticsItemProtected(before.items, after.items, 27) && logisticsItemProtected(before.items, after.items, 28) && logisticsItemProtected(before.items, after.items, 29));
    }
    function noCustodyForCancellation() {
      let before = resource.data;
      return before.get('warehouseLogisticsId', '') == '' || (before.get('items', []).size() <= 30
        && custodyItemClear(before.get('items', []), 0) && custodyItemClear(before.get('items', []), 1) && custodyItemClear(before.get('items', []), 2) && custodyItemClear(before.get('items', []), 3) && custodyItemClear(before.get('items', []), 4) && custodyItemClear(before.get('items', []), 5) && custodyItemClear(before.get('items', []), 6) && custodyItemClear(before.get('items', []), 7) && custodyItemClear(before.get('items', []), 8) && custodyItemClear(before.get('items', []), 9) && custodyItemClear(before.get('items', []), 10) && custodyItemClear(before.get('items', []), 11) && custodyItemClear(before.get('items', []), 12) && custodyItemClear(before.get('items', []), 13) && custodyItemClear(before.get('items', []), 14) && custodyItemClear(before.get('items', []), 15) && custodyItemClear(before.get('items', []), 16) && custodyItemClear(before.get('items', []), 17) && custodyItemClear(before.get('items', []), 18) && custodyItemClear(before.get('items', []), 19) && custodyItemClear(before.get('items', []), 20) && custodyItemClear(before.get('items', []), 21) && custodyItemClear(before.get('items', []), 22) && custodyItemClear(before.get('items', []), 23) && custodyItemClear(before.get('items', []), 24) && custodyItemClear(before.get('items', []), 25) && custodyItemClear(before.get('items', []), 26) && custodyItemClear(before.get('items', []), 27) && custodyItemClear(before.get('items', []), 28) && custodyItemClear(before.get('items', []), 29));
    }

    function commercialKeepsPendingTransfer() {
      return logisticsLocationProtected() && request.resource.data.get('logisticsTransfersPending', 0) == resource.data.get('logisticsTransfersPending', 0)
        && request.resource.data.get('warehouseLogisticsId', '') == resource.data.get('warehouseLogisticsId', '')
        && request.resource.data.get('logisticsHistory', []) == resource.data.get('logisticsHistory', [])
        && (resource.data.get('logisticsTransfersPending', 0) == 0 || request.resource.data.items == resource.data.items);
    }

    function orderUpdateAllowed(id) {
      let userRole = role();
      return userRole == 'admin' ? true
        : userRole == 'purchaser' ? (request.resource.data.diff(resource.data).affectedKeys().hasAny(['logisticsPlanActorUid','logisticsPlanItemIndex','logisticsPlanEventId']) && warehouseDeliveryPlanUpdate()) || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['warehouseLogisticsId','warehouseLogisticsEventId']) && warehouseLogisticsOrderUpdate(id)) || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['inventoryShipmentRecordId']) && inventoryShipmentOrderUpdate(id)) || purchaserOrderWorkflowUpdate() || returnReceiptOrderUpdate(id)
        : userRole == 'warehouse' ? (request.resource.data.diff(resource.data).affectedKeys().hasAny(['logisticsPlanActorUid','logisticsPlanItemIndex','logisticsPlanEventId']) && warehouseDeliveryPlanUpdate()) || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['warehouseLogisticsId','warehouseLogisticsEventId']) && warehouseLogisticsOrderUpdate(id)) || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['inventoryShipmentRecordId']) && inventoryShipmentOrderUpdate(id)) || warehouseOrderWorkflowUpdate() || returnReceiptOrderUpdate(id)
        : userRole in ['sales', 'engineer'] && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['inventoryShipmentRecordId'])
          && ((request.resource.data.diff(resource.data).affectedKeys().hasAny(['deliveryRecords']) && directShipReceiptOrderUpdate(id)) || (owns(resource.data) && owns(request.resource.data) && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['logisticsPlanActorUid','logisticsPlanItemIndex','logisticsPlanEventId']) ? warehouseDeliveryPlanUpdate() : (sameCommercialOwner() && preservesCreator() && validCommercialOrderCostUpdate() && businessOrderFactsProtected(id) && commercialReturnProtection() && (resource.data.get('warehouseLogisticsId', '') == '' || commercialKeepsPendingTransfer())))));
    }

    function businessDeliveryRecordChange(before, after, index) {
      return index is int && index >= 0
        && ((after.size() == before.size() + 1 && index < after.size()
            && after[index].qty is number && after[index].qty > 0
            && after.removeAll([after[index]]) == before
            && request.resource.data.deliveredQty == resource.data.get('deliveredQty', 0) + after[index].qty)
          || (after.size() == before.size() && index < after.size()
            && after[index].id == before[index].id && after[index].itemId == before[index].itemId
            && after[index].qty is number && after[index].qty > 0
            && after.removeAll([after[index]]) == before.removeAll([before[index]])
            && request.resource.data.deliveredQty == resource.data.get('deliveredQty', 0) + after[index].qty - before[index].qty)
          || (after.size() + 1 == before.size() && index < before.size()
            && after == before.removeAll([before[index]])
            && request.resource.data.deliveredQty == resource.data.get('deliveredQty', 0) - before[index].qty));
    }
    function businessPhysicalDelivery(id, e) {
      let path = /databases/$(database)/documents/stockOperations/$(e.get('operationId', 'unused'));
      let op = getAfter(path).data;
      let invPath = /databases/$(database)/documents/inventory/$(e.get('inventoryId', 'unused'));
      return e.get('operationId', '') != '' && !exists(path)
        && op.actorUid == request.auth.uid && op.orderId == id
        && op.targetPath == 'inventory/' + e.inventoryId
        && getAfter(invPath).data.stockOperationId == e.operationId
        && getAfter(invPath).data.onHand - get(invPath).data.onHand == op.qtyDelta
        && op.qtyDelta == resource.data.get('deliveredQty', 0) - request.resource.data.get('deliveredQty', 0);
    }
    function businessOrderFactsProtected(id) {
      let before = resource.data;
      let after = request.resource.data;
      let prior = before.get('deliveryRecords', []);
      let next = after.get('deliveryRecords', []);
      let e = after.get('businessDeliveryEvidence', {});
      return before.get('qty', 0) == after.get('qty', 0)
        && before.get('isOrdered', false) == after.get('isOrdered', false)
        && before.get('isArrived', false) == after.get('isArrived', false)
        && before.get('receivedQty', 0) == after.get('receivedQty', 0)
        && ((prior == next && before.get('deliveredQty', 0) == after.get('deliveredQty', 0)
            && before.get('isDelivered', false) == after.get('isDelivered', false))
          || (next is list && after.get('deliveredQty', 0) is number && after.deliveredQty >= 0
            && (!after.get('isDelivered', false) || next.size() > 0)
            && (businessDeliveryRecordChange(prior, next, e.get('recordIndex', -1))
              || (before.get('items', []).size() == 1 && next.size() == 0 && after.deliveredQty == 0))
            && (before.get('deliveredQty', 0) == after.deliveredQty
              ? before.get('isDelivered', false) == after.get('isDelivered', false)
              : businessPhysicalDelivery(id, e))));
    }

    function validOrderInventorySyncTransition() {
      let before = resource.data;
      let after = request.resource.data;
      return !after.diff(before).affectedKeys().hasAny(['inventoryReservationStatus','inventoryReservationError','inventoryReservationUpdatedAt','inventoryReservationAttemptId'])
        || (role() in ['admin','purchaser','sales','engineer']
          && !orderIsCancelled(before) && !orderIsCancelled(after)
          && before.get('inventoryReservationStatus', '') != 'completed'
          && after.get('inventoryReservationAttemptId', '') is string && after.inventoryReservationAttemptId.size() > 0 && after.inventoryReservationAttemptId.size() <= 128
          && after.get('inventoryReservationError', '') is string && after.inventoryReservationError.size() <= 1000
          && after.get('inventoryReservationUpdatedAt', '') is string && after.inventoryReservationUpdatedAt.size() <= 64
          && (after.get('inventoryReservationStatus', '') == 'pending'
            ? after.inventoryReservationAttemptId != before.get('inventoryReservationAttemptId', '') && after.inventoryReservationError == ''
            : before.get('inventoryReservationStatus', '') == 'pending'
              && after.inventoryReservationAttemptId == before.get('inventoryReservationAttemptId', '')
              && after.get('inventoryReservationStatus', '') in ['completed','failed']
              && (after.inventoryReservationStatus != 'completed' || after.inventoryReservationError == '')));
    }

    match /orders/{id} {
      allow get: if admin() || purchaser() || warehouse() || (commercialDocumentOwner() && (resource == null || owns(resource.data)));
      allow list: if admin() || purchaser() || warehouse() || owns(resource.data);
      allow create: if canCreateCommercialDoc()
        && validOwnedCommercialCreate(request.resource.data)
        && validNewOrderProductMaster(request.resource.data)
        && validOrderEmbeddedCost(request.resource.data);
      // Commercial owner edits commercial data; purchaser/warehouse must use scoped
      // workflow collections below instead of broad order mutation.
      allow update: if (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'orderStatus'])
        || validOrderCancellationTransition()) && validOrderInventorySyncTransition() && orderUpdateAllowed(id);
      allow delete: if admin();
    }

    // Formal supplier PO. Sales/engineer self-order does NOT grant purchase-order privilege.
    match /purchaseOrders/{id} {
      allow read: if admin() || purchaser();
      allow create: if canPurchase();
      // The PO is an immutable document snapshot for warehouse users. Receiving
      // progress belongs to supplyOrders and receipts, never back on the PO.
      allow update: if canPurchase();
      allow delete: if admin();
    }

    // ERP-style communication timeline. Browser share/mailto can prove only that
    // the handoff was prepared, not that an email was actually delivered.
    match /purchaseOrderCommunications/{id} {
      allow read: if admin() || purchaser();
      allow write: if false;
    }

    // ERP Material Request-like purchasing demand. Demand identity is stable and
    // supplier orders / receipts link back through demandId.
    match /procurementDemands/{id} {
      // Transactions read the deterministic ID before creating a demand. Missing data carries no customer information.
      allow get: if admin() || purchaser() || warehouse()
        || (businessOwner() && (resource == null || owns(resource.data)));
      allow list: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if validProcurementDemand(request.resource.data) && (canReceiveInventory()
        || businessProcurementDemandCreate(request.resource.data));
      allow update: if validProcurementDemand(request.resource.data) && demandIdentityUnchanged()
        && ((resource.data.get('fulfillmentType', '') == 'DIRECT_SHIP'
          && request.resource.data.get('receivedQty', 0) > resource.data.get('receivedQty', 0))
          ? (admin() || businessDirectDemandReceiptUpdate())
          : (canReceiveInventory() || businessProcurementDemandOperationalUpdate() || businessReservationDemandUpdate()));
      allow delete: if admin();
    }

    // New self-orders must carry their supplier and actual unit cost.
    // This is independent of the quick-purchase rules and does not rewrite old documents.
    function validSelfOrderSupplyCreate() {
      let data = request.resource.data;
      return data.get('type', '') != 'SALES_SELF_ORDER'
        || (data.get('supplier', '') is string
          && data.get('supplier', '').matches('.*\\S.*')
          && data.get('unitCost', null) is number
          && data.get('unitCost', null) >= 0);
    }

    function validQuickPurchaseCost() {
      let data = request.resource.data;
      return data.get('type', '') != 'PURCHASING_MANUAL'
        || (data.get('supplier', '') is string && data.get('supplier', '').size() > 0
          && data.get('unitCost', null) is number && data.get('unitCost', null) >= 0);
    }

    function validQuickPurchaseUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return after.get('type', '') != 'PURCHASING_MANUAL'
        || (after.get('qty', 0) <= before.get('qty', 0)
          && !after.diff(before).affectedKeys().hasAny(['supplier', 'unitCost']))
        || (validQuickPurchaseCost()
          && (after.get('qty', 0) <= before.get('qty', 0)
            || (after.get('supplier', '') == before.get('supplier', '')
              && after.get('unitCost', 0) == before.get('unitCost', 0))));
    }

    // Unified source/order evidence: PURCHASING_PO, PURCHASING_MANUAL, SALES_SELF_ORDER, STOCK_REPLENISHMENT.
    match /supplyOrders/{id} {
      allow read: if admin() || purchaser()
        || (businessOwner()
          && resource.data.type == 'SALES_SELF_ORDER'
          && resource.data.ownerUid == request.auth.uid);
      allow create: if ((admin() || purchaser()) && validQuickPurchaseCost())
        && validSelfOrderSupplyCreate()
        || (businessOwner()
          && request.resource.data.type == 'SALES_SELF_ORDER'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.salesCode == salesCode()
          && validSelfOrderSupplyCreate());
      // Sales owns the commercial intent and may create/read its own self-order,
      // but supply execution becomes operational evidence after creation. Only purchasing
      // or receiving roles may mutate quantities/status; this prevents direct API edits
      // from bypassing procurement and receipt workflows.
      allow update: if (admin()
        || directShipSupplyReceiptUpdate(id)
        || purchaserSupplyOperationalUpdate()
        || supplierCancellationResolution()
        || warehouseSupplyOperationalUpdate()) && supplierReceiptDispositionAllowed() && validQuickPurchaseUpdate();
      allow delete: if admin();
    }

    // The authoritative supply record retains cost. This derived receiving view
    // must exactly match it, except that financial fields are absent.
    function businessReceivingView(data) {
      return businessOwner() && data.get('ownerUid', '') == request.auth.uid
        && (data.get('fulfillmentType', '') == 'DIRECT_SHIP' || data.get('type', '') == 'SALES_SELF_ORDER');
    }
    function receivingViewWriter(data) {
      let userRole = role();
      return userRole in ['admin', 'purchaser', 'warehouse']
        || (userRole in ['sales', 'engineer'] && data.get('ownerUid', '') == request.auth.uid
          && (data.get('fulfillmentType', '') == 'DIRECT_SHIP' || data.get('type', '') == 'SALES_SELF_ORDER'));
    }
    match /receivingSupplyOrders/{id} {
      allow get: if admin() || purchaser() || warehouse()
        || (businessOwner() && (resource == null || businessReceivingView(resource.data)));
      allow list: if admin() || purchaser() || warehouse() || businessReceivingView(resource.data);
      allow create, update: if receivingViewWriter(request.resource.data)
        && !request.resource.data.keys().hasAny(['unitCost', 'cost', 'costPrice'])
        && request.resource.data.diff(getAfter(/databases/$(database)/documents/supplyOrders/$(id)).data)
          .affectedKeys().hasOnly(['unitCost', 'cost', 'costPrice']);
      allow delete: if admin();
    }


    // Main replenishment request: immutable source/quantity; reserve first, ship later.
    // stockTransferRequests contains only operational item identity and actor UID, never costs.
    function validMainTransferRequest(d) {
      return d.keys().hasOnly(['id','inventoryId','productKey','productId','itemCode','itemName','brand',
          'fromWarehouseId','toWarehouseId','fromStockId','qty','status','createdByUid','createdAt',
          'transferId','shippedAt','shippedByUid','cancelledAt','cancelledByUid'])
        && d.keys().hasAll(['id','inventoryId','productKey','productId','itemCode','itemName','brand',
          'fromWarehouseId','toWarehouseId','fromStockId','qty','status','createdByUid','createdAt'])
        && d.id is string && d.id.size() > 0 && d.id.size() <= 128
        && d.inventoryId is string && d.inventoryId.size() > 0 && d.inventoryId.size() <= 1500
        && d.productKey is string && d.productKey.size() > 0 && d.productKey.size() <= 1500
        && d.productId is string && d.productId.size() <= 1500
        && d.itemCode is string && d.itemCode.size() <= 1000
        && d.itemName is string && d.itemName.size() <= 1000
        && d.brand is string && d.brand.size() <= 1000
        && d.fromWarehouseId is string && d.fromWarehouseId.size() > 0 && d.fromWarehouseId.size() <= 1500
        && d.toWarehouseId is string && d.toWarehouseId.size() > 0 && d.toWarehouseId.size() <= 1500
        && d.fromStockId is string && d.fromStockId.size() > 0 && d.fromStockId.size() <= 1500
        && d.createdByUid is string && d.createdByUid.size() > 0 && d.createdByUid.size() <= 128
        && d.createdAt is string && d.createdAt.size() <= 40
        && d.qty is number && d.qty > 0 && d.qty <= 1000000
        && d.status in ['PENDING','SHIPPED','CANCELLED']
        && d.fromWarehouseId != d.toWarehouseId;
    }
    function mainTransferHold(d, direction) {
      let invPath = /databases/$(database)/documents/inventory/$(d.inventoryId);
      let stockPath = /databases/$(database)/documents/warehouseStocks/$(d.fromStockId);
      let inv = get(invPath).data;
      let nextInv = getAfter(invPath).data;
      let stock = get(stockPath).data;
      let nextStock = getAfter(stockPath).data;
      return stock.productKey == d.productKey && stock.warehouseId == d.fromWarehouseId
        && inv.get('productKey', inv.get('productId', '')) == d.productKey
        && nextStock.onHand == stock.onHand && nextInv.onHand == inv.onHand
        && nextStock.reserved == stock.reserved + direction * d.qty
        && nextStock.get('transferReserved', 0) == stock.get('transferReserved', 0) + direction * d.qty
        && nextInv.reserved == inv.reserved + direction * d.qty
        && nextInv.get('transferReserved', 0) == inv.get('transferReserved', 0) + direction * d.qty
        && nextStock.reserved >= 0 && nextStock.reserved <= nextStock.onHand
        && nextStock.get('transferReserved', 0) >= 0 && nextInv.get('transferReserved', 0) >= 0
        && nextInv.diff(inv).affectedKeys().hasOnly(['reserved','transferReserved','updatedAt'])
        && nextStock.diff(stock).affectedKeys().hasOnly(['reserved','transferReserved','updatedAt']);
    }
    function mainTransferDispatch(d) {
      let path = /databases/$(database)/documents/stockTransfers/$(d.get('transferId', 'unused'));
      let transfer = getAfter(path).data;
      return !exists(path) && transfer.requestId == d.id && transfer.inventoryId == d.inventoryId
        && transfer.fromWarehouseId == d.fromWarehouseId && transfer.toWarehouseId == d.toWarehouseId
        && transfer.qty == d.qty && transfer.reservedQty == 0 && transfer.kind == 'TRANSFER'
        && transfer.status == 'IN_TRANSIT' && transfer.createdByUid == request.auth.uid;
    }
    match /stockTransferRequests/{id} {
      allow read: if canReceiveInventory();
      allow create: if (admin() || purchaser()) && validMainTransferRequest(request.resource.data)
        && request.resource.data.id == id && request.resource.data.status == 'PENDING'
        && request.resource.data.createdByUid == request.auth.uid
        && !request.resource.data.keys().hasAny(['transferId','shippedAt','shippedByUid','cancelledAt','cancelledByUid'])
        && get(/databases/$(database)/documents/warehouses/$(request.resource.data.toWarehouseId)).data.get('isDefault', false)
        && get(/databases/$(database)/documents/warehouses/$(request.resource.data.toWarehouseId)).data.get('active', true)
        && !get(/databases/$(database)/documents/warehouses/$(request.resource.data.toWarehouseId)).data.get('systemCustody', false)
        && get(/databases/$(database)/documents/warehouses/$(request.resource.data.fromWarehouseId)).data.get('active', true)
        && !get(/databases/$(database)/documents/warehouses/$(request.resource.data.fromWarehouseId)).data.get('systemCustody', false)
        && mainTransferHold(request.resource.data, 1);
      allow update: if validMainTransferRequest(request.resource.data) && resource.data.status == 'PENDING'
        && ((canReceiveInventory() && request.resource.data.status == 'SHIPPED'
          && request.resource.data.shippedByUid == request.auth.uid
          && request.resource.data.shippedAt is string && request.resource.data.shippedAt.size() <= 40
          && request.resource.data.transferId is string && request.resource.data.transferId.size() <= 128
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','transferId','shippedAt','shippedByUid'])
          && mainTransferDispatch(request.resource.data))
        || ((admin() || purchaser()) && request.resource.data.status == 'CANCELLED'
          && request.resource.data.cancelledByUid == request.auth.uid
          && request.resource.data.cancelledAt is string && request.resource.data.cancelledAt.size() <= 40
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt','cancelledByUid'])
          && mainTransferHold(request.resource.data, -1)));
      allow delete: if false;
    }
    function transferRequestHold(d) {
      let path = /databases/$(database)/documents/stockTransferRequests/$(d.get('requestId', 'unused'));
      let before = get(path).data;
      let after = getAfter(path).data;
      return before.status == 'PENDING' && after.status == 'SHIPPED'
        && after.transferId == d.id && after.shippedByUid == request.auth.uid
        && before.inventoryId == d.inventoryId && before.productKey == d.productKey
        && before.fromWarehouseId == d.fromWarehouseId && before.toWarehouseId == d.toWarehouseId
        && before.fromStockId == d.fromStockId && before.qty == d.qty
        && d.orderId == '' && d.kind == 'TRANSFER' && d.reservedQty == 0;
    }
    function transferSourceStock(d) {
      let path = /databases/$(database)/documents/warehouseStocks/$(d.fromStockId);
      let before = get(path).data;
      let after = getAfter(path).data;
      let held = d.get('requestId', '') != '' ? d.qty : 0;
      return (held == 0 || transferRequestHold(d))
        && before.productKey == d.productKey && before.warehouseId == d.fromWarehouseId
        && after.onHand == before.onHand - d.qty
        && after.reserved == before.reserved - d.reservedQty - held
        && (held == 0 || after.get('transferReserved', 0) == before.get('transferReserved', 0) - held)
        && after.get('incoming', 0) == before.get('incoming', 0)
        && after.onHand >= after.reserved && after.reserved >= 0;
    }
    function transferTargetStock(d) {
      let path = /databases/$(database)/documents/warehouseStocks/$(d.toStockId);
      let before = exists(path) ? get(path).data : {};
      let after = getAfter(path).data;
      return after.productKey == d.productKey && after.warehouseId == d.toWarehouseId
        && after.onHand == before.get('onHand', 0) + d.qty
        && after.reserved == before.get('reserved', 0) + d.reservedQty
        && after.get('incoming', 0) == before.get('incoming', 0);
    }
    function transferAggregate(d, receive) {
      let path = /databases/$(database)/documents/inventory/$(d.inventoryId);
      let before = get(path).data;
      let after = getAfter(path).data;
      let direction = receive ? -1 : 1;
      let held = !receive && d.get('requestId', '') != '' ? d.qty : 0;
      return before.get('productKey', before.get('productId', '')) == d.productKey
        && after.onHand == before.onHand && after.reserved == before.reserved - held
        && (held == 0 || after.get('transferReserved', 0) == before.get('transferReserved', 0) - held)
        && after.get('incoming', 0) == before.get('incoming', 0)
        && (d.kind == 'HANDOFF'
          ? after == before
          : after.get('transferInTransit', 0) == before.get('transferInTransit', 0) + direction * d.qty
            && after.get('transferFreeInTransit', 0) == before.get('transferFreeInTransit', 0) + direction * (d.qty - d.reservedQty)
            && after.get('transferInTransit', 0) >= 0 && after.get('transferFreeInTransit', 0) >= 0);
    }
    function transferOrderEvidence(d) {
      let path = /databases/$(database)/documents/orders/$(d.get('orderId', 'unused'));
      return d.get('orderId', '') == '' ? d.reservedQty == 0 && d.kind == 'TRANSFER'
        : getAfter(path).data.get('warehouseLogisticsId', '') == d.id
          && getAfter(path).data.items[d.itemIndex].itemId == d.itemId
          && d.reservedQty == d.qty;
    }
    match /stockTransfers/{id} {
      allow get, list: if canReceiveInventory();
      allow create: if canReceiveInventory() && request.resource.data.id == id
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.qty is number && request.resource.data.qty > 0
        && request.resource.data.reservedQty is number && request.resource.data.reservedQty >= 0
        && request.resource.data.reservedQty <= request.resource.data.qty
        && request.resource.data.allocations is list && request.resource.data.allocations.size() > 0 && request.resource.data.allocations.size() <= 200
        && request.resource.data.fromWarehouseId != request.resource.data.toWarehouseId
        && request.resource.data.kind in ['TRANSFER','HANDOFF']
        && request.resource.data.status == (request.resource.data.kind == 'HANDOFF' ? 'RECEIVED' : 'IN_TRANSIT')
        && transferOrderEvidence(request.resource.data) && transferSourceStock(request.resource.data)
        && transferAggregate(request.resource.data, false)
        && (request.resource.data.kind != 'HANDOFF' || transferTargetStock(request.resource.data));
      allow update: if canReceiveInventory() && ((resource.data.status == 'IN_TRANSIT'
        && request.resource.data.status == 'RECEIVED' && request.resource.data.receivedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','receivedAt','receivedByUid','autoAllocationQty','autoAllocatedQty','allocationCompleted'])
        && request.resource.data.get('autoAllocationQty', resource.data.qty - resource.data.reservedQty) == (resource.data.get('orderId', '') == '' ? resource.data.qty - resource.data.reservedQty : 0)
        && request.resource.data.get('autoAllocatedQty', 0) == 0
        && transferTargetStock(request.resource.data) && transferAggregate(request.resource.data, true)
        && transferOrderEvidence(request.resource.data))
        || (resource.data.status == 'RECEIVED' && resource.data.get('orderId', '') == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['autoAllocatedQty','allocationCompleted','allocationUpdatedAt'])
          && request.resource.data.get('autoAllocatedQty', 0) is number
          && request.resource.data.get('autoAllocatedQty', 0) >= resource.data.get('autoAllocatedQty', 0)
          && request.resource.data.get('autoAllocatedQty', 0) <= resource.data.get('autoAllocationQty', 0)
          && request.resource.data.get('allocationCompleted', false) is bool));
      allow delete: if false;
    }

    match /inventory/{id} {
      // Aggregate operational stock is shared, but cost fields must never be embedded here.
      // stockPolicy/safetyStock are planning master data: admin/purchaser manage them;
      // warehouse keeps those fields unchanged while performing physical stock work.
      allow get: if admin() || (active() && (
        resource == null
        || (!('unitCost' in resource.data) && !('cost' in resource.data))
      ));
      allow list: if active() && !('unitCost' in resource.data) && !('cost' in resource.data);
      allow create: if (
          ((admin() || purchaser()) && validInventoryStockPolicy(request.resource.data))
          || (warehouse() && warehouseInventoryPlanningDefaults(request.resource.data))
        )
        && nonNegativeInventory(request.resource.data)
        // Administrators can restore archived records from an existing backup.
        && (!request.resource.data.keys().hasAny(inventoryArchiveKeys())
          || (admin() && request.resource.data.get('listArchived', false) is bool))
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow update: if (
          ((admin() || purchaser()) && nonNegativeInventory(request.resource.data)
            && validInventoryStockPolicy(request.resource.data))
          || (warehouse() && nonNegativeInventory(request.resource.data)
            && validInventoryStockPolicy(request.resource.data)
            && warehouseKeepsInventoryPlanning())
          || businessInventoryOperationalUpdate(id)
        )
        && validInventoryArchiveChange(id)
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow delete: if false;
    }

    match /warehouseStocks/{id} {
      allow get: if admin() || (active() && (
        resource == null
        || (!('unitCost' in resource.data) && !('cost' in resource.data))
      ));
      allow list: if admin() || (active() && !('unitCost' in resource.data) && !('cost' in resource.data));
      allow create: if canReceiveInventory() && validWarehouseStock(request.resource.data)
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow update: if ((canReceiveInventory() && validWarehouseStock(request.resource.data))
          || businessWarehouseStockOperationalUpdate(id))
        && warehouseStockIdentityUnchanged()
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow delete: if false;
    }

    match /inventoryReservations/{id} {
      // Reservation transactions first read their deterministic ID so retries remain idempotent.
      // A missing document contains no business data; existing documents stay owner-scoped.
      allow get: if admin() || purchaser() || warehouse()
        || (businessOwner() && (resource == null || owns(resource.data)));
      allow list: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if validReservationSource(id, request.resource.data)
        && reservationCreateWriter(id);
      allow update: if validReservationSource(id, request.resource.data) && reservationIdentityUnchanged()
        && reservationUpdateWriter(id);
      allow delete: if admin();
    }

    match /inventoryLots/{id} {
      // Operational lot data is readable for fulfillment, but cost must never live here.
      allow read: if admin() || purchaser() || warehouse() || (businessOwner() && !('unitCost' in resource.data));
      allow create: if canReceiveInventory() && validInventoryLot(request.resource.data);
      allow update: if (canReceiveInventory() || businessInventoryLotOperationalUpdate(id))
        && validInventoryLot(request.resource.data) && inventoryLotIdentityUnchanged();
      allow delete: if admin();
    }

    // Actual receipt/lot cost is physically separated from operational lot data.
    // Client-side fulfillment never requires this collection.
    match /inventoryLotCosts/{id} {
      allow read: if admin() || purchaser();
      allow create: if admin() || purchaser() || (warehouse() && (
        (request.resource.data.get('sourceType', '') == 'SUPPLY_ORDER'
          && !request.resource.data.keys().hasAny(['unitCost', 'cost', 'costPrice'])
          && request.resource.data.get('costSourceSupplyId', '') == request.resource.data.get('sourceId', '')
          && request.resource.data.get('sourceId', '') != ''
          && getAfter(/databases/$(database)/documents/inventoryLots/$(id)).data.get('sourceId', '') == request.resource.data.sourceId)
        || (request.resource.data.get('sourceType', '') == 'WAREHOUSE_TRANSFER'
          && !request.resource.data.keys().hasAny(['unitCost','cost','costPrice'])
          && request.resource.data.costSourceLotId == getAfter(/databases/$(database)/documents/inventoryLots/$(id)).data.costLotId
          && request.resource.data.sourceId == getAfter(/databases/$(database)/documents/inventoryLots/$(id)).data.sourceId
          && getAfter(/databases/$(database)/documents/stockTransfers/$(request.resource.data.sourceId)).data.status == 'RECEIVED')
        || (request.resource.data.get('sourceType', '') == 'INITIAL_STOCK'
          && !request.resource.data.keys().hasAny(['unitCost', 'cost', 'costPrice'])
          && request.resource.data.lotId == id
          && getAfter(/databases/$(database)/documents/inventoryLots/$(id)).data.get('sourceType', '') == 'INITIAL_STOCK')
      ));
      allow update: if admin() || purchaser();
      allow delete: if admin();
    }

    match /customerReturnReceipts/{id} {
      allow read: if canReceiveInventory() || (businessOwner() && owns(resource.data));
      allow create: if canReceiveInventory()
        && request.resource.data.receivedBy == request.auth.uid
        && request.resource.data.qty is number && request.resource.data.qty > 0
        && request.resource.data.quality in ['SALEABLE', 'INSPECTION', 'DAMAGED']
        && request.resource.data.disposition == (request.resource.data.quality == 'SALEABLE' ? 'STOCK' : 'HOLD')
        && request.resource.data.record.id == id
        && request.resource.data.record.qty == request.resource.data.qty
        && request.resource.data.record.requestId == request.resource.data.requestId
        && request.resource.data.record.itemId == request.resource.data.itemId
        && request.resource.data.record.settlement == 'CLOSE'
        && request.resource.data.record.quality == request.resource.data.quality
        && request.resource.data.record.warehouseId == request.resource.data.warehouseId
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.returnReceiptId == id;
      allow update: if canReceiveInventory() && resource.data.disposition == 'HOLD'
        && request.resource.data.disposition == 'STOCK'
        && request.resource.data.releasedBy == request.auth.uid
        && request.resource.data.releasedAt != ''
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disposition', 'releasedAt', 'releasedBy']);
      allow delete: if admin();
    }

    match /receipts/{id} {
      allow get: if admin() || purchaser() || warehouse()
        || (businessOwner() && (resource == null || owns(resource.data)));
      allow list: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if (request.resource.data.get('fulfillmentType', '') == 'DIRECT_SHIP'
        ? validDirectShipReceipt(id, request.resource.data) : canReceiveInventory())
        && !('unitCost' in request.resource.data)
        && !('purchaseNetAmount' in request.resource.data);
      // Receipt facts remain immutable. Receiving roles may only advance the
      // post-receipt shortage-allocation checkpoint used for resumable/idempotent retries.
      allow update: if canReceiveInventory()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'autoAllocatedQty', 'allocationCompleted', 'allocationUpdatedAt'
        ])
        && request.resource.data.get('autoAllocatedQty', 0) >= resource.data.get('autoAllocatedQty', 0)
        && request.resource.data.get('autoAllocatedQty', 0) <= resource.data.get('autoAllocationQty', 0);
      allow delete: if admin();
    }


    // 外倉出貨通知：資料與訂單分離；下載 PDF 不寫入狀態。
    // 只有實際確認通知時建立 NOTIFIED；SHIPPED 需與訂單/庫存交易同時提交。
    match /externalDispatchNotices/{id} {
      allow get: if admin() || purchaser() || warehouse()
        || (businessOwner() && (resource == null || owns(resource.data)));
      allow list: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Purchaser records completion of the company's existing shipping paperwork.
    match /dispatchRecords/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if admin() || purchaser();
      allow update: if false;
      allow delete: if admin();
    }

    // Physical delivery is recorded by the responsible business owner.
    match /deliveries/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if admin()
        || (businessOwner() && owns(request.resource.data));
      allow update: if false;
      allow delete: if admin();
    }

    match /pendingInventoryItems/{id} {
      allow read: if admin() || purchaser() || warehouse();
      allow create, update: if admin() || purchaser() || warehouse();
      allow delete: if admin();
    }

    // Immutable stock ledger.
    match /inventoryMovements/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if inventoryMovementWriter(id)
        && !('unitCost' in request.resource.data)
        && !('purchaseNetAmount' in request.resource.data)
        && !('cogs' in request.resource.data);
      allow update: if false;
      allow delete: if admin();
    }

    // Immutable operational audit trail.
    match /stockOperations/{id} {
      allow get: if active() && (resource == null || admin() || purchaser() || warehouse() || resource.data.actorUid == request.auth.uid);
      allow list: if admin() || purchaser() || warehouse() || (active() && resource.data.actorUid == request.auth.uid);
      allow create: if admin() || validStockOperation(request.resource.data);
      allow update, delete: if false;
    }

    match /auditLogs/{id} {
      allow read: if admin() || (active() && resource.data.actorUid == request.auth.uid);
      allow create: if active() && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if admin();
    }

    match /equipment/{id} {
      allow read: if canManageEquipment() || (businessOwner() && owns(resource.data));
      allow create: if canManageEquipment()
        || (sales() && owns(request.resource.data));
      allow update: if canManageEquipment()
        || (sales() && owns(resource.data) && owns(request.resource.data));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

