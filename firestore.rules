        && (count <= 1 || (items[1].get('receivedQty', 0) == 0 && items[1].get('receiptEvents', []) == []))
        && (count <= 2 || (items[2].get('receivedQty', 0) == 0 && items[2].get('receiptEvents', []) == []))
        && (count <= 3 || (items[3].get('receivedQty', 0) == 0 && items[3].get('receiptEvents', []) == []))
        && (count <= 4 || (items[4].get('receivedQty', 0) == 0 && items[4].get('receiptEvents', []) == []))
        && (count <= 5 || (items[5].get('receivedQty', 0) == 0 && items[5].get('receiptEvents', []) == []))
