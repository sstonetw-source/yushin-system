rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUser() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function active() {
      return hasUser()
        && (!('active' in userDoc().data) || userDoc().data.active == true);
    }

    function role() {
      return active() ? userDoc().data.role : null;
    }

    function admin() { return role() == 'admin'; }
    function sales() { return role() == 'sales'; }
    function engineer() { return role() == 'engineer'; }
    function purchaser() { return role() == 'purchaser'; }
    function warehouse() { return role() == 'warehouse'; }
    function directShipReceiver() { return role() in ['purchaser', 'warehouse']; }

    // Sales and engineers own their own commercial and fulfillment records.
    function businessOwner() {
      return sales() || engineer();
    }

    function commercialDocumentOwner() {
      return sales() || engineer();
    }

    function businessAssistant() {
      return purchaser();
    }

    function canCreateCommercialDoc() {
      return admin() || commercialDocumentOwner() || businessAssistant();
    }

    function canPurchase() {
      return admin() || purchaser();
    }

    function canReceiveInventory() {
      return admin() || purchaser() || warehouse();
    }

    function canManageEquipment() {
      return admin() || engineer();
    }

    function salesCode() {
      return active() && userDoc().data.salesCode != null
        ? userDoc().data.salesCode
        : (active() && userDoc().data.code != null ? userDoc().data.code : null);
    }

    function owns(data) {
      return active() && (
        (data.ownerUid != null && data.ownerUid == request.auth.uid) ||
        (salesCode() != null && data.salesCode != null && data.salesCode == salesCode())
      );
    }

    function validSalesOwner(data) {
      return data.ownerUid != null
        && data.salesCode != null
        && exists(/databases/$(database)/documents/users/$(data.ownerUid))
        && get(/databases/$(database)/documents/users/$(data.ownerUid)).data.role == 'sales'
        && get(/databases/$(database)/documents/users/$(data.ownerUid)).data.get(
          'salesCode',
          get(/databases/$(database)/documents/users/$(data.ownerUid)).data.get('code', null)
        ) == data.salesCode;
    }

    function validQuoteOwner(data) {
      return validSalesOwner(data) || (
        data.ownerUid != null
        && data.salesCode != null
        && exists(/databases/$(database)/documents/users/$(data.ownerUid))
        && get(/databases/$(database)/documents/users/$(data.ownerUid)).data.role == 'engineer'
        && get(/databases/$(database)/documents/users/$(data.ownerUid)).data.get(
          'salesCode',
          get(/databases/$(database)/documents/users/$(data.ownerUid)).data.get('code', null)
        ) == data.salesCode
      );
    }

    // Engineer may assist a salesperson with a quote, but only quotes the engineer created.
    // Ownership remains with the salesperson; orders are intentionally not covered here.
    function engineerAssistedSalesQuote(data) {
      return engineer()
        && validSalesOwner(data)
        && data.get('createdByUid', '') == request.auth.uid
        && data.get('createdByRole', '') == 'engineer';
    }

    function validOwnedCommercialCreate(data) {
      return admin() ||
        (commercialDocumentOwner() &&
          data.ownerUid == request.auth.uid &&
          data.salesCode != null &&
          data.salesCode == salesCode()) ||
        (businessAssistant() &&
          validSalesOwner(data) &&
          data.ownerUid != request.auth.uid);
    }

    function sameCommercialOwner() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.salesCode == resource.data.salesCode;
    }

    function sameSupplyIdentity() {
      return request.resource.data.get('type', '') == resource.data.get('type', '')
        && request.resource.data.get('method', '') == resource.data.get('method', '')
        && request.resource.data.get('sourceType', '') == resource.data.get('sourceType', '')
        && request.resource.data.get('sourceId', '') == resource.data.get('sourceId', '')
        && request.resource.data.get('sourceItemId', '') == resource.data.get('sourceItemId', '')
        && request.resource.data.get('internalNo', '') == resource.data.get('internalNo', '')
        && request.resource.data.get('purchaseDocumentId', '') == resource.data.get('purchaseDocumentId', '')
        && request.resource.data.get('purchaseDocumentNo', '') == resource.data.get('purchaseDocumentNo', '')
        && request.resource.data.get('orderId', '') == resource.data.get('orderId', '')
        && request.resource.data.get('itemId', '') == resource.data.get('itemId', '')
        && request.resource.data.get('orderItemIndex', 0) == resource.data.get('orderItemIndex', 0)
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && request.resource.data.get('salesCode', '') == resource.data.get('salesCode', '')
        && request.resource.data.get('salesName', '') == resource.data.get('salesName', '')
        && request.resource.data.get('customerName', '') == resource.data.get('customerName', '')
        && request.resource.data.get('company', '') == resource.data.get('company', '')
        && request.resource.data.get('productId', '') == resource.data.get('productId', '')
        && request.resource.data.get('productKey', '') == resource.data.get('productKey', '')
        && request.resource.data.get('itemCode', '') == resource.data.get('itemCode', '')
        && request.resource.data.get('itemName', '') == resource.data.get('itemName', '')
        && request.resource.data.get('brand', '') == resource.data.get('brand', '')
        && request.resource.data.get('productLine', '') == resource.data.get('productLine', '')
        && request.resource.data.get('fulfillmentType', 'WAREHOUSE') == resource.data.get('fulfillmentType', 'WAREHOUSE')
        && request.resource.data.get('warehouseId', '') == resource.data.get('warehouseId', '')
        && request.resource.data.get('orderDate', '') == resource.data.get('orderDate', '')
        && request.resource.data.get('createdAt', '') == resource.data.get('createdAt', '')
        && request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '')
        && request.resource.data.get('createdByRole', '') == resource.data.get('createdByRole', '');
    }

    function validSupplyOperationalState() {
      return resource.data.get('status', 'ORDERED') != 'CANCELLED'
        && request.resource.data.get('qty', 0) is number
        && request.resource.data.get('receivedQty', 0) is number
        && request.resource.data.get('incomingRegisteredQty', 0) is number
        && request.resource.data.get('cancelledQty', 0) is number
        && request.resource.data.get('qty', 0) >= resource.data.get('qty', 0)
        && request.resource.data.get('receivedQty', 0) >= resource.data.get('receivedQty', 0)
        && request.resource.data.get('receivedQty', 0) <= request.resource.data.get('qty', 0)
        && request.resource.data.get('incomingRegisteredQty', 0) >= 0
        && request.resource.data.get('incomingRegisteredQty', 0) <= (
          request.resource.data.get('qty', 0) - request.resource.data.get('receivedQty', 0)
        )
        && (
          request.resource.data.get('fulfillmentType', 'WAREHOUSE') != 'DIRECT_SHIP'
          || request.resource.data.get('incomingRegisteredQty', 0) == 0
        )
        && request.resource.data.get('cancelledQty', 0) >= 0
        && request.resource.data.get('cancelledQty', 0) <= (
          request.resource.data.get('qty', 0) - request.resource.data.get('receivedQty', 0)
        )
        && (
          (
            request.resource.data.get('status', 'ORDERED') == 'ORDERED'
            && request.resource.data.get('receivedQty', 0) == 0
            && request.resource.data.get('cancelledQty', 0) == 0
          )
          || (
            request.resource.data.get('status', 'ORDERED') == 'PARTIAL_RECEIPT'
            && request.resource.data.get('receivedQty', 0) > 0
            && request.resource.data.get('receivedQty', 0) < request.resource.data.get('qty', 0)
            && request.resource.data.get('cancelledQty', 0) == 0
          )
          || (
            request.resource.data.get('status', 'ORDERED') == 'RECEIVED'
            && request.resource.data.get('qty', 0) > 0
            && request.resource.data.get('receivedQty', 0) == request.resource.data.get('qty', 0)
            && request.resource.data.get('cancelledQty', 0) == 0
          )
          || (
            request.resource.data.get('status', 'ORDERED') == 'CANCELLED'
            && request.resource.data.get('qty', 0) > request.resource.data.get('receivedQty', 0)
            && request.resource.data.get('cancelledQty', 0)
              == request.resource.data.get('qty', 0) - request.resource.data.get('receivedQty', 0)
            && request.resource.data.get('incomingRegisteredQty', 0) == 0
            && request.resource.data.get('cancelReason', '') != ''
            && request.resource.data.get('cancelledAt', '') != ''
            && request.resource.data.get('cancelledByUid', '') == request.auth.uid
          )
        );
    }

    // Direct-ship receiving is a narrow hot path used in the same atomic batch as
    // the order delivery summary. Keep it intentionally small so the combined
    // Firestore Rules evaluation stays below the platform expression limit.
    function directShipSupplyReceiptUpdate() {
      let nextReceived = request.resource.data.get('receivedQty', 0);
      let qty = resource.data.get('qty', 0);
      return directShipReceiver()
        && resource.data.get('fulfillmentType', 'WAREHOUSE') == 'DIRECT_SHIP'
        && resource.data.get('status', 'ORDERED') != 'CANCELLED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receivedQty', 'status', 'updatedAt'
        ])
        && nextReceived is number
        && nextReceived > resource.data.get('receivedQty', 0)
        && nextReceived <= qty
        && resource.data.get('incomingRegisteredQty', 0) == 0
        && resource.data.get('cancelledQty', 0) == 0
        && (
          (nextReceived < qty && request.resource.data.get('status', '') == 'PARTIAL_RECEIPT')
          || (nextReceived == qty && request.resource.data.get('status', '') == 'RECEIVED')
        );
    }

    function purchaserSupplyOperationalUpdate() {
      // affectedKeys 的白名單已禁止修改任何供應紀錄身分欄位；
      // 不再逐欄重複比對同一批 identity，降低 Firestore Rules 表達式用量。
      return purchaser()
        && validSupplyOperationalState()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'qty', 'receivedQty',
          'incomingRegisteredQty', 'incomingRegisteredAt',
          'status', 'supplier', 'unitCost',
          'lastOrderedAt', 'orderEvents',
          'cancelledQty', 'cancelReason', 'cancelledAt', 'cancelledByUid', 'cancelledBy',
          'updatedAt'
        ]);
    }

    function warehouseSupplyOperationalUpdate() {
      return warehouse()
        && validSupplyOperationalState()
        && request.resource.data.get('status', 'ORDERED') != 'CANCELLED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receivedQty', 'incomingRegisteredQty', 'status', 'updatedAt'
        ]);
    }

    // Creator identity is an audit field. Legacy documents without creator metadata
    // remain editable; once present, normal workflow edits cannot rewrite it.
    function preservesCreator() {
      return resource.data.get('createdByUid', '') == ''
        ? (
          request.resource.data.get('createdByUid', '') == ''
          && request.resource.data.get('createdByName', '') == ''
          && request.resource.data.get('createdByRole', '') == ''
        )
        : (
          request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
          && request.resource.data.get('createdByName', '') == resource.data.get('createdByName', '')
          && request.resource.data.get('createdByRole', '') == resource.data.get('createdByRole', '')
        );
    }

    function directShipReceiptOrderUpdate(orderId) {
      let beforeRecords = resource.data.get('deliveryRecords', []);
      let afterRecords = request.resource.data.get('deliveryRecords', []);
      return directShipReceiver()
        && afterRecords.size() == beforeRecords.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'itemCount', 'orderSchemaVersion',
          'deliveryRecords', 'deliveredQty', 'isDelivered',
          'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ])
        && directShipReceiptOrderEvidence(orderId);
    }

    function directShipReceiptOrderEvidence(orderId) {
      let beforeRecords = resource.data.get('deliveryRecords', []);
      let afterRecords = request.resource.data.get('deliveryRecords', []);
      let newRecord = afterRecords[beforeRecords.size()];
      let supplyId = newRecord.get('sourceId', '');
      let supplyPath = /databases/$(database)/documents/supplyOrders/$(supplyId);
      let supplyBefore = get(supplyPath).data;
      let supplyAfter = getAfter(supplyPath).data;
      return afterRecords.hasAll(beforeRecords)
        && !beforeRecords.hasAny([newRecord])
        && newRecord.get('sourceType', '') == 'DIRECT_SHIP_RECEIPT'
        && newRecord.get('qty', 0) is number
        && newRecord.get('qty', 0) > 0
        && supplyBefore.get('orderId', '') == orderId
        && supplyBefore.get('itemId', '') == newRecord.get('itemId', '')
        && supplyBefore.get('fulfillmentType', 'WAREHOUSE') == 'DIRECT_SHIP'
        && supplyAfter.get('receivedQty', 0) == supplyBefore.get('receivedQty', 0) + newRecord.get('qty', 0)
        && supplyAfter.get('receivedQty', 0) <= supplyBefore.get('qty', 0);
    }

    function purchaserOrderWorkflowUpdate() {
      return purchaser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'itemCount', 'orderSchemaVersion',
          'purchaseOrderNo', 'purchaseOrderNos', 'purchaseOrderedQty', 'purchaseStatus',
          'linkedDocuments',
          'costPrice', 'transactionType', 'invoiceTitle', 'remarks', 'invoiceDate', 'fieldEditHistory',
          'inventoryReservationStatus', 'inventoryReservationError', 'inventoryReservationUpdatedAt',
          'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ])
        && sameCommercialOwner();
    }

    function warehouseOrderWorkflowUpdate() {
      return warehouse()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'itemCount', 'orderSchemaVersion',
          'inventoryReservedQty', 'inventoryShortageQty',
          'receivedQty',
          'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ])
        && sameCommercialOwner();
    }

    function productPath(id) {
      return /databases/$(database)/documents/products/$(id);
    }

    function businessTemporaryProduct(id, data) {
      return businessOwner()
        && data.get('productId', '') == id
        && data.get('status', '') == 'TEMPORARY'
        && data.get('active', false) == true
        && data.get('source', '') == 'QUICK_CREATE'
        && data.get('createdBy', '') == request.auth.uid
        && data.get('updatedBy', '') == request.auth.uid
        && data.get('listPrice', -1) is number
        && data.listPrice >= 0
        && data.keys().hasOnly([
          'productId', 'brandId', 'brandName', 'manufacturerPartNo',
          'normalizedPartNo', 'productName', 'nameEn', 'specification',
          'productLine', 'productLineId', 'category', 'productType', 'supplier',
          'listPrice', 'status', 'active', 'source', 'createdAt',
          'createdBy', 'updatedAt', 'updatedBy'
        ]);
    }



    function nonNegativeInventory(data) {
      return data.onHand >= 0 && data.reserved >= 0;
    }

    // Client-side delivery/reservation transactions need narrowly-scoped stock writes.
    // Business owners cannot alter product identity, cost, incoming quantities or master data.
    function businessInventoryOperationalUpdate() {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'onHand', 'reserved', 'updatedAt'
        ])
        && nonNegativeInventory(request.resource.data);
    }

    function businessReservationOperationalUpdate() {
      return businessOwner()
        && owns(resource.data)
        && owns(request.resource.data)
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && request.resource.data.get('salesCode', '') == resource.data.get('salesCode', '')
        && request.resource.data.get('orderId', '') == resource.data.get('orderId', '')
        && request.resource.data.get('itemId', '') == resource.data.get('itemId', '')
        && request.resource.data.get('productKey', '') == resource.data.get('productKey', '')
        && request.resource.data.get('warehouseId', '') == resource.data.get('warehouseId', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity', 'shortageQty', 'status', 'updatedAt'
        ])
        && request.resource.data.get('quantity', 0) >= 0
        && request.resource.data.get('shortageQty', 0) >= 0;
    }

    function businessInventoryLotOperationalUpdate() {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'remainingQty', 'updatedAt'
        ])
        && request.resource.data.remainingQty >= 0;
    }

    function businessWarehouseStockOperationalUpdate() {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'onHand', 'reserved', 'updatedAt'
        ])
        && nonNegativeInventory(request.resource.data);
    }

    match /users/{id} {
      allow read: if signedIn() && (id == request.auth.uid || active());
      allow create, update: if admin();
      allow delete: if false;
    }

    match /settings/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /brands/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /productLines/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /salesCodes/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /customers/{id} {
      allow read: if active();
      allow create, update: if admin() || businessOwner() || businessAssistant();
      allow delete: if false;
    }

    match /suppliers/{id} {
      allow read: if active();
      allow create, update: if canPurchase();
      allow delete: if false;
    }

    match /brandSupplierMappings/{id} {
      allow read: if active();
      allow create, update: if canPurchase();
      allow delete: if false;
    }

    match /warehouses/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    // Searchable product master. Cost is intentionally stored separately.
    match /products/{id} {
      allow read: if active();
      allow create: if admin() || purchaser() || businessTemporaryProduct(id, request.resource.data);
      allow update: if admin() || purchaser();
      allow delete: if false;
    }

    // 公司標準產品成本只提供採購／管理員；業務自行調貨成本存在自己的訂單交易中。
    match /productCosts/{id} {
      allow read: if admin() || purchaser();
      allow create, update: if admin() || purchaser();
      allow delete: if false;
    }

    match /priceHistory/{id} {
      allow read, create: if admin() || purchaser();
      allow update, delete: if false;
    }

    match /quotes/{id} {
      allow read: if admin() || purchaser() || owns(resource.data)
        || engineerAssistedSalesQuote(resource.data);
      allow create: if canCreateCommercialDoc() && (
        validOwnedCommercialCreate(request.resource.data)
        || engineerAssistedSalesQuote(request.resource.data)
        || (purchaser() && validQuoteOwner(request.resource.data)
          && request.resource.data.ownerUid != request.auth.uid)
      );
      allow update: if admin()
        || (commercialDocumentOwner() && owns(resource.data) && owns(request.resource.data) && sameCommercialOwner() && preservesCreator())
        || (engineerAssistedSalesQuote(resource.data) && sameCommercialOwner() && preservesCreator())
        || (purchaser() && sameCommercialOwner() && preservesCreator());
      allow delete: if admin();
    }

    match /forecasts/{id} {
      allow read: if admin() || (sales() && owns(resource.data));
      allow create: if (admin() || sales()) && validOwnedCommercialCreate(request.resource.data);
      allow update: if admin()
        || (sales() && owns(resource.data) && owns(request.resource.data) && sameCommercialOwner() && preservesCreator());
      allow delete: if admin();
    }

    match /forecasts/{forecastId}/progress/{progressId} {
      function parentForecast() {
        return get(/databases/$(database)/documents/forecasts/$(forecastId));
      }
      allow read: if admin() || (sales() && owns(parentForecast().data));
      allow create: if admin() || (sales() && owns(parentForecast().data));
      allow update: if false;
      allow delete: if admin();
    }

    function validNewOrderProductMaster(data) {
      let productId = data.get('productId', '');
      return data.get('productMasterMatched', false) == true
        && productId != ''
        && exists(productPath(productId));
    }

    function validOrderEmbeddedCost(data) {
      return !data.keys().hasAny(['costPrice'])
        || data.get('procurementType', '') == 'SALES_SELF_ORDER';
    }

    function validCommercialOrderCostUpdate() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['costPrice', 'costSource'])
        || request.resource.data.get('procurementType', '') == 'SALES_SELF_ORDER';
    }

    match /orders/{id} {
      allow read: if admin() || purchaser() || warehouse() || owns(resource.data);
      allow create: if canCreateCommercialDoc()
        && validOwnedCommercialCreate(request.resource.data)
        && validNewOrderProductMaster(request.resource.data)
        && validOrderEmbeddedCost(request.resource.data);
      // Commercial owner edits commercial data; purchaser/warehouse must use scoped
      // workflow collections below instead of broad order mutation.
      allow update: if admin()
        || directShipReceiptOrderUpdate(id)
        || (commercialDocumentOwner() && owns(resource.data) && owns(request.resource.data)
          && sameCommercialOwner() && preservesCreator() && validCommercialOrderCostUpdate())
        || purchaserOrderWorkflowUpdate()
        || warehouseOrderWorkflowUpdate();
      allow delete: if admin();
    }

    // Formal supplier PO. Sales/engineer self-order does NOT grant purchase-order privilege.
    match /purchaseOrders/{id} {
      allow read: if admin() || purchaser() || warehouse();
      allow create: if canPurchase();
      // The PO is an immutable document snapshot for warehouse users. Receiving
      // progress belongs to supplyOrders and receipts, never back on the PO.
      allow update: if canPurchase();
      allow delete: if admin();
    }

    // ERP-style communication timeline. Browser share/mailto can prove only that
    // the handoff was prepared, not that an email was actually delivered.
    match /purchaseOrderCommunications/{id} {
      allow read: if admin() || purchaser();
      allow create: if canPurchase()
        && request.resource.data.get('purchaseOrderId', '') != ''
        && request.resource.data.get('createdByUid', '') == request.auth.uid
        && request.resource.data.get('state', '') == 'PREPARED'
        && request.resource.data.get('verifiedSent', true) == false;
      allow update: if false;
      allow delete: if admin();
    }

    // Unified source/order evidence: PURCHASING_PO, PURCHASING_MANUAL, SALES_SELF_ORDER, STOCK_REPLENISHMENT.
    match /supplyOrders/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner()
          && resource.data.type == 'SALES_SELF_ORDER'
          && resource.data.ownerUid == request.auth.uid);
      allow create: if admin() || purchaser()
        || (businessOwner()
          && request.resource.data.type == 'SALES_SELF_ORDER'
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.salesCode == salesCode());
      // Sales owns the commercial intent and may create/read its own self-order,
      // but supply execution becomes operational evidence after creation. Only purchasing
      // or receiving roles may mutate quantities/status; this prevents direct API edits
      // from bypassing procurement and receipt workflows.
      allow update: if admin()
        || directShipSupplyReceiptUpdate()
        || purchaserSupplyOperationalUpdate()
        || warehouseSupplyOperationalUpdate();
      allow delete: if admin();
    }

    match /inventory/{id} {
      // Aggregate operational stock is shared, but cost fields must never be embedded here.
      allow get: if admin() || (active() && !('unitCost' in resource.data) && !('cost' in resource.data));
      allow list: if canReceiveInventory() && !('unitCost' in resource.data) && !('cost' in resource.data);
      allow create: if canReceiveInventory() && nonNegativeInventory(request.resource.data)
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow update: if ((canReceiveInventory() && nonNegativeInventory(request.resource.data))
          || businessInventoryOperationalUpdate())
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow delete: if false;
    }

    match /warehouseStocks/{id} {
      allow read: if admin() || (active() && !('unitCost' in resource.data) && !('cost' in resource.data));
      allow create: if canReceiveInventory() && nonNegativeInventory(request.resource.data)
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow update: if ((canReceiveInventory() && nonNegativeInventory(request.resource.data))
          || businessWarehouseStockOperationalUpdate())
        && !('unitCost' in request.resource.data) && !('cost' in request.resource.data);
      allow delete: if false;
    }

    match /inventoryReservations/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(request.resource.data));
      allow update: if admin() || purchaser() || warehouse()
        || businessReservationOperationalUpdate();
      allow delete: if admin();
    }

    match /inventoryLots/{id} {
      // Operational lot data is readable for fulfillment, but cost must never live here.
      allow read: if admin() || purchaser() || warehouse() || (businessOwner() && !('unitCost' in resource.data));
      allow create: if canReceiveInventory() && !('unitCost' in request.resource.data);
      allow update: if (canReceiveInventory() || businessInventoryLotOperationalUpdate())
        && !('unitCost' in request.resource.data);
      allow delete: if admin();
    }

    // Actual receipt/lot cost is physically separated from operational lot data.
    // Client-side fulfillment never requires this collection.
    match /inventoryLotCosts/{id} {
      allow read: if admin() || purchaser();
      allow create: if canReceiveInventory();
      allow update: if admin() || purchaser();
      allow delete: if admin();
    }

    match /receipts/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if canReceiveInventory()
        && !('unitCost' in request.resource.data)
        && !('purchaseNetAmount' in request.resource.data);
      // Receipt facts remain immutable. Receiving roles may only advance the
      // post-receipt shortage-allocation checkpoint used for resumable/idempotent retries.
      allow update: if canReceiveInventory()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'autoAllocatedQty', 'allocationCompleted', 'allocationUpdatedAt'
        ])
        && request.resource.data.get('autoAllocatedQty', 0) >= resource.data.get('autoAllocatedQty', 0)
        && request.resource.data.get('autoAllocatedQty', 0) <= resource.data.get('autoAllocationQty', 0);
      allow delete: if admin();
    }

    // Purchaser records completion of the company's existing shipping paperwork.
    match /dispatchRecords/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if admin() || purchaser();
      allow update: if false;
      allow delete: if admin();
    }

    // Physical delivery is recorded by the responsible business owner.
    match /deliveries/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if admin()
        || (businessOwner() && owns(request.resource.data));
      allow update: if false;
      allow delete: if admin();
    }

    match /pendingInventoryItems/{id} {
      allow read: if admin() || purchaser() || warehouse();
      allow create, update: if admin() || purchaser() || warehouse();
      allow delete: if admin();
    }

    // Immutable stock ledger.
    match /inventoryMovements/{id} {
      allow read: if admin() || purchaser() || warehouse()
        || (businessOwner() && owns(resource.data));
      allow create: if (admin() || purchaser() || warehouse()
        || (businessOwner() && owns(request.resource.data)))
        && !('unitCost' in request.resource.data)
        && !('purchaseNetAmount' in request.resource.data)
        && !('cogs' in request.resource.data);
      allow update: if false;
      allow delete: if admin();
    }

    // Immutable operational audit trail.
    match /auditLogs/{id} {
      allow read: if admin() || (active() && resource.data.actorUid == request.auth.uid);
      allow create: if active() && request.resource.data.actorUid == request.auth.uid;
      allow update: if false;
      allow delete: if admin();
    }

    match /equipment/{id} {
      allow read: if admin() || engineer() || (businessOwner() && owns(resource.data));
      allow create: if admin() || engineer()
        || (sales() && owns(request.resource.data));
      allow update: if admin() || engineer()
        || (sales() && owns(resource.data) && owns(request.resource.data));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}