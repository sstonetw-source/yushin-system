rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userDoc() {
      return get(userPath());
    }

    function profileEnabled(data) {
      return data.get('active', true) == true && data.get('disabled', false) != true;
    }
    function active() {
      return signedIn() && profileEnabled(userDoc().data);
    }
    function role() {
      return signedIn() ? enabledRole(userDoc().data) : null;
    }
    function enabledRole(data) {
      return profileEnabled(data) ? data.get('role', null) : null;
    }

    function admin() { return role() == 'admin'; }
    function sales() { return role() == 'sales'; }
    function engineer() { return role() == 'engineer'; }
    function purchaser() { return role() == 'purchaser'; }
    function warehouse() { return role() == 'warehouse'; }
    // Customer arrival is a commercial fact, not a warehouse receipt.
    function directShipReceiver() {
      let userRole = role();
      return userRole == 'admin' || (userRole in ['sales', 'engineer'] && resource.data.get('ownerUid', '') == request.auth.uid);
    }

    // Sales and engineers own their own commercial and fulfillment records.
    function businessOwner() {
      return role() in ['sales', 'engineer'];
    }

    function commercialDocumentOwner() {
      return businessOwner();
    }

    function businessAssistant() {
      return purchaser();
    }

    function canCreateCommercialDoc() {
      return admin() || commercialDocumentOwner() || businessAssistant();
    }

    function canPurchase() {
      return admin() || purchaser();
    }

    function canReceiveInventory() {
      return role() in ['admin', 'purchaser', 'warehouse'];
    }

    function canManageEquipment() {
      return admin() || engineer();
    }

    function salesCode() {
      let data = userDoc().data;
      return profileEnabled(data) ? data.get('salesCode', data.get('code', null)) : null;
    }

    function owns(data) {
      let ownerUid = data.get('ownerUid', '');
      let ownerSalesCode = data.get('salesCode', '');
      return active() && (
        (ownerUid != '' && ownerUid == request.auth.uid) ||
        (salesCode() != null && ownerSalesCode != '' && ownerSalesCode == salesCode())
      );
    }

    // Evaluate the fixed role once per document read; nested role predicates
    // consumed the transaction expression budget when discovering another warehouse.
    function operationalOrOwnedReader(data) {
      let userRole = role();
      return userRole in ['admin','purchaser','warehouse']
        || (userRole in ['sales','engineer'] && owns(data));
    }
    function safeStockReader(data) {
      let profile = signedIn() ? userDoc().data : {};
      return signedIn() && profileEnabled(profile)
        && (profile.get('role', '') == 'admin' || !data.keys().hasAny(['unitCost','cost']));
    }

    function validSalesOwner(data) {
      return validQuoteOwner(data)
        && get(/databases/$(database)/documents/users/$(data.ownerUid)).data.role == 'sales';
    }

    // Both quotes and customer orders may belong to an active salesperson or engineer.
    // Purchaser assistance preserves the owner; creator fields retain the actual operator.
    function validQuoteOwner(data) {
      return data.get('ownerUid', '') is string && data.get('ownerUid', '').size() > 0
        && data.get('salesCode', '') is string && data.get('salesCode', '').size() > 0
        && exists(/databases/$(database)/documents/users/$(data.ownerUid))
        && profileEnabled(get(/databases/$(database)/documents/users/$(data.ownerUid)).data)
        && get(/databases/$(database)/documents/users/$(data.ownerUid)).data.role in ['sales', 'engineer']
        && get(/databases/$(database)/documents/users/$(data.ownerUid)).data.get(
          'salesCode',
          get(/databases/$(database)/documents/users/$(data.ownerUid)).data.get('code', null)
        ) == data.salesCode;
    }

    // Engineer may assist a salesperson with a quote, but only quotes the engineer created.
    // Ownership remains with the salesperson; orders are intentionally not covered here.
    function engineerAssistedSalesQuote(data) {
      return engineer()
        && data.get('createdByUid', '') == request.auth.uid
        && data.get('createdByRole', '') == 'engineer';
    }

    function validOwnedCommercialCreate(data) {
      return admin() ||
        (commercialDocumentOwner() &&
          data.ownerUid == request.auth.uid &&
          data.salesCode != null &&
          data.salesCode == salesCode()) ||
        (businessAssistant() &&
          validQuoteOwner(data) &&
          data.ownerUid != request.auth.uid);
    }

    function sameCommercialOwner() {
      return request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.salesCode == resource.data.salesCode;
    }

    function sameSupplyIdentity() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'type', 'method', 'sourceType', 'sourceId', 'sourceItemId',
        'internalNo', 'purchaseDocumentId', 'purchaseDocumentNo',
        'orderId', 'itemId', 'orderItemIndex',
        'ownerUid', 'salesCode', 'salesName', 'customerName', 'company',
        'productId', 'productKey', 'itemCode', 'itemName', 'brand', 'productLine',
        'fulfillmentType', 'warehouseId', 'orderDate',
        'createdAt', 'createdByUid', 'createdBy', 'createdByRole'
      ]);
    }

    function validSupplyOperationalState() {
      let previousStatus = resource.data.get('status', 'ORDERED');
      let nextStatus = request.resource.data.get('status', 'ORDERED');
      let qty = request.resource.data.get('qty', 0);
      let receivedQty = request.resource.data.get('receivedQty', 0);
      let cancelledQty = request.resource.data.get('cancelledQty', 0);
      let closedQty = request.resource.data.get('closedQty', 0);
      let incomingQty = request.resource.data.get('incomingRegisteredQty', 0);
      return previousStatus != 'CANCELLED'
        && previousStatus != 'CLOSED'
        && qty is number
        && receivedQty is number
        && incomingQty is number
        && cancelledQty is number
        && closedQty is number
        && qty >= resource.data.get('qty', 0)
        && receivedQty >= resource.data.get('receivedQty', 0)
        && receivedQty <= qty
        && incomingQty >= 0
        && incomingQty <= (qty - receivedQty)
        && (
          request.resource.data.get('fulfillmentType', 'WAREHOUSE') != 'DIRECT_SHIP'
          || incomingQty == 0
        )
        && cancelledQty >= 0
        && cancelledQty <= (qty - receivedQty)
        && closedQty >= 0
        && closedQty <= (qty - receivedQty)
        && (
          (
            nextStatus == 'ORDERED'
            && receivedQty == 0
            && cancelledQty == 0
            && closedQty == 0
          )
          || (
            nextStatus == 'PARTIAL_RECEIPT'
            && receivedQty > 0
            && receivedQty < qty
            && cancelledQty == 0
            && closedQty == 0
          )
          || (
            nextStatus == 'RECEIVED'
            && qty > 0
            && receivedQty == qty
            && cancelledQty == 0
            && closedQty == 0
          )
          || (
            nextStatus == 'CANCELLED'
            && qty > receivedQty
            && qty == resource.data.get('qty', 0)
            && receivedQty == resource.data.get('receivedQty', 0)
            && cancelledQty == qty - receivedQty
            && closedQty == 0
            && incomingQty == 0
            && request.resource.data.get('cancelReason', '') != ''
            && request.resource.data.get('cancelledAt', '') != ''
            && request.resource.data.get('cancelledByUid', '') == request.auth.uid
          )
          || (
            nextStatus == 'CLOSED'
            && receivedQty > 0
            && receivedQty < qty
            && qty == resource.data.get('qty', 0)
            && receivedQty == resource.data.get('receivedQty', 0)
            && closedQty == qty - receivedQty
            && cancelledQty == 0
            && incomingQty == 0
            && request.resource.data.get('closeReason', '') != ''
            && request.resource.data.get('closedAt', '') != ''
            && request.resource.data.get('closedByUid', '') == request.auth.uid
          )
        );
    }

    // Direct-ship receiving is a narrow hot path used in the same atomic batch as
    // the order delivery summary. Keep it intentionally small so the combined
    // Firestore Rules evaluation stays below the platform expression limit.
    function directShipSupplyReceiptUpdate(id, userRole) {
      let nextReceived = request.resource.data.get('receivedQty', 0);
      let qty = resource.data.get('qty', 0);
      return userRole in ['sales','engineer'] && resource.data.get('ownerUid', '') == request.auth.uid
        && resource.data.get('fulfillmentType', 'WAREHOUSE') == 'DIRECT_SHIP'
        && directShipSupplyReceiptEvidence(id)
        && resource.data.get('status', 'ORDERED') != 'CANCELLED'
        && resource.data.get('status', 'ORDERED') != 'CLOSED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receivedQty', 'status', 'updatedAt'
        ])
        && nextReceived is number
        && nextReceived > resource.data.get('receivedQty', 0)
        && nextReceived <= qty
        && resource.data.get('incomingRegisteredQty', 0) == 0
        && resource.data.get('cancelledQty', 0) == 0
        && resource.data.get('closedQty', 0) == 0
        && (
          (nextReceived < qty && request.resource.data.get('status', '') == 'PARTIAL_RECEIPT')
          || (nextReceived == qty && request.resource.data.get('status', '') == 'RECEIVED')
        );
    }

    function directShipSupplyReceiptEvidence(id) {
      let orderPath = /databases/$(database)/documents/orders/$(resource.data.orderId);
      let before = get(orderPath).data;
      let after = getAfter(orderPath).data;
      let records = after.get('deliveryRecords', []);
      let record = records[before.get('deliveryRecords', []).size()];
      let receiptPath = /databases/$(database)/documents/receipts/$(record.receiptId);
      let receipt = getAfter(receiptPath).data;
      return !orderIsCancelled(before)
        && resource.data.ownerUid == before.ownerUid
        && records.size() == before.get('deliveryRecords', []).size() + 1
        && record.sourceType == 'DIRECT_SHIP_RECEIPT' && record.sourceId == id
        && !exists(receiptPath) && receipt.supplyOrderId == id
        && receipt.qty == request.resource.data.receivedQty - resource.data.get('receivedQty', 0)
        && record.qty == receipt.qty;
    }

    function purchaserSupplyOperationalUpdate(userRole) {
      // Supply identity is immutable; purchasing may only change operational progress.
      return userRole == 'purchaser'
        && (resource.data.get('fulfillmentType', 'WAREHOUSE') != 'DIRECT_SHIP'
          || request.resource.data.get('receivedQty', 0) == resource.data.get('receivedQty', 0))
        && sameSupplyIdentity()
        && (resource.data.get('receivedQty', 0) == 0 || request.resource.data.get('unitCost', 0) == resource.data.get('unitCost', 0))
        && validSupplyOperationalState()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'qty', 'receivedQty',
          'incomingRegisteredQty', 'incomingRegisteredAt',
          'status', 'supplier', 'unitCost',
          'lastOrderedAt', 'orderEvents',
          'cancelledQty', 'cancelReason', 'cancelledAt', 'cancelledByUid', 'cancelledBy',
          'closedQty', 'closeReason', 'closedAt', 'closedByUid', 'closedBy',
          'updatedAt'
        ]);
    }

    // Current orders use status=active. Match normalizedOrderStatus: either
    // cancellation field blocks receipt until purchasing explicitly keeps stock.
    function orderIsCancelled(data) {
      return data.get('status', '') in ['cancelled', 'voided']
        || data.get('orderStatus', '') in ['cancelled', 'voided'];
    }

    function supplierReceiptDispositionAllowed() {
      let before = resource.data;
      let after = request.resource.data;
      let orderId = before.get('orderId', '');
      return after.get('receivedQty', 0) <= before.get('receivedQty', 0) || orderId == ''
        || !orderIsCancelled(get(/databases/$(database)/documents/orders/$(orderId)).data)
        || before.get('customerCancellationDisposition', '') == 'KEEP_STOCK';
    }

    function warehouseSupplyOperationalUpdate(userRole) {
      return userRole == 'warehouse'
        && resource.data.get('fulfillmentType', 'WAREHOUSE') != 'DIRECT_SHIP'
        && sameSupplyIdentity()
        && validSupplyOperationalState()
        && request.resource.data.get('status', 'ORDERED') != 'CANCELLED'
        && request.resource.data.get('status', 'ORDERED') != 'CLOSED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receivedQty', 'incomingRegisteredQty', 'status', 'updatedAt'
        ]);
    }

    // Creator identity is an audit field. Legacy documents without creator metadata
    // remain editable; once present, normal workflow edits cannot rewrite it.
    function preservesCreator() {
      return resource.data.get('createdByUid', '') == ''
        ? (
          request.resource.data.get('createdByUid', '') == ''
          && request.resource.data.get('createdByName', '') == ''
          && request.resource.data.get('createdByRole', '') == ''
        )
        : (
          request.resource.data.get('createdByUid', '') == resource.data.get('createdByUid', '')
          && request.resource.data.get('createdByName', '') == resource.data.get('createdByName', '')
          && request.resource.data.get('createdByRole', '') == resource.data.get('createdByRole', '')
        );
    }

    function directShipReceiptOrderUpdate(orderId) {
      let beforeRecords = resource.data.get('deliveryRecords', []);
      let afterRecords = request.resource.data.get('deliveryRecords', []);
      return directShipReceiver()
        && afterRecords.size() == beforeRecords.size() + 1
        && operationalItemsOnly(['orderedQty', 'reservedQty', 'shortageQty', 'receivedQty', 'deliveredQty', 'directShipDeliveredQty', 'receiptEvents', 'reservationStatus', 'inventoryProductKey'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'itemCount', 'orderSchemaVersion',
          'deliveryRecords', 'deliveredQty', 'isDelivered',
          'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ])
        && directShipReceiptOrderEvidence(orderId);
    }

    function directShipReceiptOrderEvidence(orderId) {
      let beforeRecords = resource.data.get('deliveryRecords', []);
      let afterRecords = request.resource.data.get('deliveryRecords', []);
      let newRecord = afterRecords[beforeRecords.size()];
      let supplyId = newRecord.get('sourceId', '');
      let supplyPath = /databases/$(database)/documents/supplyOrders/$(supplyId);
      let supplyBefore = get(supplyPath).data;
      let supplyAfter = getAfter(supplyPath).data;
      let index = newRecord.get('itemIndex', -1);
      let beforeItem = resource.data.items[index];
      let afterItem = request.resource.data.items[index];
      return afterRecords.hasAll(beforeRecords)
        && !beforeRecords.hasAny([newRecord])
        && newRecord.get('sourceType', '') == 'DIRECT_SHIP_RECEIPT'
        && newRecord.get('qty', 0) is number
        && newRecord.get('qty', 0) > 0
        && supplyBefore.get('orderId', '') == orderId
        && supplyBefore.get('itemId', '') == newRecord.get('itemId', '')
        && supplyBefore.get('fulfillmentType', 'WAREHOUSE') == 'DIRECT_SHIP'
        && supplyBefore.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && index is int && index >= 0 && index < resource.data.items.size()
        && beforeItem.itemId == newRecord.itemId && beforeItem.get('fulfillmentType', '') == 'DIRECT_SHIP'
        && request.resource.data.items.removeAll([afterItem]) == resource.data.items.removeAll([beforeItem])
        && afterItem.get('receivedQty', 0) == beforeItem.get('receivedQty', 0) + newRecord.qty
        && afterItem.get('deliveredQty', 0) == beforeItem.get('deliveredQty', 0) + newRecord.qty
        && request.resource.data.get('deliveredQty', 0) == resource.data.get('deliveredQty', 0) + newRecord.qty
        && supplyAfter.get('receivedQty', 0) == supplyBefore.get('receivedQty', 0) + newRecord.get('qty', 0)
        && supplyAfter.get('receivedQty', 0) <= supplyBefore.get('qty', 0);
    }

    // Rules cannot iterate lists; keep this bounded to stay below the evaluator limit.
    // Larger operational item changes require an administrator.
    function operationalItemsOnly(allowed) {
      let before = resource.data.get('items', []);
      let after = request.resource.data.get('items', []);
      return before == after || (before.size() == after.size() && before.size() <= 15
        && (before.size() <= 0 || after[0].diff(before[0]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 1 || after[1].diff(before[1]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 2 || after[2].diff(before[2]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 3 || after[3].diff(before[3]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 4 || after[4].diff(before[4]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 5 || after[5].diff(before[5]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 6 || after[6].diff(before[6]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 7 || after[7].diff(before[7]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 8 || after[8].diff(before[8]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 9 || after[9].diff(before[9]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 10 || after[10].diff(before[10]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 11 || after[11].diff(before[11]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 12 || after[12].diff(before[12]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 13 || after[13].diff(before[13]).affectedKeys().hasOnly(allowed))
        && (before.size() <= 14 || after[14].diff(before[14]).affectedKeys().hasOnly(allowed)));
    }
    function purchasingItemFields() {
      return ['orderedQty', 'reservedQty', 'shortageQty', 'dispatchPreparedQty',
        'receivedQty', 'supplyOrderedQty', 'purchaseOrderedQty', 'purchaseOrderNo', 'purchaseOrderNos',
        'purchaseDocumentIds', 'purchaseDocumentNos', 'supplyOrderIds', 'supplyOrders',
        'receiptEvents', 'purchaseEvents', 'reservationStatus', 'reservationError', 'inventoryProductKey',
        'linkedDocuments', 'procurementStatus', 'perOrdered', 'perReceived'];
    }
    function purchaserOrderWorkflowUpdate(id) {
      return purchaser()
        && operationalItemsOnly(purchasingItemFields())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'itemCount', 'orderSchemaVersion',
          'purchaseOrderNo', 'purchaseOrderNos', 'purchaseOrderedQty', 'purchaseStatus',
          'linkedDocuments',
          'costPrice', 'transactionType', 'invoiceTitle', 'remarks', 'billingDate', 'fieldEditHistory',
          'inventoryReservationStatus', 'inventoryReservationError', 'inventoryReservationUpdatedAt', 'inventoryReservationAttemptId',
          'sourceDocumentSyncStatus', 'sourceDocumentSyncError', 'sourceDocumentSyncUpdatedAt',
          'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ])
        && sameCommercialOwner();
    }

    function warehouseOrderWorkflowUpdate() {
      return warehouse()
        && !(resource.data.get('inventoryReservationStatus', '') in ['pending', 'failed'])
        && operationalItemsOnly(['orderedQty', 'reservedQty', 'shortageQty', 'receivedQty', 'receiptEvents', 'reservationStatus', 'inventoryProductKey'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'items', 'itemCount', 'orderSchemaVersion',
          'inventoryReservedQty', 'inventoryShortageQty',
          'receivedQty',
          'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
        ])
        && sameCommercialOwner();
    }

    function productPath(id) {
      return /databases/$(database)/documents/products/$(id);
    }

    function businessTemporaryProduct(id, data) {
      return businessOwner()
        && data.get('productId', '') == id
        && data.get('status', '') == 'TEMPORARY'
        && data.get('active', false) == true
        && data.get('source', '') == 'QUICK_CREATE'
        && data.get('createdBy', '') == request.auth.uid
        && data.get('updatedBy', '') == request.auth.uid
        && data.get('listPrice', -1) is number
        && data.listPrice >= 0
        && data.keys().hasOnly([
          'productId', 'brandId', 'brandName', 'manufacturerPartNo',
          'normalizedPartNo', 'productName', 'nameEn', 'specification',
          'productLine', 'productLineId', 'category', 'productType', 'supplier',
          'listPrice', 'status', 'active', 'source', 'createdAt',
          'createdBy', 'updatedAt', 'updatedBy'
        ]);
    }



    function nonNegativeInventory(data) {
      return data.onHand is number && data.reserved is number
        && data.onHand >= 0 && data.reserved >= 0 && data.reserved <= data.onHand
        && data.get('incoming', 0) is number && data.get('incoming', 0) >= 0;
    }

    // warehouseStocks optional recovery metadata: allocationPending bool;
    // allocationRevision int 1..1e9, advanced only when physical free stock increases.
    function validStockRecoveryMetadata(data) {
      return !data.keys().hasAny(['allocationPending','allocationRevision'])
        || (data.get('allocationPending', null) is bool
          && data.get('allocationRevision', null) is int
          && data.allocationRevision > 0 && data.allocationRevision <= 1000000000);
    }
    function validStockRecoveryUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      let revision = before.get('allocationRevision', 0);
      let next = after.get('allocationRevision', 0);
      let pending = before.get('allocationPending', false);
      let nextPending = after.get('allocationPending', false);
      return (next == revision && pending == nextPending)
        || (next == revision + 1 && nextPending == true
          && after.onHand - after.reserved > before.onHand - before.reserved
          && !(after.warehouseId.matches('custody-.*')))
        || (canReceiveInventory() && pending == true && nextPending == false && next == revision
          && after.diff(before).affectedKeys().hasOnly(['allocationPending']));
    }

    // A warehouse stock row keeps the same physical product/location identity.
    // Moving goods creates/updates another row through the transfer workflow.
    function validWarehouseStock(data) {
      return nonNegativeInventory(data) && validStockRecoveryMetadata(data)
        && data.get('productKey', '') is string && data.get('productKey', '').size() > 0
        && data.get('warehouseId', '') is string && data.get('warehouseId', '').size() > 0
        && data.get('productId', '') is string;
    }

    function warehouseStockIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['productKey', 'warehouseId'])
        && (resource.data.get('productId', '') == ''
          || request.resource.data.get('productId', '') == resource.data.get('productId', ''));
    }

    function inventoryArchiveKeys() {
      return ['listArchived', 'listArchiveChangedAt', 'listArchiveChangedByUid', 'listArchiveAuditId'];
    }

    function validInventoryArchiveChange(id) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(inventoryArchiveKeys()) || validInventoryArchiveOperation(id);
    }

    function validInventoryArchiveOperation(id) {
      let data = request.resource.data;
      let auditId = data.get('listArchiveAuditId', '');
      let auditPath = /databases/$(database)/documents/auditLogs/$(auditId);
      return admin()
        && data.listArchived is bool
        && data.listArchived != resource.data.get('listArchived', false)
        && data.listArchiveChangedByUid == request.auth.uid
        && data.listArchiveChangedAt is string && data.listArchiveChangedAt.size() <= 32
        && auditId is string && auditId.size() > 0 && auditId.size() <= 128
        && data.diff(resource.data).affectedKeys().hasOnly([
          'listArchived', 'listArchiveChangedAt', 'listArchiveChangedByUid', 'listArchiveAuditId', 'updatedAt'
        ])
        && (!data.listArchived || (resource.data.get('onHand', 0) == 0
          && resource.data.get('reserved', 0) == 0 && resource.data.get('incoming', 0) == 0
          && resource.data.get('transferInTransit', 0) == 0))
        && !exists(auditPath)
        && getAfter(auditPath).data.actorUid == request.auth.uid
        && getAfter(auditPath).data.inventoryId == id
        && getAfter(auditPath).data.archived == data.listArchived
        && getAfter(auditPath).data.createdAt == data.listArchiveChangedAt
        && getAfter(auditPath).data.action == (data.listArchived ? 'inventory_list_archive' : 'inventory_list_restore');
    }

    function validInventoryStockPolicy(data) {
      let policy = data.get('stockPolicy', 'ORDER_ONLY');
      let safetyStock = data.get('safetyStock', 0);
      return policy in ['NO_STOCK', 'SAFETY_STOCK', 'ORDER_ONLY']
        && safetyStock is number
        && safetyStock >= 0;
    }

    function warehouseInventoryPlanningDefaults(data) {
      return data.get('stockPolicy', 'ORDER_ONLY') == 'ORDER_ONLY'
        && data.get('safetyStock', 0) == 0;
    }

    function warehouseKeepsInventoryPlanning(userRole) {
      return userRole == 'warehouse'
        && request.resource.data.get('stockPolicy', 'ORDER_ONLY')
          == resource.data.get('stockPolicy', 'ORDER_ONLY')
        && request.resource.data.get('safetyStock', 0)
          == resource.data.get('safetyStock', 0);
    }
    function inventoryUpdateWriter(id) {
      let userRole = role();
      return (userRole in ['admin','purchaser','warehouse']
          && nonNegativeInventory(request.resource.data)
          && validInventoryStockPolicy(request.resource.data)
          && (userRole != 'warehouse' || warehouseKeepsInventoryPlanning(userRole)))
        || businessInventoryOperationalUpdate(id);
    }

    // Client-side delivery/reservation transactions need narrowly-scoped stock writes.
    // Business owners cannot alter product identity, cost, incoming quantities or master data.
    // A commercial stock write must carry a fresh witness linked to its own order,
    // the reservation changed in this transaction, and an immutable stock movement.
    function reservationDelta(op, index) {
      return index < op.reservationIds.size() ? reservationDeltaAt(op, op.reservationIds[index]) : 0;
    }
    function reservationDeltaAt(op, id) {
      let path = /databases/$(database)/documents/inventoryReservations/$(id);
      let before = exists(path) ? get(path).data : {};
      let after = getAfter(path).data;
      return after.get('orderId', '') == op.orderId
        && after.get('productKey', '') == op.productKey
        && (op.warehouseId == '' || after.get('warehouseId', '') == op.warehouseId)
        ? after.get('quantity', 0) - before.get('quantity', 0) : 999999999;
    }
    function validStockOperation(op) {
      let orderPath = /databases/$(database)/documents/orders/$(op.orderId);
      let before = get(orderPath).data;
      let after = getAfter(orderPath).data;
      let deliveryDelta = after.get('returnedQty', 0) - before.get('returnedQty', 0)
        - after.get('deliveredQty', 0) + before.get('deliveredQty', 0);
      let movement = getAfter(/databases/$(database)/documents/inventoryMovements/$(op.sourceMovementId)).data;
      let firstDelta = reservationDelta(op, 0);
      return businessOwner() && op.actorUid == request.auth.uid && owns(before)
        && before.get('ownerUid', '') == after.get('ownerUid', '') && before.get('salesCode', '') == after.get('salesCode', '')
        && op.reservationIds is list && op.reservationIds.size() > 0 && op.reservationIds.size() <= 5
        && op.reservationIds.toSet().size() == op.reservationIds.size()
        && firstDelta != 999999999
        && movement.get('sourceId', '') == op.orderId && movement.get('sourceType', '') == 'order'
        && movement.get('productKey', '') == op.productKey
        && !exists(/databases/$(database)/documents/inventoryMovements/$(op.sourceMovementId))
        && op.qtyDelta is number && op.reservedDelta is number
        && (op.targetPath.matches('inventoryLots/.*')
          ? ((op.qtyDelta > 0 && deliveryDelta >= op.qtyDelta)
            || (op.qtyDelta < 0 && deliveryDelta <= op.qtyDelta)) && op.reservedDelta == 0
          : op.qtyDelta == deliveryDelta
            && (op.reservationIds.size() == 1 ? op.reservedDelta == firstDelta
              : op.reservedDelta == firstDelta + reservationDelta(op, 1)
                + reservationDelta(op, 2) + reservationDelta(op, 3) + reservationDelta(op, 4)));
    }
    function hasStockOperation(targetPath, quantityField, reservedField) {
      let operationId = request.resource.data.get('stockOperationId', '');
      let path = /databases/$(database)/documents/stockOperations/$(operationId);
      let op = getAfter(path).data;
      return operationId != '' && !exists(path)
        && op.actorUid == request.auth.uid && op.targetPath == targetPath
        && op.productKey == resource.data.get('productKey', resource.data.get('productId', ''))
        && op.warehouseId == (targetPath.matches('inventory/.*') ? '' : resource.data.get('warehouseId', ''))
        && op.qtyDelta == request.resource.data.get(quantityField, 0) - resource.data.get(quantityField, 0)
        && (reservedField == '' || op.reservedDelta == request.resource.data.get(reservedField, 0) - resource.data.get(reservedField, 0));
      // The fresh immutable stockOperations document is independently validated on create.
      // Do not repeat its full source/reservation proof for every target in the same transaction.
    }

    function businessInventoryOperationalUpdate(id) {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'onHand', 'reserved', 'updatedAt', 'stockOperationId'
        ])
        && nonNegativeInventory(request.resource.data)
        && hasStockOperation('inventory/' + id, 'onHand', 'reserved');
    }

    function validBusinessReservation(id, data) {
      let order = getAfter(/databases/$(database)/documents/orders/$(data.orderId)).data;
      // Both call sites already require a business role and validReservationSource.
      // That shared source validator proves identity, owner, bounds and cancellation once.
      return owns(order) && businessReservationStockProof(id, data);
    }
    function businessReservationStockProof(id, data) {
      let before = resource == null ? {} : resource.data;
      let operationId = data.get('stockOperationId', 'unused');
      let path = /databases/$(database)/documents/stockOperations/$(operationId);
      let op = getAfter(path).data;
      let stockPath = /databases/$(database)/documents/warehouseStocks/$(data.get('warehouseStockId', 'unused'));
      return (before.get('quantity', 0) == data.get('quantity', 0)
          && (before.get('warehouseId', data.get('warehouseId', '')) == data.get('warehouseId', '') || data.get('quantity', 0) == 0))
        || (operationId != '' && operationId != 'unused' && !exists(path) && op.actorUid == request.auth.uid
          && op.orderId == data.orderId && id in op.reservationIds
          && op.productKey == data.productKey && op.warehouseId == data.warehouseId
          && op.targetPath == 'warehouseStocks/' + data.warehouseStockId
          && getAfter(stockPath).data.stockOperationId == operationId
          && getAfter(stockPath).data.reserved - get(stockPath).data.reserved == op.reservedDelta);
    }

    function businessReservationOperationalUpdate() {
      // Only reservationUpdateWriter calls this helper, after checking the fixed
      // business role. Repeating role() here exhausts the retry expression budget.
      return owns(resource.data)
        && owns(request.resource.data)
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && request.resource.data.get('salesCode', '') == resource.data.get('salesCode', '')
        && request.resource.data.get('orderId', '') == resource.data.get('orderId', '')
        && request.resource.data.get('itemId', '') == resource.data.get('itemId', '')
        && request.resource.data.get('productKey', '') == resource.data.get('productKey', '')
        && request.resource.data.get('warehouseId', '') == resource.data.get('warehouseId', '')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quantity', 'shortageQty', 'status', 'updatedAt', 'orderItemIndex', 'stockOperationId', 'warehouseStockId', 'warehouseId'
        ])
        && request.resource.data.get('quantity', 0) >= 0
        && request.resource.data.get('shortageQty', 0) >= 0;
    }

    function businessInventoryLotOperationalUpdate(id) {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'remainingQty', 'updatedAt', 'stockOperationId'
        ])
        && request.resource.data.remainingQty >= 0
        && hasStockOperation('inventoryLots/' + id, 'remainingQty', '');
    }

    function businessWarehouseStockOperationalUpdate(id) {
      return businessOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'onHand', 'reserved', 'updatedAt', 'stockOperationId', 'allocationPending', 'allocationRevision'
        ])
        && nonNegativeInventory(request.resource.data)
        && hasStockOperation('warehouseStocks/' + id, 'onHand', 'reserved');
    }

    function businessProcurementDemandCreate(data) {
      return businessOwner()
        && owns(data)
        && data.get('sourceType', '') == 'SALES_ORDER'
        && data.get('sourceId', '') != ''
        && data.get('sourceItemId', '') != ''
        && data.get('demandId', '') != ''
        && data.get('requestedQty', 0) is number
        && data.get('orderedQty', 0) is number
        && data.get('receivedQty', 0) is number
        && data.get('requestedQty', 0) >= 0
        && data.get('orderedQty', 0) >= 0
        && data.get('orderedQty', 0) <= data.get('requestedQty', 0)
        && data.get('receivedQty', 0) == 0;
    }

    function validDemandSource(data) {
      let order = getAfter(/databases/$(database)/documents/orders/$(data.sourceId)).data;
      let index = data.get('sourceItemIndex', -1);
      return index is int && index >= 0 && index < order.items.size()
        && data.sourceItemId == order.items[index].get('itemId', 'item-' + string(index + 1))
        && data.get('ownerUid', '') == order.get('ownerUid', '')
        && data.get('salesCode', '') == order.get('salesCode', '')
        && data.get('productKey', '') == order.items[index].get('productId', order.items[index].get('inventoryProductKey', ''));
    }

    function validProcurementDemand(data) {
      return data.get('sourceId', '') is string && data.get('sourceId', '').size() > 0
        && data.get('requestedQty', null) is number && data.requestedQty >= 0
        && data.get('orderedQty', null) is number && data.orderedQty >= 0 && data.orderedQty <= data.requestedQty
        && data.get('receivedQty', null) is number && data.receivedQty >= 0 && data.receivedQty <= data.orderedQty
        && data.get('remainingToOrderQty', null) is number
        && data.remainingToOrderQty == (data.get('status', '') == 'CANCELLED' ? 0 : data.requestedQty - data.orderedQty)
        && data.get('remainingToReceiveQty', null) is number && data.remainingToReceiveQty == data.orderedQty - data.receivedQty
        && data.get('status', '') == (data.get('status', '') == 'CANCELLED' ? 'CANCELLED'
          : data.requestedQty > 0 && data.receivedQty >= data.requestedQty ? 'RECEIVED'
          : data.receivedQty > 0 ? 'PARTIALLY_RECEIVED'
          : data.requestedQty > 0 && data.orderedQty >= data.requestedQty ? 'ORDERED'
          : data.orderedQty > 0 ? 'PARTIALLY_ORDERED' : 'PENDING')
        && ((data.get('sourceType', '') == 'SALES_ORDER'
          && data.get('sourceItemId', '') is string && data.get('sourceItemId', '').size() > 0
          && data.get('demandId', '') == 'SALES_ORDER:' + data.sourceId + ':' + data.sourceItemId
          && validDemandSource(data))
          || (data.get('sourceType', '') == 'STOCK_REPLENISHMENT'
            && data.get('sourceItemId', '') == '' && data.get('demandId', '') == 'STOCK_REPLENISHMENT:' + data.sourceId));
    }

    // Initial SALES_ORDER demand belongs to the authoritative whole-order
    // backend. Client transactions may only create follow-up demand after the
    // original source is already committed by that backend.
    function clientDemandSourceReady(data) {
      return data.get('sourceType', '') != 'SALES_ORDER'
        || getAfter(/databases/$(database)/documents/orders/$(data.sourceId)).data
          .get('inventoryReservationStatus', '') == 'completed';
    }

    function demandIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'demandId','sourceType','sourceId','sourceItemId','productKey','productId','ownerUid','salesCode'
      ]) && (resource.data.get('sourceItemIndex', -1) == -1
        || request.resource.data.get('sourceItemIndex', -1) == resource.data.get('sourceItemIndex', -1));
    }

    function legacyReservationLocationShape(data) {
      // Multi-location fields are proposals only. Existing stock witnesses and
      // fulfillment paths still prove exactly one warehouse per reservation.
      return !data.keys().hasAny(['locationSchemaVersion','locations','allocations','warehouseAllocations']);
    }
    function validReservationSource(id, data, userRole) {
      let order = getAfter(/databases/$(database)/documents/orders/$(data.orderId)).data;
      let index = data.get('orderItemIndex', -1);
      let item = order.items[index];
      return legacyReservationLocationShape(data)
        && index is int && index >= 0 && index < order.items.size()
        // Initial pending/failed reservation writes belong to the Admin SDK.
        && !(order.get('inventoryReservationStatus', '') in ['pending', 'failed'])
        && id == data.orderId + '__' + data.itemId
        && data.itemId == item.get('itemId', 'item-' + string(index + 1))
        && data.productKey == item.get('productId', item.get('inventoryProductKey', ''))
        && data.get('ownerUid', '') == order.get('ownerUid', '')
        && data.get('salesCode', '') == order.get('salesCode', '')
        && data.get('quantity', null) is number && data.quantity >= 0 && data.quantity <= item.get('qty', 0)
        && data.get('shortageQty', 0) is number && data.get('shortageQty', 0) >= 0
        && data.get('warehouseId', '') == item.get('warehouseId', order.get('warehouseId', ''))
        && (data.quantity == 0 || !orderIsCancelled(order));
    }

    function reservationIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['orderId','itemId','productKey']);
    }

    // Reserved totals include every reservation of this product changed by the
    // operation, including a move between warehouses. Unchanged siblings add zero.
    function operationalReservationDeltaAt(id, productKey, warehouseId) {
      let path = /databases/$(database)/documents/inventoryReservations/$(id);
      let previous = get(path);
      let before = previous == null ? {} : previous.data;
      let after = getAfter(path).data;
      let oldQty = before.get('quantity', 0);
      let qty = after.get('quantity', 0);
      // The company proof runs first and validates every product once. Local
      // sums reuse those same cached snapshots without repeating identity checks.
      return {
        'valid': warehouseId != '' || (after.productKey == productKey && before.get('productKey', productKey) == productKey),
        'quantity': warehouseId == '' ? qty - oldQty
          : (after.get('warehouseId', '') == warehouseId ? qty : 0)
            - (before.get('warehouseId', '') == warehouseId ? oldQty : 0)
      };
    }
    // Invalid evidence stays explicit instead of mixing number/null or using a sentinel.
    function combinedReservationDelta(a, b, c, d, e) {
      return {'valid': a.valid && b.valid && c.valid && d.valid && e.valid,
        'quantity': a.quantity + b.quantity + c.quantity + d.quantity + e.quantity};
    }
    function operationalStockDelta(e, productKey, warehouseId) {
      let ids = e.reservationIds;
      return combinedReservationDelta(operationalReservationDeltaAt(ids[0], productKey, warehouseId),
        ids.size() > 1 ? operationalReservationDeltaAt(ids[1], productKey, warehouseId) : {'valid': true, 'quantity': 0},
        ids.size() > 2 ? operationalReservationDeltaAt(ids[2], productKey, warehouseId) : {'valid': true, 'quantity': 0},
        ids.size() > 3 ? operationalReservationDeltaAt(ids[3], productKey, warehouseId) : {'valid': true, 'quantity': 0},
        ids.size() > 4 ? operationalReservationDeltaAt(ids[4], productKey, warehouseId) : {'valid': true, 'quantity': 0});
    }
    function operationalReservedStockMatches(path, delta, productKey, warehouseId) {
      let previous = get(path);
      let before = previous == null ? {} : previous.data;
      let after = getAfter(path).data;
      return delta.valid && after.get('productKey', after.get('productId', '')) == productKey
        && (warehouseId == '' || after.get('warehouseId', '') == warehouseId)
        && after.get('reserved', 0) - before.get('reserved', 0) == delta.quantity;
    }
    function sameWarehouseReservationDeltaAt(id, productKey, warehouseId) {
      let path = /databases/$(database)/documents/inventoryReservations/$(id);
      let previous = get(path);
      let before = previous == null ? {} : previous.data;
      let after = getAfter(path).data;
      let oldQty = before.get('quantity', 0);
      let qty = after.get('quantity', 0);
      return {
        'valid': (qty == 0 && oldQty == 0) || (after.productKey == productKey && after.warehouseId == warehouseId
          && (oldQty == 0 || before.get('warehouseId', warehouseId) == warehouseId)),
        'quantity': qty - oldQty
      };
    }
    function sameWarehouseReservationTotal(ids, productKey, warehouseId) {
      return combinedReservationDelta(sameWarehouseReservationDeltaAt(ids[0], productKey, warehouseId),
        ids.size() > 1 ? sameWarehouseReservationDeltaAt(ids[1], productKey, warehouseId) : {'valid': true, 'quantity': 0},
        ids.size() > 2 ? sameWarehouseReservationDeltaAt(ids[2], productKey, warehouseId) : {'valid': true, 'quantity': 0},
        ids.size() > 3 ? sameWarehouseReservationDeltaAt(ids[3], productKey, warehouseId) : {'valid': true, 'quantity': 0},
        ids.size() > 4 ? sameWarehouseReservationDeltaAt(ids[4], productKey, warehouseId) : {'valid': true, 'quantity': 0});
    }
    function sameWarehouseReservationStocks(e, productKey, warehouseId) {
      let delta = sameWarehouseReservationTotal(e.reservationIds, productKey, warehouseId);
      let invPath = /databases/$(database)/documents/inventory/$(e.inventoryId);
      let whPath = /databases/$(database)/documents/warehouseStocks/$(e.warehouseStockId);
      let beforeInv = exists(invPath) ? get(invPath).data : {};
      let beforeWh = exists(whPath) ? get(whPath).data : {};
      let afterInv = getAfter(invPath).data;
      let afterWh = getAfter(whPath).data;
      return delta.valid && afterInv.get('productKey', afterInv.get('productId', '')) == productKey
        && afterWh.productKey == productKey && afterWh.warehouseId == warehouseId
        && afterInv.reserved - beforeInv.get('reserved', 0) == delta.quantity
        && afterWh.reserved - beforeWh.get('reserved', 0) == delta.quantity;
    }
    // Only one fresh warehouse movement evaluates the full company delta.
    // All other warehouse movements must link that validated primary movement.
    function linkedCompanyReservationProof(e, productKey, warehouseId) {
      let path = /databases/$(database)/documents/inventoryMovements/$(e.companyMovementId);
      let primary = getAfter(path).data;
      let proof = primary.get('reservationStockEvidence', {});
      return !exists(path)
        && primary.get('productKey', '') == productKey
        && primary.get('sourceId', '') == request.resource.data.get('sourceId', '')
        && primary.get('warehouseId', '') != warehouseId
        && proof.get('crossWarehouse', false) == true
        && proof.get('movementId', '') == e.companyMovementId
        && proof.get('companyMovementId', '') == e.companyMovementId
        && proof.get('inventoryId', '') == e.inventoryId
        && proof.get('reservationIds', []).size() == e.reservationIds.size()
        && proof.get('reservationIds', []).hasAll(e.reservationIds);
    }
    // Evaluate each primary reservation snapshot once for both stock totals.
    // A local contribution must keep its warehouse; each changed reservation's
    // own movement witness also requires membership in this local ID set.
    function primaryReservationDeltaAt(id, productKey, warehouseId, localIds) {
      let path = /databases/$(database)/documents/inventoryReservations/$(id);
      let previous = get(path);
      let before = previous == null ? {} : previous.data;
      let after = getAfter(path).data;
      let oldQty = before.get('quantity', 0);
      let qty = after.get('quantity', 0);
      let local = id in localIds;
      let delta = qty - oldQty;
      return {
        'valid': after.productKey == productKey && before.get('productKey', productKey) == productKey
          && (!local || (qty == 0 && oldQty == 0) || (after.warehouseId == warehouseId
            && (oldQty == 0 || before.get('warehouseId', warehouseId) == warehouseId))),
        'company': delta, 'warehouse': local ? delta : 0
      };
    }
    function combinedPrimaryReservationDelta(a, b, c, d, e) {
      return {'valid': a.valid && b.valid && c.valid && d.valid && e.valid,
        'company': a.company + b.company + c.company + d.company + e.company,
        'warehouse': a.warehouse + b.warehouse + c.warehouse + d.warehouse + e.warehouse};
    }
    function primaryReservationStocks(e, productKey, warehouseId) {
      let ids = e.reservationIds;
      let localIds = e.warehouseReservationIds;
      let zero = {'valid': true, 'company': 0, 'warehouse': 0};
      let delta = combinedPrimaryReservationDelta(
        primaryReservationDeltaAt(ids[0], productKey, warehouseId, localIds),
        ids.size() > 1 ? primaryReservationDeltaAt(ids[1], productKey, warehouseId, localIds) : zero,
        ids.size() > 2 ? primaryReservationDeltaAt(ids[2], productKey, warehouseId, localIds) : zero,
        ids.size() > 3 ? primaryReservationDeltaAt(ids[3], productKey, warehouseId, localIds) : zero,
        ids.size() > 4 ? primaryReservationDeltaAt(ids[4], productKey, warehouseId, localIds) : zero);
      return operationalReservedStockMatches(/databases/$(database)/documents/inventory/$(e.inventoryId),
          {'valid': delta.valid, 'quantity': delta.company}, productKey, '')
        && operationalReservedStockMatches(/databases/$(database)/documents/warehouseStocks/$(e.warehouseStockId),
          {'valid': delta.valid, 'quantity': delta.warehouse}, productKey, warehouseId);
    }
    function crossWarehouseReservationStocks(e, productKey, warehouseId) {
      return e.get('companyMovementId', '') is string && e.get('companyMovementId', '') != ''
        && e.warehouseReservationIds is list && e.warehouseReservationIds.size() > 0
        && e.warehouseReservationIds.size() <= e.reservationIds.size()
        && e.warehouseReservationIds.toSet().size() == e.warehouseReservationIds.size()
        && e.reservationIds.hasAll(e.warehouseReservationIds)
        && (e.companyMovementId == e.movementId
          ? primaryReservationStocks(e, productKey, warehouseId)
          : linkedCompanyReservationProof(e, productKey, warehouseId)
            && operationalReservedStockMatches(/databases/$(database)/documents/warehouseStocks/$(e.warehouseStockId),
              sameWarehouseReservationTotal(e.warehouseReservationIds, productKey, warehouseId), productKey, warehouseId));
    }
    function operationalReservationStockEvidence(id) {
      let data = request.resource.data;
      let before = resource == null ? {} : resource.data;
      let e = data.get('stockEvidence', {});
      return (data.get('quantity', 0) == before.get('quantity', 0)
          && data.get('warehouseId', '') == before.get('warehouseId', ''))
        || (data.get('quantity', 0) == 0 && before.get('quantity', 0) == 0)
        || (e.get('movementId', '') != '' && id in e.get('reservationIds', [])
          // #311: this legacy client witness may no longer prove multi-warehouse
          // reservation changes. Such writes use the trusted Callable only.
          && e.get('crossWarehouse', false) != true
          && operationalReservationMovement(e.movementId, data, before, e));
    }
    // Validate the group once on its immutable movement rather than repeating
    // the five-reservation sums on every reservation in the batch.
    function validOperationalMovementEvidence(id) {
      let e = request.resource.data.reservationStockEvidence;
      let path = /databases/$(database)/documents/inventoryReservations/$(e.reservationIds[0]);
      let data = getAfter(path).data;
      let previous = get(path);
      let before = previous == null ? {} : previous.data;
      return e.keys().hasAll(['inventoryId','warehouseStockId','previousWarehouseStockId','reservationIds','movementId'])
        && e.movementId == id && e.inventoryId is string && e.inventoryId.size() > 0
        && e.warehouseStockId is string && e.warehouseStockId.size() > 0
        && e.previousWarehouseStockId is string && e.previousWarehouseStockId.size() > 0
        && e.reservationIds is list && e.reservationIds.size() > 0 && e.reservationIds.size() <= 5
        && e.reservationIds.toSet().size() == e.reservationIds.size()
        && e.get('crossWarehouse', false) == false
        && request.resource.data.productKey == data.productKey
        && (e.get('crossWarehouse', false)
          ? crossWarehouseReservationStocks(e, data.productKey, data.warehouseId)
          : (before.get('quantity', 0) == 0 || before.get('warehouseId', data.warehouseId) == data.warehouseId)
            ? sameWarehouseReservationStocks(e, data.productKey, data.warehouseId)
            : operationalReservedStockMatches(/databases/$(database)/documents/inventory/$(e.inventoryId), operationalStockDelta(e, data.productKey, ''), data.productKey, '')
              && operationalReservedStockMatches(/databases/$(database)/documents/warehouseStocks/$(e.warehouseStockId), operationalStockDelta(e, data.productKey, data.warehouseId), data.productKey, data.warehouseId)
              && ((request.resource.data.get('sourceType', '') == 'WAREHOUSE_TRANSFER' && operationalTransferReservationArrival(e, data, before))
                || operationalReservedStockMatches(/databases/$(database)/documents/warehouseStocks/$(e.previousWarehouseStockId), operationalStockDelta(e, data.productKey, before.warehouseId), data.productKey, before.warehouseId)));
    }
    function operationalTransferReservationArrival(e, data, before) {
      let movement = request.resource.data;
      let path = /databases/$(database)/documents/stockTransfers/$(movement.get('sourceId', 'unused'));
      let oldTransfer = get(path).data;
      let transfer = getAfter(path).data;
      let stockPath = /databases/$(database)/documents/warehouseStocks/$(e.previousWarehouseStockId);
      return movement.get('sourceType', '') == 'WAREHOUSE_TRANSFER'
        && e.reservationIds.size() == 1 && exists(path) && oldTransfer.status == 'IN_TRANSIT'
        && transfer.status == 'RECEIVED' && transfer.receivedByUid == request.auth.uid
        && transfer.orderId == data.orderId && transfer.itemId == data.itemId
        && transfer.productKey == data.productKey && transfer.reservedQty == data.quantity
        && before.quantity == data.quantity && transfer.fromWarehouseId == before.warehouseId
        && transfer.toWarehouseId == data.warehouseId && transfer.fromStockId == e.previousWarehouseStockId
        && transfer.toStockId == e.warehouseStockId && transfer.inventoryId == e.inventoryId
        && getAfter(stockPath).data.reserved == get(stockPath).data.reserved;
    }
    function operationalReservationMovement(id, data, before, evidence) {
      let path = /databases/$(database)/documents/inventoryMovements/$(id);
      let movement = getAfter(path).data;
      return id is string && id.size() > 0 && !exists(path)
        && movement.get('reservationStockEvidence', {}) == evidence
        && movement.productKey == data.productKey
        && movement.get('warehouseId', '') in [data.warehouseId, before.get('warehouseId', data.warehouseId)]
        && (movement.get('sourceId', '') == data.orderId
          || (movement.get('sourceType', '') == 'SUPPLY_ORDER'
            && getAfter(/databases/$(database)/documents/supplyOrders/$(movement.sourceId)).data.get('orderId', '') == data.orderId)
          || (movement.get('sourceType', '') == 'WAREHOUSE_TRANSFER'
            && getAfter(/databases/$(database)/documents/stockTransfers/$(movement.sourceId)).data.get('orderId', '') == data.orderId));
    }

    function validInventoryLot(data) {
      return data.get('productKey', '') is string && data.get('productKey', '').size() > 0
        && data.get('warehouseId', '') is string && data.get('warehouseId', '').size() > 0
        && data.get('remainingQty', null) is number && data.remainingQty >= 0
        && data.get('receivedQty', 0) is number && data.get('receivedQty', 0) >= 0
        && data.get('qty', 0) is number && data.get('qty', 0) >= 0
        && !data.keys().hasAny(['unitCost','cost','costPrice']);
    }
    function inventoryLotIdentityUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'productKey','productId','warehouseId','sourceType','sourceId','transferId','costLotId','receivedAt'
      ]);
    }
    function reservationCreateWriter(id, userRole) {
      return userRole == 'admin'
        || (userRole in ['purchaser','warehouse'] && operationalReservationStockEvidence(id))
        || (userRole in ['sales','engineer'] && validBusinessReservation(id, request.resource.data));
    }
    function reservationUpdateWriter(id, userRole) {
      return userRole == 'admin'
        || (userRole in ['purchaser','warehouse'] && operationalReservationStockEvidence(id))
        || (userRole in ['sales','engineer'] && businessReservationOperationalUpdate()
          && validBusinessReservation(id, request.resource.data));
    }
    function reservationCreateAllowed(id) {
      let userRole = role();
      // A client may only create subsequent operational reservation evidence
      // after the authoritative whole-order transaction has completed.
      return getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data
          .get('inventoryReservationStatus', '') == 'completed'
        && validReservationSource(id, request.resource.data, userRole)
        && reservationCreateWriter(id, userRole);
    }
    function reservationUpdateAllowed(id) {
      let userRole = role();
      return validReservationSource(id, request.resource.data, userRole)
        && reservationIdentityUnchanged() && legacyReservationLocationShape(resource.data)
        && reservationUpdateWriter(id, userRole);
    }
    function inventoryMovementWriter(id) {
      let userRole = role();
      return userRole in ['admin','purchaser','warehouse','sales','engineer']
        && (userRole in ['admin','purchaser','warehouse'] || owns(request.resource.data))
        && (!('reservationStockEvidence' in request.resource.data)
          || (userRole in ['admin','purchaser','warehouse'] && validOperationalMovementEvidence(id)));
    }

    function businessProcurementDemandOperationalUpdate() {
      return businessOwner()
        // Generic supply progress can neither cancel nor reopen a cancelled demand.
        // Both lifecycle transitions require their co-committed order proof.
        && resource.data.get('status', '') != 'CANCELLED'
        && request.resource.data.get('status', '') != 'CANCELLED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'orderedQty', 'remainingToOrderQty', 'remainingToReceiveQty',
          'perOrdered', 'perReceived', 'status', 'scheduleDate', 'updatedAt', 'sourceItemIndex'
        ])
        && owns(resource.data)
        && owns(request.resource.data)
        && request.resource.data.get('demandId', '') == resource.data.get('demandId', '')
        && request.resource.data.get('sourceType', '') == resource.data.get('sourceType', '')
        && request.resource.data.get('sourceId', '') == resource.data.get('sourceId', '')
        && request.resource.data.get('sourceItemId', '') == resource.data.get('sourceItemId', '')
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && request.resource.data.get('salesCode', '') == resource.data.get('salesCode', '')
        && request.resource.data.get('receivedQty', 0) == resource.data.get('receivedQty', 0)
        && request.resource.data.get('orderedQty', 0) >= resource.data.get('orderedQty', 0)
        && request.resource.data.get('orderedQty', 0) <= request.resource.data.get('requestedQty', 0);
    }

    function businessLifecycleDemandCancelUpdate() {
      let d = request.resource.data;
      let orderPath = /databases/$(database)/documents/orders/$(d.sourceId);
      let before = get(orderPath).data;
      let after = getAfter(orderPath).data;
      // validProcurementDemand and demandIdentityUnchanged already prove
      // source item, owner/salesCode, item index, product, and identity.
      // Avoid repeating expensive lookups in the cancellation transaction.
      return businessOwner()
        && d.get('sourceType', '') == 'SALES_ORDER'
        && before.get('ownerUid', '') == request.auth.uid
        && after.get('ownerUid', '') == request.auth.uid
        && !orderIsCancelled(before) && orderIsCancelled(after)
        && d.get('status', '') == 'CANCELLED'
        && d.get('requestedQty', -1) == resource.data.get('requestedQty', -2)
        && d.get('orderedQty', -1) == resource.data.get('orderedQty', -2)
        && d.get('receivedQty', -1) == resource.data.get('receivedQty', -2)
        && d.diff(resource.data).affectedKeys().hasOnly([
          'status','remainingToOrderQty','updatedAt','sourceItemIndex'
        ]);
    }

    function businessLifecycleDemandRestoreUpdate() {
      let d = request.resource.data;
      let orderPath = /databases/$(database)/documents/orders/$(d.sourceId);
      let before = get(orderPath).data;
      let after = getAfter(orderPath).data;
      let item = after.items[d.sourceItemIndex];
      let remaining = d.get('fulfillmentType', 'WAREHOUSE') == 'DIRECT_SHIP'
        ? item.get('qty', 0) + item.get('returnedQty', 0)
        : d.get('receivedQty', 0) + item.get('shortageQty', 0);
      return businessOwner() && d.get('sourceType', '') == 'SALES_ORDER'
        && before.get('ownerUid', '') == request.auth.uid
        && after.get('ownerUid', '') == request.auth.uid
        && orderIsCancelled(before) && !orderIsCancelled(after)
        && resource.data.get('status', '') == 'CANCELLED'
        && d.get('status', '') != 'CANCELLED'
        && d.get('requestedQty', 0) == (d.get('orderedQty', 0) > remaining ? d.get('orderedQty', 0) : remaining)
        && d.get('orderedQty', -1) == resource.data.get('orderedQty', -2)
        && d.get('receivedQty', -1) == resource.data.get('receivedQty', -2)
        && d.diff(resource.data).affectedKeys().hasOnly([
          'requestedQty','remainingToOrderQty','remainingToReceiveQty',
          'perOrdered','perReceived','status','sourceItemIndex','updatedAt'
        ]);
    }

    function businessDirectDemandReceiptUpdate() {
      let orderPath = /databases/$(database)/documents/orders/$(resource.data.sourceId);
      let before = get(orderPath).data;
      let after = getAfter(orderPath).data;
      let records = after.get('deliveryRecords', []);
      let record = records[before.get('deliveryRecords', []).size()];
      return role() in ['sales', 'engineer'] && resource.data.get('ownerUid', '') == request.auth.uid
        && resource.data.get('sourceType', '') == 'SALES_ORDER'
        && resource.data.get('fulfillmentType', '') == 'DIRECT_SHIP'
        && after.ownerUid == request.auth.uid && !orderIsCancelled(before)
        && records.size() == before.get('deliveryRecords', []).size() + 1
        && record.sourceType == 'DIRECT_SHIP_RECEIPT' && record.itemId == resource.data.sourceItemId
        && request.resource.data.requestedQty == resource.data.requestedQty
        && request.resource.data.orderedQty == resource.data.orderedQty
        && request.resource.data.receivedQty == resource.data.receivedQty + record.qty
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'receivedQty', 'remainingToReceiveQty', 'perReceived', 'status', 'updatedAt', 'sourceItemIndex'
        ]);
    }

    function validDirectShipReceipt(id, data) {
      let supplyPath = /databases/$(database)/documents/supplyOrders/$(data.supplyOrderId);
      let before = get(supplyPath).data;
      let after = getAfter(supplyPath).data;
      let orderPath = /databases/$(database)/documents/orders/$(before.orderId);
      let orderBefore = get(orderPath).data;
      let orderAfter = getAfter(orderPath).data;
      let records = orderAfter.get('deliveryRecords', []);
      let record = records[orderBefore.get('deliveryRecords', []).size()];
      let userRole = role();
      return (userRole == 'admin' || (userRole in ['sales', 'engineer'] && before.ownerUid == request.auth.uid && orderBefore.ownerUid == request.auth.uid))
        && data.operationId == id && data.receiptId == id && id.size() <= 128
        && data.fulfillmentType == 'DIRECT_SHIP' && before.fulfillmentType == 'DIRECT_SHIP'
        && data.warehouseId == '' && !orderIsCancelled(orderBefore)
        && data.orderId == before.orderId && data.itemId == before.itemId
        && data.ownerUid == before.ownerUid && data.productId == before.get('productId', '')
        && data.qty is number && data.qty > 0 && data.qty <= before.qty - before.get('receivedQty', 0)
        && after.receivedQty == before.get('receivedQty', 0) + data.qty
        && data.cumulativeReceivedQty == after.receivedQty
        && records.size() == orderBefore.get('deliveryRecords', []).size() + 1
        && record.sourceType == 'DIRECT_SHIP_RECEIPT' && record.sourceId == data.supplyOrderId
        && record.receiptId == id && record.qty == data.qty;
    }

    // Personal defaults: only the authenticated active member's future-order defaults.
    function validPersonalDefaults(p) {
      return p is map && p.keys().hasOnly(['mode','warehouseId','contact','phone','address','packages','notes'])
        && p.keys().hasAll(['mode','warehouseId','contact','phone','address','packages','notes'])
        && p.mode in ['PICKUP','SALES_SHIP'] && p.warehouseId == '' && p.packages == 1
        && p.contact is string && p.contact.size() <= 1000
        && p.phone is string && p.phone.size() <= 1000
        && p.address is string && p.address.size() <= 1000
        && p.notes is string && p.notes.size() <= 1000
        && (p.mode == 'PICKUP' || (p.contact.size() > 0 && p.phone.size() > 0 && p.address.size() > 0));
    }
    function validPersonalSettingsUpdate(id) {
      return active() && id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone','deliveryDefaults','updatedAt'])
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 100
        && validPersonalDefaults(request.resource.data.deliveryDefaults)
        && request.resource.data.updatedAt == request.time;
    }

    match /users/{id} {
      allow read: if signedIn() && (id == request.auth.uid || active());
      allow create: if admin();
      // A signed-in member may sync only their own token email, never role,
      // ownership code, activation or delivery preferences.
      allow update: if admin() || validPersonalSettingsUpdate(id) || (active() && id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
        && request.resource.data.get('email', '') is string
        && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 320
        && request.resource.data.email == request.auth.token.get('email', ''));
      allow delete: if false;
    }

    match /settings/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /brands/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /productLines/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /salesCodes/{id} {
      allow read: if active();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /customers/{id} {
      allow read: if active();
      allow create, update: if admin() || businessOwner() || businessAssistant();
      allow delete: if false;
    }

    match /suppliers/{id} {
      allow read: if active();
      allow create, update: if canPurchase();
      allow delete: if false;
    }

    match /brandSupplierMappings/{id} {
      allow read: if active();
      allow create, update: if canPurchase();
      allow delete: if false;
    }

    match /warehouses/{id} {
      allow read: if active();
      allow create: if admin() || (canReceiveInventory() && request.resource.data.get('systemCustody', false) == true
        && id == 'custody-' + request.resource.data.ownerUid && request.resource.data.warehouseType == 'CUSTODY'
        && request.resource.data.isDefault == false && request.resource.data.active == true
        && request.resource.data.keys().hasOnly(['warehouseName','active','isDefault','warehouseType','systemCustody','ownerUid','sourceTransferId'])
        && getAfter(/databases/$(database)/documents/stockTransfers/$(request.resource.data.sourceTransferId)).data.kind == 'HANDOFF'
        && getAfter(/databases/$(database)/documents/stockTransfers/$(request.resource.data.sourceTransferId)).data.toWarehouseId == id);
      allow update: if admin();
      allow delete: if false;
    }

    // Searchable product master. Cost is intentionally stored separately.
    match /products/{id} {
      allow read: if active();
      allow create: if admin() || purchaser() || businessTemporaryProduct(id, request.resource.data);
      allow update: if admin() || purchaser();
      allow delete: if admin();
    }

    // 公司標準產品成本只提供採購／管理員；業務自行調貨成本存在自己的訂單交易中。
    match /productCosts/{id} {
      allow read: if admin() || purchaser();
      allow create, update: if admin() || purchaser();
      allow delete: if admin();
    }

    match /priceHistory/{id} {
      allow read, create: if admin() || purchaser();
      allow update, delete: if false;
    }

    match /quotes/{id} {
      allow get: if admin() || purchaser() || (commercialDocumentOwner() && resource == null) || owns(resource.data)
        || engineerAssistedSalesQuote(resource.data);
      allow list: if admin() || purchaser() || owns(resource.data)
        || engineerAssistedSalesQuote(resource.data);
      allow create: if canCreateCommercialDoc() && (
        validOwnedCommercialCreate(request.resource.data)
        || (engineerAssistedSalesQuote(request.resource.data) && validSalesOwner(request.resource.data))
        || (purchaser() && validQuoteOwner(request.resource.data)
          && request.resource.data.ownerUid != request.auth.uid)
      );
      allow update: if admin()
        || (commercialDocumentOwner() && owns(resource.data) && owns(request.resource.data) && sameCommercialOwner() && preservesCreator())
        || (engineerAssistedSalesQuote(resource.data) && sameCommercialOwner() && preservesCreator())
        || (purchaser() && sameCommercialOwner() && preservesCreator()
          && (resource.data.get('dealClosed', false) != true
            || request.resource.data.get('dealClosed', false) == true));
      allow delete: if admin();
    }

    match /forecasts/{id} {
      allow read: if admin() || (sales() && owns(resource.data));
      allow create: if (admin() || sales()) && validOwnedCommercialCreate(request.resource.data);
      allow update: if admin()
        || (sales() && owns(resource.data) && owns(request.resource.data) && sameCommercialOwner() && preservesCreator());
      allow delete: if admin();
    }

    match /forecasts/{forecastId}/progress/{progressId} {
      function parentForecast() {
        return get(/databases/$(database)/documents/forecasts/$(forecastId));
      }
      allow read: if admin() || (sales() && owns(parentForecast().data));
      allow create: if admin() || (sales() && owns(parentForecast().data));
      allow update: if false;
      allow delete: if admin();
    }

    function validNewOrderProductMaster(data) {
      let productId = data.get('productId', '');
      return data.get('productMasterMatched', false) == true
        && data.get('items', []) is list && data.get('items', []).size() <= 15
        && productId != ''
        && exists(productPath(productId));
    }

    function validNewItemCost(item, method) {
      // The existing cost check also fences backend-owned projection fields.
      // Existing order-entry clients may submit an explicit zero reservedQty.
      return !item.keys().hasAny(['unitCost', 'cost', 'shortageQty', 'reservationStatus'])
        && item.get('reservedQty', 0) == 0
        && (!('costPrice' in item) || (item.get('procurementType', method) == 'SALES_SELF_ORDER'
          && item.costPrice is number && item.costPrice >= 0));
    }
    function validOrderEmbeddedCost(data) {
      let items = data.get('items', []);
      let count = items.size();
      let method = data.get('procurementType', 'PURCHASING_PO');
      return items is list && count <= 15
        && validNewItemCost(data, 'PURCHASING_PO')
        && (count <= 0 || validNewItemCost(items[0], method))
        && (count <= 1 || validNewItemCost(items[1], method))
        && (count <= 2 || validNewItemCost(items[2], method))
        && (count <= 3 || validNewItemCost(items[3], method))
        && (count <= 4 || validNewItemCost(items[4], method))
        && (count <= 5 || validNewItemCost(items[5], method))
        && (count <= 6 || validNewItemCost(items[6], method))
        && (count <= 7 || validNewItemCost(items[7], method))
        && (count <= 8 || validNewItemCost(items[8], method))
        && (count <= 9 || validNewItemCost(items[9], method))
        && (count <= 10 || validNewItemCost(items[10], method))
        && (count <= 11 || validNewItemCost(items[11], method))
        && (count <= 12 || validNewItemCost(items[12], method))
        && (count <= 13 || validNewItemCost(items[13], method))
        && (count <= 14 || validNewItemCost(items[14], method));
    }
    // Ordinary operational changes use the existing cheap path. Only changes to
    // cost or identity enter the additional Service binding validation.
    function commercialItemIdentityAndCostProtected(before, after, method) {
      let changed = after.diff(before).affectedKeys();
      return before == after || ((!changed.hasAny(['deliveryPlan']) || before.get('deliveryPlan', {}) == after.get('deliveryPlan', {}))
        && (!changed.hasAny(['receivedQty']) || before.get('receivedQty', 0) == after.get('receivedQty', 0))
        && (!changed.hasAny(['receiptEvents']) || before.get('receiptEvents', []) == after.get('receiptEvents', [])) && before.get('procurementType', method) == after.get('procurementType', method)
        && (!changed.hasAny([
            'costPrice','costSource','unitCost','cost','itemId','productId','productType','serviceKind'
          ]) || ((!changed.hasAny(['itemId','productId','productType','serviceKind'])
              || !isServiceBillingItem(before) && !isServiceBillingItem(after))
            && (!changed.hasAny(['costPrice','costSource','unitCost','cost'])
              || (before.get('procurementType', method) == 'SALES_SELF_ORDER'
                && !changed.hasAny(['unitCost','cost'])
                && after.get('costPrice', null) is number && after.costPrice >= 0)))));
    }
    function validCommercialOrderCostUpdate() {
      let before = resource.data.get('items', []);
      let after = request.resource.data.get('items', []);
      return request.resource.data.get('procurementType', 'PURCHASING_PO') == resource.data.get('procurementType', 'PURCHASING_PO')
        && commercialItemIdentityAndCostProtected(resource.data, request.resource.data, 'PURCHASING_PO')
        && (before == after || (before is list && after is list && before.size() == after.size() && before.size() <= 15
          && (before.size() <= 0 || commercialItemIdentityAndCostProtected(before[0], after[0], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 1 || commercialItemIdentityAndCostProtected(before[1], after[1], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 2 || commercialItemIdentityAndCostProtected(before[2], after[2], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 3 || commercialItemIdentityAndCostProtected(before[3], after[3], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 4 || commercialItemIdentityAndCostProtected(before[4], after[4], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 5 || commercialItemIdentityAndCostProtected(before[5], after[5], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 6 || commercialItemIdentityAndCostProtected(before[6], after[6], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 7 || commercialItemIdentityAndCostProtected(before[7], after[7], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 8 || commercialItemIdentityAndCostProtected(before[8], after[8], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 9 || commercialItemIdentityAndCostProtected(before[9], after[9], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 10 || commercialItemIdentityAndCostProtected(before[10], after[10], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 11 || commercialItemIdentityAndCostProtected(before[11], after[11], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 12 || commercialItemIdentityAndCostProtected(before[12], after[12], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 13 || commercialItemIdentityAndCostProtected(before[13], after[13], resource.data.get('procurementType', 'PURCHASING_PO')))
          && (before.size() <= 14 || commercialItemIdentityAndCostProtected(before[14], after[14], resource.data.get('procurementType', 'PURCHASING_PO')))));
    }

    function supplierCancellationResolution(userRole) {
      let before = resource.data;
      let after = request.resource.data;
      let order = get(/databases/$(database)/documents/orders/$(before.orderId)).data;
      let remaining = before.qty - before.get('receivedQty', 0);
      let redirect = before.get('fulfillmentType', 'WAREHOUSE') == 'DIRECT_SHIP';
      let invPath = /databases/$(database)/documents/inventory/$(after.get('redirectInventoryId', 'unused'));
      let whId = after.get('redirectWarehouseStockId', 'unused');
      let whPath = /databases/$(database)/documents/warehouseStocks/$(whId);
      return userRole == 'purchaser' && orderIsCancelled(order)
        && before.get('status', '') in ['ORDERED', 'PARTIAL_RECEIPT'] && remaining > 0
        && before.get('customerCancellationDisposition', '') != 'KEEP_STOCK'
        && after.customerCancellationDisposition == 'KEEP_STOCK'
        && after.customerCancellationResolvedBy == request.auth.uid
        && after.customerCancellationResolvedAt != ''
        && after.diff(before).affectedKeys().hasOnly([
          'customerCancellationDisposition', 'customerCancellationResolvedAt', 'customerCancellationResolvedBy',
          'originalFulfillmentType', 'fulfillmentType', 'warehouseId', 'redirectInventoryId', 'redirectWarehouseStockId', 'incomingRegisteredQty', 'updatedAt'
        ])
        && (redirect ? (
          after.originalFulfillmentType == 'DIRECT_SHIP' && after.fulfillmentType == 'WAREHOUSE'
          && validActiveReturnWarehouse(after.warehouseId)
          && after.incomingRegisteredQty == remaining
          && getAfter(invPath).data.productKey == before.productKey
          && getAfter(whPath).data.productKey == before.productKey && getAfter(whPath).data.warehouseId == after.warehouseId
          && getAfter(invPath).data.incoming == (exists(invPath) ? get(invPath).data.get('incoming', 0) : 0) + remaining
          && getAfter(whPath).data.incoming == (exists(whPath) ? get(whPath).data.get('incoming', 0) : 0) + remaining
        ) : after.get('fulfillmentType', 'WAREHOUSE') == before.get('fulfillmentType', 'WAREHOUSE')
          && after.get('warehouseId', '') == before.get('warehouseId', '')
          && after.get('incomingRegisteredQty', 0) == before.get('incomingRegisteredQty', 0));
    }

    // Skip groups beyond the actual list length instead of evaluating all 30
    // candidates for a short, fully withdrawn request list.
    function returnPendingInGroup(requests, start) {
      let count = requests.size();
      return count > start && (requests[start].status == 'PENDING'
        || (count > start + 1 && requests[start + 1].status == 'PENDING')
        || (count > start + 2 && requests[start + 2].status == 'PENDING')
        || (count > start + 3 && requests[start + 3].status == 'PENDING')
        || (count > start + 4 && requests[start + 4].status == 'PENDING'));
    }
    function validReturnPendingFlag(requests, flag) {
      return requests.size() <= 30 && flag == (
        returnPendingInGroup(requests, 0) || returnPendingInGroup(requests, 5)
        || returnPendingInGroup(requests, 10) || returnPendingInGroup(requests, 15)
        || returnPendingInGroup(requests, 20) || returnPendingInGroup(requests, 25));
    }

    function returnReceiptOrderUpdate(id) {
      let before = resource.data;
      let after = request.resource.data;
      let receiptId = after.get('returnReceiptId', '');
      let path = /databases/$(database)/documents/customerReturnReceipts/$(receiptId);
      let receipt = getAfter(path).data;
      let oldRequests = before.get('returnRequests', []);
      let newRequests = after.get('returnRequests', []);
      let index = receipt.requestIndex;
      let previous = oldRequests[index];
      let next = newRequests[index];
      return canReceiveInventory() && receiptId != '' && !exists(path)
        && receipt.orderId == id && receipt.receivedBy == request.auth.uid
        && previous.id == receipt.requestId && previous.status == 'PENDING'
        && next.diff(previous).affectedKeys().hasOnly(['receivedQty', 'status'])
        && next.receivedQty == previous.get('receivedQty', 0) + receipt.qty && next.receivedQty <= previous.qty
        && next.status == (next.receivedQty == next.qty ? 'RECEIVED' : 'PENDING')
        && validReturnPendingFlag(newRequests, after.returnPending)
        && newRequests.size() == oldRequests.size()
        && newRequests.removeAll([next]) == oldRequests.removeAll([previous])
        && after.get('returnRecords', []).size() == before.get('returnRecords', []).size() + 1
        && after.get('returnRecords', [])[after.get('returnRecords', []).size() - 1] == receipt.record
        && after.get('returnRecords', []).removeAll([receipt.record]) == before.get('returnRecords', [])
        && after.returnedQty == before.get('returnedQty', 0) + receipt.qty
        && after.returnedQty <= before.get('deliveredQty', 0)
        && after.diff(before).affectedKeys().hasOnly([
          'returnRequests', 'returnPending', 'returnRecords', 'returnedQty', 'returnReceiptId',
          'items', 'workCategories', 'workCategoryUpdatedAt', 'updatedAt'
