          && (transfer.kind == 'HANDOFF'
            ? newItem.warehouseId == transfer.toWarehouseId && newItem.custodyTransferId == transfer.id
              && after.get('logisticsTransfersPending', 0) == before.get('logisticsTransfersPending', 0)
            : newItem.get('warehouseId', '') == oldItem.get('warehouseId', '') && newItem.transferPendingId == transfer.id
              && after.get('logisticsTransfersPending', 0) == before.get('logisticsTransfersPending', 0) + 1))
          || (exists(path) && get(path).data.status == 'IN_TRANSIT' && transfer.status == 'RECEIVED'
            && transfer.receivedByUid == request.auth.uid && oldItem.transferPendingId == transfer.id
            && newItem.get('transferPendingId', '') == '' && newItem.warehouseId == transfer.toWarehouseId
            && after.get('logisticsTransfersPending', 0) == before.get('logisticsTransfersPending', 0) - 1));
    }

    function logisticsItemProtected(oldItems, newItems, index) {
      return index >= oldItems.size() || (index < newItems.size()
        && newItems[index].get('warehouseId', '') == oldItems[index].get('warehouseId', '')
        && newItems[index].get('transferPendingId', '') == oldItems[index].get('transferPendingId', '')
        && newItems[index].get('custodyTransferId', '') == oldItems[index].get('custodyTransferId', '')
        && (!oldItems[index].get('warehouseId', '').matches('custody-.*') || newItems[index].get('deliveryPlan', {}) == oldItems[index].get('deliveryPlan', {})));
    }
    function custodyItemClear(items, index) {
      return index >= items.size() || items[index].get('reservedQty', 0) == 0
