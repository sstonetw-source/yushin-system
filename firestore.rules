    // A return request never edits stock, delivery, products, costs or ownership.
    // Keep the existing mutation validator, without evaluating unrelated writers.
    function commercialReturnRequestOnlyUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
