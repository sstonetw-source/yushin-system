rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return signedIn() ? userDoc().data.role : null; }
    function admin() { return role() == 'admin'; }
    function purchaser() { return role() == 'purchaser'; }
    function warehouse() { return role() == 'warehouse'; }
    function sales() { return role() == 'sales'; }
    function engineer() { return role() == 'engineer'; }
    function currentSalesCode() { return signedIn() ? userDoc().data.code : null; }
    function ownBySalesCode(resourceData) {
      return signedIn()
        && currentSalesCode() != null
        && currentSalesCode() != ''
        && resourceData.salesCode != null
        && resourceData.salesCode == currentSalesCode();
    }
    // salesCode 是正式資料歸屬；ownerUid 僅保留給尚未補 salesCode 的舊資料相容。
    function own(resourceData) {
      return signedIn() && (ownBySalesCode(resourceData) || resourceData.ownerUid == request.auth.uid);
    }

    match /users/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /settings/{id} { allow read: if signedIn(); allow write: if admin(); }

    // 全系統共用主檔：先建立安全邊界，後續模組逐步改為引用 stable ID。
    match /brands/{id} {
      allow read: if signedIn();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /salesCodes/{id} {
      allow read: if signedIn();
      allow create, update: if admin();
      allow delete: if false;
    }

    match /customers/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || sales();
      allow delete: if false;
    }

    match /products/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || purchaser() || warehouse();
      allow delete: if false;
    }

    match /quotes/{id} {
      allow read: if admin() || purchaser() || own(resource.data);
      allow create: if admin() || sales();
      allow update: if admin() || own(resource.data);
      allow delete: if false;
    }

    match /forecasts/{id} {
      allow read: if admin() || own(resource.data);
      allow create: if admin() || sales();
      allow update: if admin() || own(resource.data);
      allow delete: if false;
    }

    // Forecast 進度為 append-only 歷史，權限跟隨父 Forecast。
    match /forecasts/{forecastId}/progress/{progressId} {
      allow read: if admin() || own(get(/databases/$(database)/documents/forecasts/$(forecastId)).data);
      allow create: if admin()
        || (sales() && own(getAfter(/databases/$(database)/documents/forecasts/$(forecastId)).data));
      allow update, delete: if false;
    }

    match /orders/{id} {
      allow read: if admin() || purchaser() || warehouse() || engineer() || own(resource.data);
      allow create: if admin() || sales();
      allow update: if admin() || purchaser() || warehouse() || own(resource.data);
      allow delete: if false;
    }

    match /purchaseOrders/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || purchaser();
      allow delete: if false;
    }

    match /inventory/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || warehouse() || purchaser();
      allow delete: if false;
    }

    // 訂單成立後的庫存占用明細；以狀態更新取代刪除，保留可追溯性。
    match /inventoryReservations/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || sales() || purchaser() || warehouse();
      allow delete: if false;
    }

    // PO 已送出但尚未成為正式庫存主檔的新品項。
    match /pendingInventoryItems/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || purchaser() || warehouse();
      allow delete: if false;
    }

    match /inventoryMovements/{id} {
      allow read: if signedIn();
      allow create: if admin() || warehouse() || purchaser() || sales();
      allow update, delete: if false;
    }

    match /equipment/{id} {
      allow read: if signedIn();
      allow create, update: if admin() || engineer();
      allow delete: if false;
    }

    match /{document=**} {
      allow read: if signedIn();
      allow write: if admin();
    }
  }
}
